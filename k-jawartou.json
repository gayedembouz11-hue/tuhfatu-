{"id":"jawartou","ar":"جَاوَرْتُ","fr":"Jawartu","lines":[{"a":["أَعُوذُ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ فَارَقْتُ إِبْلِيسَ وَجَمِيعَ الْمَفَاسِدِ"],"p":["ʾaʿoûdhou billâhi mina chchayṭâni rradjîmi fâraqtou ʾiblîsa wadjamîʿa lmafâsidi"]},{"a":["وَلِبِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ لَازَمْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ تَعَالَى"],"p":["walibismi llâhi rrahmâni rrahîmi lâzamtou rasoûla llâhi çalla llâhou taʿâlâ"]},{"a":["عَلَيْهِ وَسَلَّمَ وَجَمِيعَ الْمَصَالِحِ وَلَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ الْعَلِيِّ"],"p":["ʿalayhi wasallama wadjamîʿa lmaçâlihi walâ hawla walâ qouwwata ʾillâ billâhi lʿaliyyi"]},{"a":["الْعَظِيمِ"],"p":["alʿaẓîmi"]},{"a":["جَاوَرْتُ اللَّهَ بِكِتَابِهِ إِلَى دُخُولِيَ جَنَّتَهُ"],"p":["djâwartou llâha bikitâbihi ʾilâ doukhoûliya djannatahou"]},{"a":["جَاوَرْتُ بِالْفُرْقَانِ رَبِّيَ الْمُعِينْ","مَلَكْتُ نَفْسِيَ وَزَحْزَحْتُ اللَّعِينْ"],"p":["djâwartou bilfourqâni rabbiya lmouʿîn","malaktou nafsiya wazahzahtou llaʿîn"]},{"a":["أَخَذْتُ مِنْ دُنْيَاهُ زَادِي لِلْجِنَانْ","وَانْقَادَ لِي الْهَوَى وَلِي صَفَا الْجَنَانْ"],"p":["ʾakhadhtou min dounyâhou zâdî lildjinân","wânqâda li lhawâ walî çafa ldjanân"]},{"a":["وَالَانِيَ الْأَبْرَارُ فِي أُخْرَايَا","وَانْقَادَ لِي بِلَا انْتِهَا قِرَايَا"],"p":["wâlâniya lʾabrârou fî ʾoukhrâyâ","wânqâda lî bilâ antihâ qirâyâ"]},{"a":["رَافَقَنِي إِلَى الْجِنَانِ","وَلِسِوَايَ زُحْزِحَ الرَّجِيمُ"],"p":["râfaqanî ʾila ldjinâni","walisiwâya zouhziha rradjîmou"]},{"a":["تُرْسِي عَنِ اللَّعِينِ وَالْفُجَّارِ","كَوْنُ بَدِيعِ الْعَالَمِينَ جَارِي"],"p":["toursî ʿani llaʿîni walfoudjdjâri","kawnou badîʿi lʿâlamîna djârî"]},{"a":["أَكْرَمَنِي الْبَدِيعُ بِالْكِتَابِ","وَصَانَنِي عَنْ جَالِبِ الْعِتَابِ"],"p":["ʾakramani lbadîʿou bilkitâbi","waçânanî ʿan djâlibi lʿitâbi"]},{"a":["لَمْ يَنْحُنِي زَجْرٌ وَلَا وَعِيدُ","وَعُمُرِي إِلَى الْجِنَانِ عِيدُ"],"p":["lam yanhounî zadjroun walâ waʿîdou","waʿoumourî ʾila ldjinâni ʿîdou"]},{"a":["أَخْفَى لِيَ السِّرَّ الْمَصُونَ اللَّهُ","حُبًّا وَلَا إِلَهَ إِلَّا اللَّهُ"],"p":["ʾakhfâ liya ssirra lmaçoûna llâhou","houbban walâ ʾilaha ʾilla llâhou"]},{"a":["هَدَانِيَ اللَّهُ وَإِنَّهُ الْبَدِيعْ","وَقَادَنِي لَهُ بِأَنْوَاعِ الْبَدِيعْ"],"p":["hadâniya llâhou waʾinnahou lbadîʿ","waqâdanî lahou biʾanwâʿi lbadîʿ"]},{"a":["بَرَّأَنِي الْخَالِقُ مِنْ سِوَاهُ","وَقَادَنِي مَنْ لَا يُرَى شَرْوَاهُ"],"p":["barraʾani lkhâliqou min siwâhou","waqâdanî man lâ yourâ charwâhou"]},{"a":["كِتَابُ رَبِّي كَانَ لِي وَكُنْتُ","لَهُ وَلِلَّهِ بِهِ سَكَنْتُ"],"p":["kitâbou rabbî kâna lî wakountou","lahou walillâhi bihi sakantou"]},{"a":["تُرْسِي عَنِ الْأَكْدَارِ وَالْمَفَاسِدِ","سَلَامَتِي مِنْ جَالِبٍ لِفَاسِدِ"],"p":["toursî ʿani lʾakdâri walmafâsidi","salâmatî min djâlibin lifâsidi"]},{"a":["أَكْرَمَنِي اللَّهُ بِذِكْرِهِ وَمَا","لِي اخْتَارَهُ وَلِيَ قَادَ الْأَقْوَمَا"],"p":["ʾakramani llâhou bidhikrihi wamâ","lî akhtârahou waliya qâda lʾaqwamâ"]},{"a":["بَاهَى بِيَ اللَّهُ الْكِرَامَ الْغُرَّا","وَبِبَقَائِيَ النَّبِيَّ سَرَّا"],"p":["bâhâ biya llâhou lkirâma lghourrâ","wabibaqâʾiya nnabiyya sarrâ"]},{"a":["هِبَاتُ ذِي الْجَلَالِ وَالْإِكْرَامِ","لِي خَلَّدَتْ مُرَغِّبَ الْكِرَامِ"],"p":["hibâtou dhi ldjalâli wal ikrâmi","lî khalladat mouraghghiba lkirâmi"]},{"a":["إِلَيَّ قَادَ اللَّهُ مَا لَمْ يَكُنِ","وَلَا يَكُونُ أَبَدًا لِمُمْكِنِ"],"p":["ʾilayya qâda llâhou mâ lam yakouni","walâ yakoûnou ʾabadan limoumkini"]},{"a":["لَسْتُ أَشُكُّ أَبَدًا فِي كَوْنِي","جَارَ الْبَدِيعِ عَجَبًا لِلْكَوْنِ"],"p":["lastou ʾachoukkou ʾabadan fî kawnî","djâra lbadîʿi ʿadjaban lilkawni"]},{"a":["إِنَّ الَّذِي مِنَ الْإِلَهِ حُزْتُ","غَابَ عَنِ الْكَوْنِ وَفِيهِ فُزْتُ"],"p":["ʾinna lladhî mina lʾilahi houztou","ghâba ʿani lkawni wafîhi fouztou"]},{"a":["دَلَّنِيَ اللَّهُ عَلَى اللَّهِ بِلَا","تَغَرُّرٍ وَعُمُرِي تَقَبَّلَا"],"p":["dallaniya llâhou ʿala llâhi bilâ","tagharrourin waʿoumourî taqabbalâ"]},{"a":["خَابَتْ قُلَاتِيَ مَعَ الْحُسَّادِ","مُذْ ثَمَنِي حُزْتُ بِلَا كَسَادِ"],"p":["khâbat qoulâtiya maʿa lhoussâdi","moudh thamanî houztou bilâ kasâdi"]},{"a":["وَقَانِيَ الْبَاقِي بِهِ ثُبُورَا","تِجَارَتِي لَدَيْهِ لَنْ تَبُورَا"],"p":["waqâniya lbâqî bihi thouboûrâ","tidjâratî ladayhi lan taboûrâ"]},{"a":["يَقُودُ لِي بِلَا انْتِهَاءٍ ثَمَنِي","مَنْ كَانَ لِي وَلِيَ صَفَّى زَمَنِي"],"p":["yaqoûdou lî bilâ antihâʾin thamanî","man kâna lî waliya çaffâ zamanî"]},{"a":["جَاوَرْتُ رَبِّي بِلِسَانِ الْعَرَبِ","بِلَا نِهَايَةٍ وَطَابَتْ قُرَبِي"],"p":["djâwartou rabbî bilisâni lʿarabi","bilâ nihâyatin waṭâbat qourabî"]},{"a":["نَزَعَ لِي الْإِسْلَامَ عِنْدَ غُرْبَتِي","لَدَى الْجَزَائِرِ مُنِيرُ تُرْبَتِي"],"p":["nazaʿa li lʾislâma ʿinda ghourbatî","lada ldjazâʾiri mounîrou tourbatî"]},{"a":["نُزِعَ لِي نُورُ اللِّسَانِ وَالْكِتَابْ","أَزْمَانَ خِدْمَتِي لَدَى أَهْلِ الْكِتَابْ"],"p":["nouziʿa lî noûrou llisâni walkitâb","ʾazmâna khidmatî ladâ ʾahli lkitâb"]},{"a":["تَذْيِيلُ مَا ثَبَتَ لِلْمُشَفَّعِ","أَغْنَى يَمِينِي عَنْ أَذًى وَمِدْفَعِ"],"p":["tadhyîlou mâ thabata lilmouchaffaʿi","ʾaghnâ yamînî ʿan ʾadhanâ wamidfaʿi"]},{"a":["هَدَانِيَ اللَّهُ وَزَحْزَحَ اللَّعِينْ","إِلَى سِوَى عُمْرِيَ حَبَّذَا الْمُعِينْ"],"p":["hadâniya llâhou wazahzaha llaʿîn","ʾilâ siwâ ʿoumriya habbadha lmouʿîn"]},{"a":["سُبْحَٰنَ رَبِّكَ رَبِّ الْعِزَّةِ عَمَّا يَصِفُونَ","وَسَلَٰمٌ عَلَى الْمُرْسَلِينَ"],"p":["soubhâna rabbika rabbi lʿizzati ʿammâ yaçifoûna","wasalâmoun ʿala lmoursalîna"]},{"a":["وَالْحَمْدُ لِلَّهِ رَبِّ الْعَٰلَمِينَ"],"p":["walhamdou lillâhi rabbi lʿâlamîna"]}]}