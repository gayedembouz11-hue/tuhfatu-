{
 "id": "albarakah",
 "ar": "الْبَرَكَةُ",
 "fr": "Al Barakah",
 "lines": [
  {
   "a": [
    "الْحَمْدُ لِلَّهِ عَلَى لُهَاءِى",
    "مُذْ ذَبَّ إِبْلِيسَ بِلَا انْتِهَآءِ"
   ],
   "p": [
    "Alhamdou lillâhi ʿalâ louhâʾî",
    "Moudh dhabba ʾiblîsa bilâ ntihâʾî"
   ]
  },
  {
   "a": [
    "لِلَّهِ ذِى الْأَرْضِينَ وَالسَّمَآءِ",
    "كُلِّى وَلِى قَدْ جَادَ بِالنَّمَآءِ"
   ],
   "p": [
    "Lillâhi dhil ʾarḍîna wassamâʾî",
    "Koullî wa lî qad djâda binnamâʾî"
   ]
  },
  {
   "a": [
    "بَارَكَ لِى فِى الْحَرَكَاتِ وَالسُّكُونْ",
    "رَبِّى الَّذِى قَدْ قَادَلِى كُنْ فَيَكُونْ"
   ],
   "p": [
    "Bâraka lî fil harakâti wassoukoûn",
    "Rabbî lladhî qad qâdalî koun fayakoûn"
   ]
  },
  {
   "a": [
    "رَبِحْتُ فِى الْبَيْعِ وَفِى الْمُجَاهَدَهْ",
    "وَعِنْدَ حِزْبِ اللَّهِ كُلُّ شَاهَدَهْ"
   ],
   "p": [
    "Rabihtou fil bayʿi wafil moudjâhadah",
    "Waʿinda hizbillâhi koullou châhadah"
   ]
  },
  {
   "a": [
    "كِتَابَتِى تَدُورُ تَحْتَ الْعَرْشِ",
    "بَيْنَ الْكِرَامِ عَابِدِى ذِى الْفَرْشِ"
   ],
   "p": [
    "Kitâbatî tadoûrou tahtal ʿarch",
    "Bayna l-kirâmi ʿâbidî dhil farch"
   ]
  },
  {
   "a": [
    "هَرَبَ إِبْلِيسُ بِلَا انْتِهَآءِ",
    "لِغَيْرِ ذَاتِى وَنَمَا لُهَآءِى"
   ],
   "p": [
    "Haraba ʾiblîsou bilâ ntihâʾî",
    "Lighayri dhâtî wa namâ louhâʾî"
   ]
  }
 ]
}