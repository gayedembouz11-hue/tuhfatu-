{"id":"antarabbii","ar":"أَنْتَ رَبِّي","fr":"Anta Rabbii","lines":[{"a":["أَنْتَ رَبِّي وَكُنْتَ لِي بِوِدَادِي","لَكَ شُكْرِي لِجَنَّةٍ بِمِدَادِ"],"p":["anta rabbî wakounta lî biwidâdî","laka choukrî lidjannatin bimidâd"]},{"a":["لَكَ شُكْرِي عَلَى جَمِيعِ حَلَالٍ","سُقْتَهُ لِي لِجَنَّةٍ ذَا سَدَادِ"],"p":["laka choukrî ʿalâ djamîʿi halâl","souqtahou lî lidjannatin dhâ sadâd"]},{"a":["لَكَ كُلِّي يَا ذَا الْبَقَا ذَا بَقَاءٍ","ءَايَةً مِنْكَ سَرْمَدًا يَا عِمَادِي"],"p":["laka koullî yâ dhâ lbaqâ dhâ baqâʾ","âyatan minka sarmadan yâ ʿimâdî"]},{"a":["هَبْ لِيَ الدَّهْرَ أَنْ أَدُومَ سُرُورًا","لِحَبِيبٍ بِهِۦ عَلَيْكَ اعْتِمَادِي"],"p":["hab liya ddahra an adoûma souroûrâ","lihabîbin bihî ʿalayka ʿtimâdî"]},{"a":["مِنْكَ أَبْغِي لَهُ سَلَامِي وَدُودٍ","ذِي بَقَاءٍ يَكُونُ لِي بِمُرَادِي"],"p":["minka abghî lahou salâmî wadoûd","dhî baqâʾin yakoûnou lî bimourâdî"]},{"a":["حُطْنِيَ الدَّهْرَ ذَا رِضًا وَأَمَانٍ","حُطْ عِيَالِي عَنِ الْوَبَآءِ وَالْجَرَادِ"],"p":["houṭniya ddahra dhâ ridan wa amân","houṭ ʿiyâlî ʿani lwabâʾi waldjarâd"]},{"a":["مُدَّ لِي مِنْكَ مَا أَشَا فِي دَوَامٍ","وَبِخَطِّي ارْفَعِ الْعُلَى بِانْفِرَادِ"],"p":["moudda lî minka mâ achâ fî dawâm","wabikhaṭṭî rfaʿi lʿoulâ binfirâd"]},{"a":["مِنْكَ أَبْغِي بِلَا انْتِهَاءٍ سَلَامِي","وَاسِعٍ لِلْمَلَا الْكِرَامِ الْعِبَادِ"],"p":["minka abghî bilâ ntihâʾin salâmî","wâsiʿin lilmalâ lkirâmi lʿibâd"]},{"a":["دَائِمُ اكْتُبْ لِيَ الرِّضَى بِعِيَالِي","وَلْتُبَشِّرْ خَيْرَ الْوَرَى بِمِدَادِي"],"p":["dâʾimou ktoub liya rriḍâ biʿiyâlî","waltoubachchir khayra lwarâ bimidâdî"]},{"a":["إِنَّ ذَا الْجُودِ وَالْعُلَى وَالْجَمَالِ","مَالِكَ الْمُلْكِ ذَا الْهُدَى وَالْكَمَالِ"],"p":["inna dhâ ldjoûdi walʿoulâ waldjamâl","mâlika lmoulki dhâ lhoudâ walkamâl"]},{"a":["لَائِقٌ بِالشُّكُورِ وَهْوَ شَكُورٌ","وَبِهِۦ رُمْتُ شُكْرَهُ بِالْحَلَالِ"],"p":["lâʾiqoun bichchoukoûri wahwa chakoûr","wabihî roumtou choukrahou bilhalâl"]},{"a":["لِي يَسُوقُ الْحَلَالَ دُونَ حِسَابٍ","وَبِخَطِّي يُزِيلُ كُلَّ ضَلَالِ"],"p":["lî yasoûqou lhalâla doûna hisâb","wabikhaṭṭî youzîlou koulla ḍalâl"]},{"a":["هَدَمَ الضُّرَّ عَنْ جَنَابِي دَوَامًا","وَبِخَيْرٍ يَجُودُ لِي ذَا جَمَالِ"],"p":["hadama ḍḍourra ʿan djanâbî dawâmâ","wabikhayrin yadjoûdou lî dhâ djamâl"]},{"a":["مَدَّ لِي فَضْلَهُ بِغَيْرِ انْتِهَاءٍ","بِالنَّبِيِّ الْكَرِيمِ دُونَ اخْتِلَالِ"],"p":["madda lî faḍlahou bighayri ntihâʾ","binnabiyyi lkarîmi doûna khtilâl"]},{"a":["حَمْدِيَ الدَّهْرَ لِلَّذِي سَاقَ فَضْلًا","بِالرَّسُولِ الْأَمِينِ لِي ذَا اتِّصَالِ"],"p":["hamdiya ddahra lilladhî sâqa faḍlâ","birrasoûli lamîni lî dhâ ttiçâl"]},{"a":["مَدَّ لِي مَالِكِي تَكَرُّمَ بَاقٍ","ذَا اقْتِرَابٍ مِنْهُ بِغَيْرِ انْفِصَالِ"],"p":["madda lî mâlikî takarroum bâq","dhâ qtirâbin minhou bighayri nfiçâl"]},{"a":["مَلَّكَتْنِي عَلَى النَّبِيِّ مُرَادِي","قُلْتُ هَاذَا شُكْرًا بِغَيْرِ اخْتِيَالِ"],"p":["mallakatnî ʿalâ nnabiyyi mourâdî","qoultou hâdhâ choukran bighayri khtiyâl"]},{"a":["دَائِمُ اكْتُبْ لَهُ سَلَامِي وَدُودٍ","عَنْ جَنَابِي وَعَنْ جَنَابِ عِيَالِي"],"p":["dâʾimou ktoub lahou salâmî wadoûd","ʿan djanâbî waʿan djanâbi ʿiyâlî"]},{"a":["أَذْهَبَ الضُّرَّ مَالِكِي عَنْ جَنَابِي","وَجَنَابِ الْعِيَالِ زَالَ الْعَنَآبِي"],"p":["adhhaba ḍḍourra mâlikî ʿan djanâbî","wadjanâbi lʿiyâli zâla lʿanâbî"]},{"a":["لِلَّذِي مُلْكُهُ يَدُومُ سُرُورِي","وَكَفَى كُلِّيَ الْأَذَى فِي اغْتِرَابِي"],"p":["lilladhî moulkouhou yadoûmou souroûrî","wakafâ koulliya lʾadhâ fî ghtirâbî"]},{"a":["لِلْإِلَهِ الْكَرِيمِ حَمْدِي وَشُكْرِ","ذَاصَلَاةٍ عَلَى نَبِيٍّ بِاقْتِرَابِي"],"p":["lililâhi lkarîmi hamdî wachoukr","dhâ çalâtin ʿalâ nabiyyin biqtirâbî"]},{"a":["هَدَمَ اللَّهُ بُنْيَةَ الضُّرِّ عَنِّي","وَبِخَيْرِ الْوَرَى أَزَالَ الْعَنَآبِي"],"p":["hadama llâhou bounyata ḍḍourri ʿannî","wabikhayri lwarâ azâla lʿanâbî"]},{"a":["مَنَّ بِالْعِلْمِ وَالْمُنَى مَعْ بَقَآءٍ","بِالَّذِي لَيْسَ يَنْتَمِي لِانْسِلَابِ"],"p":["manna bilʿilmi walmounâ maʿa baqâʾ","biladhî laysa yantamî linsilâb"]},{"a":["حُزْتُ مِنْ مَالِكِي بِخَيْرِ الْبَرَايَا","خَيْرَ نَصْرٍ عَلَى الْعِدَى بِانْقِلَابِ"],"p":["houztou min mâlikî bikhayri lbarâyâ","khayra naçrin ʿalâ lʿidâ binqilâb"]},{"a":["مَدْحُ رَبِّي وَمَدْحُ خَيْرِ مُصَلٍّ","قَادَ لِي جُمْلَةَ الْمُنَى بِانْحِلَابِ"],"p":["madhou rabbî wamadhou khayri mouçallin","qâda lî djoumlata lmounâ binhilâb"]},{"a":["مُدَّ خَيْرَ الصَّلَاةِ دُونَ انْتِهَآءٍ","مَعْ سَلَامٍ يَانَجِيًّا قَدْ خَلَابِي"],"p":["moudda khayra ççalâti doûna ntihâʾ","maʿa salâmin yâ najiyyan qad khalâbî"]},{"a":["دَائِمًا لِلَّذِي كَتَبْتُ بِهِۦ لِي","خَيْرَ إِبْقًا لَّا يَنْتَمِي لِانْسِلَابِ"],"p":["dâʾiman lilladhî katabtou bihî lî","khayra ibqâ lâ yantamî linsilâb"]}]}