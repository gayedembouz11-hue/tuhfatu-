{"id":"ajaabaniirabbussamaa","ar":"أَجَابَنِي رَبُّ السَّمَآ","fr":"Ajaabanii Rabbus Samaa","lines":[{"a":["أَجَابَنِي رَبُّ السَّمَآ","وَالْأَرْضِ بِالَّذِى سَمَا"],"p":["adjâbanî rabbou ssamâ","wal-arḍi billadhî samâ"]},{"a":["وَمِنْهُ قَادَ لِي السُّمَى","وَنِعْمَ مَالِي قَسَمَا"],"p":["wa minhou qâda lî ssoumâ","wa niʿma mâlî qasamâ"]},{"a":["سَلَّمَنِي مِنَ الْعِدَى","لَمْ يَنْحُ نَحْوِى مَنْ عَدَا"],"p":["sallamanî mina lʿidâ","lam yanhou nahwî man ʿadâ"]},{"a":["وَرَاضَ لِي مَنِ اعْتَدَى","وَكَانَ لِي وَعَظَّمَا"],"p":["wa râḍa lî mani ʿtadâ","wa kâna lî wa ʿaẓẓamâ"]},{"a":["مَدَّ لِيَ الْبَاقِي الْكَرِيمْ","جُمْلَةَ مَا كُنْتُ أَرُومْ"],"p":["madda liya lbâqî lkarîm","djoumlata mâ kountou aroûm"]},{"a":["مِنْهُ وَشُكْرَهُ أَرُومْ","وَدَعَّ مَنْ تَعَظَّمَا"],"p":["minhou wa choukrahou aroûm","wa daʿʿa man taʿaẓẓamâ"]},{"a":["أَكْرَمَنِي الْبَاقِي الْقَادِيمْ","بِأَنَّنِي الْعَبْدُ الْخَدِيمْ"],"p":["akramanî lbâqî lqâdîm","bi-annanî lʿabdou lkhadîm"]},{"a":["وَجَادَ لِي بِمَا يَدُومْ","بِحَبْلِهِۦ مُعْتَصِمًا"],"p":["wa djâda lî bimâ yadoûm","bi-hablihî mouʿtaçimâ"]},{"a":["لَهُ خِطَابِى شَاكِرَا","وَطَيَّبَ الْمَشَاكِرَا"],"p":["lahou khitâbî châkirâ","wa ṭayyaba lmachâkirâ"]},{"a":["عَبْدًا شَكُورًا ذَاكِرَا","وَبِبَقَآءِى عَصَمَا"],"p":["ʿabdan chakoûran dhâkirâ","wa bibaqâʾî ʿaçamâ"]},{"a":["لِي قَادَ فَضْلَهُ الْعَظِيمْ","وَقَادَ لِي الدُّرَّ النَّظِيمْ"],"p":["lî qâda faḍlahou lʿaẓîm","wa qâda lî ddourra nnaẓîm"]},{"a":["وَلِيَ كَانَ بِعَظِيمْ","وَلِيَ قَادَ نِعَمَا"],"p":["wa liya kâna biʿaẓîm","wa liya qâda niʿamâ"]},{"a":["أَجَابَنِي بِالْأَعْظَمِ","فِي النَّثْرِ وَالْمُنْتَظَمِ"],"p":["adjâbanî bil-aʿẓami","fî nnathri wal-mountaẓami"]},{"a":["وَدَعَّ ذَا تَعَظُّمِ","وَلَا يَزَالُ مُنْعِمَا"],"p":["wa daʿʿa dhâ taʿaẓẓoumi","wa lâ yazâlou mounʿimâ"]},{"a":["هُوَ الْإِلَهُ وَالصَّمَدْ","مُعْلِى السَّمَآ بِلَا عَمَدْ"],"p":["houwa l-ilâhou waççamad","mouʿlî ssamâ bilâ ʿamad"]},{"a":["وَقَدْ كَفَانِيَ الْكَمَدْ","وَكَانَ لِي وَكَرَّمَا"],"p":["wa qad kafâniya lkamad","wa kâna lî wa karramâ"]},{"a":["أَذْهَبَ مَالَمْ يَرْضَ لِي","بِخِدْمَةِ الْمُفَضَّلِ"],"p":["adhhaba mâ lam yarḍa lî","bikhidmati lmoufaḍḍal"]},{"a":["وَكَانَ لِي بِالْأَفْضَلِ","وَقَادَ لِي التَّكَرُّمَا"],"p":["wa kâna lî bil-afḍal","wa qâda lî ttakarroumâ"]},{"a":["لَقَّنَنِي الذِّكْرَ الْحَكِيمْ","إِلَيْهِ بِى قَادَ الْحَكِيمْ"],"p":["laqqananî ddhikra lhakîm","ilayhi bî qâda lhakîm"]},{"a":["يَسَّرَ لِي نِعْمَ الْحَكِيمْ","عَلَّمَنِي وَفَهَّمَا"],"p":["yassara lî niʿma lhakîm","ʿallamanî wa fahhamâ"]},{"a":["أَلَانَ لِي رَبِّى الْقُلُوبْ","لِي جَادَ فَضْلًا بِحَلِيبْ"],"p":["alâna lî rabbî lqouloûb","lî djâda faḍlan bihalîb"]},{"a":["قَادَ لَهُ بِيَ الْقُلُوبْ","وَصَانَ لِي مَآ أَبْهَمَا"],"p":["qâda lahou biya lqouloûb","wa çâna lî mâ abhamâ"]},{"a":["عُلُومُهُ قَلْبِى هَدَتْ","وَصَّلَ لِي مُنًى بَدَتْ"],"p":["ʿouloûmouhou qalbî hadat","waççala lî mounan badat"]},{"a":["هَدِيَّةً عِنْدِى غَدَتْ","تَقُودُ مَنْ لَّمْ يَعْلَمَا"],"p":["hadiyyatan ʿindî ghadat","taqoûdou mal-lam yaʿlamâ"]},{"a":["ظُلْمِي امَّحَى بِلَا ثُبُوتْ","جُزْتُ بَلَآءَ الْعَنْكَبُوتْ"],"p":["ẓoulmî mmahâ bilâ thouboût","djouztou balâʾa lʿankaboût"]},{"a":["يَقِيلُ عُمْرِى وَيَبِيتْ","إِلَى الْجِنَانِ سُلَّمَا"],"p":["yaqîlou ʿoumrî wa yabît","ilâ ldjinâni soullamâ"]},{"a":["مَلَّكَنِي نُورَ اللِّسَانْ","بَاقٍ يَقُودُ لِي الْحِسَانْ"],"p":["mallakanî noûra llisân","bâqin yaqoûdou lî lhisân"]},{"a":["وَلِيَ سَدَّدَ اللِّسَانْ","وَلِيَ قَادَ الْمُحْكَمَا"],"p":["wa liya saddada llisân","wa liya qâda lmouhkamâ"]},{"a":["عَلَّمَنِي اللَّهُ الْخَبِيرْ","وَقَادَ لِي الْأَجْرَ الْكَبِيرْ"],"p":["ʿallamanî llâhou lkhabîr","wa qâda lî l-adjra lkabîr"]},{"a":["وَدَعَّ قِتْلِى لِلْغُبُورْ","وَصَانَنِي وَحَكَّمَا"],"p":["wa daʿʿa qitlî lilghouboûr","wa çânanî wa hakkamâ"]},{"a":["نَبَذْتُ مَاعَنِّى بَاعْ","مَنْ لِيَ قَادَ طُولَ بَاعْ"],"p":["nabadhtou mâ ʿannî bâʿ","man liya qâda ṭoûla bâʿ"]},{"a":["وَلِيَ نَوَّرَ الطِّبَاعْ","وَلَا يُرِينِى أَلَمَا"],"p":["wa liya nawwara ṭṭibâʿ","wa lâ yourînî alamâ"]},{"a":["دَعَانِيَ الْبَاقِي إِلَى","جَنَّتِهِۦ ذَاتِ الْإِلَى"],"p":["daʿâniya lbâqî ilâ","djannatihî dhâti l-ilâ"]},{"a":["وَمِنْهُ قَادَ لِي إِلَى","وَكَلْكَلِي قَدْ عَلَّمَا"],"p":["wa minhou qâda lî ilâ","wa kalkalî qad ʿallamâ"]},{"a":["رَدَّنِيَ اللَّهُ الشَّكُورْ","إِلَى مَعَادِى بِشُكُورْ"],"p":["raddaniya llâhou ccakoûr","ilâ maʿâdî bichoukoûr"]},{"a":["بِخِدْمَةِ الْعَبْدِ الشَّكُورْ","وَلِي أَطَابَ الشِّيَمَا"],"p":["bikhidmati lʿabdi ccakoûr","wa lî aṭâba cchiyamâ"]},{"a":["بَرَّأَنِي مِنَ التُّهَمْ","وَجَادَ لِي بِمَا انْبَهَمْ"],"p":["barraʾanî mina ttouham","wa djâda lî bimâ nbaham"]},{"a":["وَصَانَنِي عَنِ الْوَهَمْ","وَلِي حَيَاتِي عَصَمَا"],"p":["wa çânanî ʿani lwaham","wa lî hayâtî ʿaçamâ"]},{"a":["بَرَكَةُ الْمَاحِي الْوَلِي","نُورِ رَبِيعِ الْأَوَّلِ"],"p":["barakatou lmâhî lwalî","noûri rabîʿi l-awwal"]},{"a":["نَفَتْ ذَوِى التَّقَوُّلِ","وَمَنْ أَبَاهُ انْفَصَمَا"],"p":["nafat dhawî ttaqawwoul","wa man abâhou nfaçamâ"]},{"a":["يَقُودُ لِي شَهْرُ الصِّيَامْ","مُخْجِلَ سَعْيِ وَقِيَامْ"],"p":["yaqoûdou lî chahrou ççiyâm","moukhdjila saʿyî wa qiyâm"]},{"a":["وَفَوْقَ أَجْرِ ذِى قِيَامْ","عِنْدَ قَدِيمٍ قَدَّمَا"],"p":["wa fawqa adjri dhî qiyâm","ʿinda qadîmin qaddamâ"]},{"a":["وَاجَهَنِي يُمْنُ رَبِيعْ","مُزَحْزِحًا عَنِّى الْمَبِيعْ"],"p":["wâdjahanî youmnou rabîʿ","mouzahzihan ʿannî lmabîʿ"]},{"a":["عَنْ شَهْرِ بَاقٍ ذِى رُبُوعْ","لَمْ يَنْحُنِي مَا صَدَمَا"],"p":["ʿan chahri bâqin dhî rouboûʿ","lam yanhounî mâ çadamâ"]},{"a":["هَدَمَ رَبِّى بِنَا","ضُرِّى وَنِعْمَ رَبُّنَا"],"p":["hadama rabbî binâ","ḍourrî wa niʿma rabbounâ"]},{"a":["وَقَادَلِي مَالِي بَنَى","وَزَحْزَحَ الْعَرَمْرَمَا"],"p":["wa qâdalî mâlî banâ","wa zahzaha lʿaramramâ"]},{"a":["وَلَّى لِغَيْرِي كُلُّ مَنْ","أَبْدَى قِلَاىَ فِي الزَّمَنْ"],"p":["wallâ lighayrî koullou man","abdâ qilâya fî zzaman"]},{"a":["وَاللَّهُ لِي قَادَ الْأَمَنْ","وَكَدُّ عُمْرِى انْصَرَمَا"],"p":["wa llâhou lî qâda l-aman","wa kaddou ʿoumrî nçaramâ"]},{"a":["وَاجَهَنِي الْبَاقِي الْجَمِيلْ","بِمَا لِغَيْرِي لَا يَمِيلْ"],"p":["wâdjahanî lbâqî ldjamîl","bimâ lighayrî lâ yamîl"]},{"a":["وَلِسِوَى عُمْرِي الْخُمُولْ","وَمَنْ قَلَانِي حُرِمَا"],"p":["wa lisiwâ ʿoumrî lkhoumoûl","wa man qalânî hourimâ"]},{"a":["أَذْهَبَ رَبِّى الْمَبِيعْ","فِي رَمَضَانَ وَرَبِيعْ"],"p":["adhhaba rabbî lmabîʿ","fî ramaḍâna wa rabîʿ"]},{"a":["تَطِيبُ لِي كُلُّ سُبُوعْ","وَحَاسِدِى لَمْ يُكْرَمَا"],"p":["taṭîbou lî koullou souboûʿ","wa hâsidî lam youkramâ"]},{"a":["لَمْ يَنْحُنِي مُقَاتِلُ","وَاللَّهُ عَنِّى قَاتِلُ"],"p":["lam yanhounî mouqâtil","wa llâhou ʿannî qâtil"]},{"a":["وَلِمَبِيعِى بَاتِلُ","مَنْ رَامَ ضُرِّى اخْتُرِمَا"],"p":["wa limabîʿî bâtil","man râma ḍourrî khtourimâ"]},{"a":["لَمْ يَنْحُنِي مُكَابِدُ","وَالْعُمْرُ رَبِّى عَابِدُ"],"p":["lam yanhounî moukâbid","wal-ʿoumrou rabbî ʿâbid"]},{"a":["إِبْلِيسُ لَا يُكَابِدُ","مَنْ لِلْجِنَانِ احْتُرِمَا"],"p":["iblîsou lâ youkâbid","man lildjinâni htourimâ"]},{"a":["أَكْرَمَنِي رَبُّ السَمَآ","وَالْأَرْضِ إِكْرَمًا سَمَا"],"p":["akramanî rabbou ssamâ","wal-arḍi ikramâ samâ"]},{"a":["وَانْقَادَ لِي مَا قَسَمَا","لِي وَضُرِّى صُرِمَا"],"p":["wa nqâda lî mâ qasamâ","lî wa ḍourrî çourimâ"]},{"a":["هِبَاتُ رَبِّى ذِى الْكَمَالْ","تَقُودُ كُلِّى بِجَمَالْ"],"p":["hibâtou rabbî dhî lkamâl","taqoûdou koullî bidjamâl"]},{"a":["وَقَادَلِي أَبْرَ كَمَالْ","مَنْ بِى يُرَقِّى الْعُلَمَا"],"p":["wa qâdalî abra kamâl","man bî youraqqî lʿoulamâ"]},{"a":["تِرْسُ فُؤَادِى عَنْ غُفُولْ","عِصْمَةُ نُورِى مِنْ أُفُولْ"],"p":["tirsou fouʾâdî ʿan ghoufoûl","ʿiçmatou noûrî min oufoûl"]},{"a":["وَكَانَ لِي الْمَاحِي الْكَفِيلْ","وَلِيَ قَادَ عِصَمَا"],"p":["wa kâna lî lmâhî lkafîl","wa liya qâda ʿiçamâ"]},{"a":["عَبَدْتُّ رَبِّى الْكَرِيمْ","عِبَادَةً لَّيْسَتْ تَرِيمْ"],"p":["ʿabadtou rabbî lkarîm","ʿibâdatan laysat tarîm"]},{"a":["وَلِيَ مَا كُنْتُ أَرُومْ","قَادَ وَعُمْرِى عَصَمَا"],"p":["wa liya mâ kountou aroûm","qâda wa ʿoumrî ʿaçamâ"]},{"a":["أَعْبُدُ رَبِّى فِي دُيُورْ","وَلِيَ كَانَ بِخُيُورْ"],"p":["aʿboudou rabbî fî douyoûr","wa liya kâna bikhouyoûr"]},{"a":["إِلَى الْجِنَانِ ذِى الدُّيُورْ","وَكَانَ لِي وَقَدَّمَا"],"p":["ilâ ldjinâni dhî ddouyoûr","wa kâna lî wa qaddamâ"]},{"a":["لَمْ يَنْحُ قَلْبِى ضَلَالْ","وَلِيَ كَانَ بِزُلَالْ"],"p":["lam yanhou qalbî ḍalâl","wa liya kâna bizoulâl"]},{"a":["وَلَيْسَ يَنْحُونِى اعْتِلَالْ","وَلَا أُلَا فِى نَدَمَا"],"p":["wa laysa yanhoûnî ʿtilâl","wa lâ oulâ fî nadamâ"]},{"a":["أَكْرَمَ ذَاتِى لِلْجِنَانْ","مَنْ لِيَ طَيَّبَ الْجِنَانْ"],"p":["akrama dhâtî lildjinân","man liya ṭayyaba ldjinân"]},{"a":["وَقَادَلِى بِالْإِمْتِنَانْ","بُشَارَةً لِّلْقُدَمَآ"],"p":["wa qâdalî bil-imtinân","bouchâratan lilqoudamâ"]},{"a":["حَمَانِى الْبَاقِي الْحَفِيظْ","لِي نَارَ مَعْنًى وَلَفِيظْ"],"p":["hamânî lbâqî lhafîẓ","lî nâra maʿnan wa lafîẓ"]},{"a":["عُمْرِىَ ذِكْرُهُ حَفِيظْ","عُصِمْتُ مِمَّنْ ظَلَمَا"],"p":["ʿoumriya dhikrouhou hafîẓ","ʿouçimtou mimman ẓalamâ"]},{"a":["قَادَلِيَ اللَّهُ الْعَلِيمْ","فَوْقَ الْمُرَادِ مِنْ عُلُومْ"],"p":["qâdaliya llâhou lʿalîm","fawqa lmourâdi min ʿouloûm"]},{"a":["وَلَّى لِغَيْرِىَ الظَّلُومْ","وَقَبْلَ ذَاكَ اسْتَسْلَمَا"],"p":["wallâ lighayriya ẓẓaloûm","wa qabla dhâka staslamâ"]},{"a":["قُدْتُّ مِدَادِى وَالْقِلَامْ","لِمَنْ حَمَانِى عَنْ مَّلَامْ"],"p":["qoudtou midâdî wal-qilâm","liman hamânî ʿam malâm"]},{"a":["وَلِيَ أَفْضَلُ الْكَلَامْ","زَحْزَحَ عَنِّىَ الظُّلَمَا"],"p":["wa liya afḍalou lkalâm","zahzaha ʿanniya ẓẓoulamâ"]},{"a":["أَحْمَدُ فَاطِرَ السَّمَآ","وَالْأَرْضِ حَمْدًا قَدْ سَمَا"],"p":["ahmadou fâṭira ssamâ","wal-arḍi hamdan qad samâ"]},{"a":["وَلِيَ مَالِى قَسَمَا","قَادَ وَأَعْطَانِي السُّمَى"],"p":["wa liya mâlî qasamâ","qâda wa aʿṭânî ssoumâ"]}]}