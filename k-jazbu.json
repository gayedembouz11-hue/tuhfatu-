":["صَلِّ وَسَلِّمَنْ عَلَى","مَنْ قَدْ أَجَابَ بِبَلَى","يَوْمَ أَلَسْتُ أَوَّلَا","قَبْلَ ذَوِي التَّكَلُّمِ"],"p":["çalli wasalliman ʿalâ","man qad ʾadjâba bibalâ","yawma ʾalastou ʾawwalâ","qabla dhawî attakalloumi"]},{"a":["صَلِّ عَلَى خَيْرِ رَسُولْ","يَا مَنْ بِهِ يَحْبُو بِسُولْ","فِي الْآلِ وَالصَّحْبِ الْعُدُولْ","وَلْتَتَقَبَّلْ قَلَمِي"],"p":["çalli ʿalâ khayri rasoûl","yâ man bihi yahboû bisoûl","fî al âli waççahbi alʿoudoûl","waltataqabbal qalamî"]},{"a":["هَبْ لِيَ كَوْنَ قَلَمِي","بُشَارَةَ الْمُقَدَّمِ","وَاكْتُبْ بِهِ تَقَدُّمِي","بِلَا أَذًى أَوْ أَلَمِ"],"p":["hab liya kawna qalamî","bouchârata almouqaddami","wâktoub bihi taqaddoumî","bilâ ʾadhanâ ʾaw ʾalami"]},{"a":["صَلِّ عَلَى خَيْرِ نَبِي","قَادَ الْوَرَى بِالْأَدَبِ","يَا مَنْ كَفَانِي وَدَبِي","بِجَاهِهِ وَسَلِّمِ"],"p":["çalli ʿalâ khayri nabî","qâda alwarâ bilʾadabi","yâ man kafânî wadabî","bidjâhihi wasallimi"]},{"a":["هُوَ الَّذِي فَاقَ سِوَاهْ","مِنَ الْبَرَايَا بِهُدَاهْ","حَتَّى بَدَا كَتْبُ سُمَاهْ","فِي عَرْشِكَ الْمُعَظَّمِ"],"p":["houwa aldhî fâqa siwâh","mina albarâyâ bihoudâh","hattâ badâ katbou soumâh","fî ʿarchika almouʿaẓẓami"]},{"a":["وَفِي الْجِنَانِ وَالسُّقُوفْ","وَفِي الْوُجُوهِ وَالْكُهُوفْ","وَبِالرِّمَاحِ وَالسُّيُوفْ","قَلَعَ كُلَّ صَنَمِ"],"p":["wafî aldjinâni wassouqoûf","wafî alwoudjoûhi walkouhoûf","wabilrrimâhi wassouyoûf","qalaʿa koulla çanami"]},{"a":["قَادَ الْهُدَاةَ لِلنَّعِيمْ","بِخَيْرِ ذِكْرِهِ الْحَكِيمْ","بِرَبِّهِ الْبَاقِي الْقَدِيمْ","سُبْحَانَ مَنْ لَمْ يَنَمِ"],"p":["qâda alhoudâta lilnnaʿîm","bikhayri dhikrihi alhakîm","birabbihi albâqî alqadîm","soubhâna man lam yanami"]},{"a":["صَلِّ وَسَلِّمْ سَرْمَدَا","عَلَى الَّذِي قَدْ طُرِدَا","بِلَيْلَةٍ قَدْ وُلِدَا","فِيهَا مُدِيمُو الْمَأْثَمِ"],"p":["çalli wasallim sarmadâ","ʿalâ aldhî qad ṭouridâ","bilaylatin qad woulidâ","fîhâ moudîmoû almaʾthami"]},{"a":["لَيْلَةُ مَوْلِدِ النَّبِي","لَيْلَةُ مَحْوِ الرِّيَبِ","لَيْلَةُ مَحْوِ التَّعَبِ","وَطُهْرِ ذِي التَّأَثُّمِ"],"p":["laylatou mawlidi annabî","laylatou mahwi arriyabi","laylatou mahwi attaʿabi","waṭouhri dhî attaʾaththoumi"]},{"a":["بِهَا النَّجَاةُ وَالْفَلَاحْ","مَعَ السُّرُورِ وَالنَّجَاحْ","بِهَا الرَّبَاحُ وَالصَّلَاحْ","مَعَ انْدِفَاعِ النِّقَمِ"],"p":["bihâ annadjâtou walfalâh","maʿa assouroûri wannadjâh","bihâ arrabâhou waççalâh","maʿa ndifâʿi anniqami"]},{"a":["حَوَتْ خَوَارِقَ بَدَتْ","عَنِ الرُّوَاةِ ثَبَتَتْ","كَمِثْلِ نَارٍ أُطْفِأَتْ","مَعَ امِّحَاءِ دَقَمِ"],"p":["hawat khawâriqa badat","ʿani arrouwâti thabatat","kamithli nârin ʾouṭfiʾat","maʿa mmihâʾi daqami"]},{"a":["وَعَيْنِ سَاوَةَ الَّتِي","قَدْ عَظُمَتْ وَجَلَّتِ","لِلْفُرْسِ قَبْلَ الْمِلَّةِ","وَصُيِّرَتْ كَالْعَدَمِ"],"p":["waʿayni sâwata altî","qad ʿaẓoumat wadjallati","lilfoursi qabla almillati","waçouyyirat kalʿadami"]},{"a":["وَكَانْقِضَاضِ الشُّهُبِ","طَرْدًا لِأَهْلِ الرِّيَبِ","عَنْ سَمْعِ أَخْبَارِ النَّبِي","وَرَجَعُوا بِنَدَمِ"],"p":["wakânqiḍâḍi achchouhoubi","ṭardan liʾahli arriyabi","ʿan samʿi ʾakhbâri annabî","waradjaʿoû binadami"]},{"a":["طُرِدَ فِيهَا بِالنُّجُومْ","عَنِ السَّمَاوَاتِ الرَّجِيمْ","وَفَرَّ خَاسِرًا يُلِيمْ","بِحِزْبِهِ ذَا وَكَمِ"],"p":["ṭourida fîhâ binnoudjoûm","ʿani assamâwâti arradjîm","wafarra khâsiran youlîm","bihizbihi dhâ wakami"]},{"a":["سَطَعَ حِينَ وُلِدَا","خَيْرُ نَبِيٍّ قَدْ بَدَا","صَلَّى عَلَيْهِ مَنْ هَدَى","فُؤَادَهُ بِالْحِكَمِ"],"p":["saṭaʿa hîna woulidâ","khayrou nabiyyin qad badâ","çallâ ʿalayhi man hadâ","fouʾâdahou bilhikami"]},{"a":["نُورٌ عَظِيمٌ قَدْ يَرَى","بِهِ قُصُورَ قَيْصَرَا","مَنْ كَانَ فِي أُمِّ الْقُرَى","مَكَّةَ خَيْرِ الْحُرُمِ"],"p":["noûroun ʿaẓîmoun qad yarâ","bihi qouçoûra qayçarâ","man kâna fî ʾoummi alqourâ","makkata khayri alhouroumi"]},{"a":["إِيوَانُ كِسْرَى انْصَدَعَا","فِيهَا وَقَبْلُ رُفِعَا","سَمْكٌ لَهُ فَارْتَفَعَا","نَحْوَ سَمَا الْمُكَرِّمِ"],"p":["ʾîwânou kisrâ nçadaʿâ","fîhâ waqablou roufiʿâ","samkoun lahou fârtafaʿâ","nahwa samâ almoukarrimi"]},{"a":["حَتَّى السَّرِيرُ انْكَسَرَا","لِأَجْلِ هَوْلٍ اعْتَرَى","مِنْ نُورِ أَفْضَلِ الْوَرَى","رَبِّ عَلَيْهِ سَلِّمِ"],"p":["hattâ assarîrou nkasarâ","liʾadjli hawlin ʿtarâ","min noûri ʾafḍali alwarâ","rabbi ʿalayhi sallimi"]},{"a":["بَعْدَ صَلَاةٍ لَا تَزُولْ","بِالْآلِ وَالصَّحْبِ الْعُدُولْ","وَبِيَ جَدِّدِ السَّبِيلْ","بِلَا عِدًى أَوْ أَلَمِ"],"p":["baʿda çalâtin lâ tazoûl","bilʾâli waççahbi alʿoudoûl","wabiya djaddidi assabîl","bilâ ʿidanâ ʾaw ʾalami"]},{"a":["صَلِّ وَسَلِّمَنْ عَلَى","مَنْ حَازَ مَوْلِدًا جَلَا","لِغَيْرِنَا ذَوِي الْقِلَى","وَلْتَتَقَبَّلْ خِدَمِي"],"p":["çalli wasalliman ʿalâ","man hâza mawlidan djalâ","lighayrinâ dhawî alqilâ","waltataqabbal khidamî"]},{"a":["مَوْلِدُهُ مُعَظَّمُ","مُبَارَكٌ مُحْتَرَمُ","تَعْظِيمُهُ يَنْحَتِمُ","عَلَى ذَوِي التَّقَدُّمِ"],"p":["mawlidouhou mouʿaẓẓamou","moubârakoun mouhtaramou","taʿẓîmouhou yanhatimou","ʿalâ dhawî attaqaddoumi"]},{"a":["تَعْظِيمُهُ بِالسُّنَّةِ","يَقُودُنَا لِلْجَنَّةِ","بِهِ ازْدِيَادُ الْمِنَّةِ","لِمُخْلِصٍ مُعَظِّمِ"],"p":["taʿẓîmouhou bissounnati","yaqoûdounâ lildjannati","bihi zdiyâdou alminnati","limoukhliçin mouʿaẓẓimi"]},{"a":["فَمَنْ يُعَظِّمْ مَوْلِدَا","نَبِيِّنَا بَابِ الْهُدَى","فَلَا يُحَاسَبُ غَدَا","فَاحْتَرِمَنْ وَعَظِّمِ"],"p":["faman youʿaẓẓim mawlidâ","nabiyyinâ bâbi alhoudâ","falâ youhâsabou ghadâ","fâhtariman waʿaẓẓimi"]},{"a":["فَمَنْ يُعَظِّمْ مَوْلِدَا","خَيْرِ الْبَرَايَا أَحْمَدَا","فَكَشَهِيدٍ شَهِدَا","بَدْرًا بِغَيْرِ وَهَمِ"],"p":["faman youʿaẓẓim mawlidâ","khayri albarâyâ ʾahmadâ","fakachahîdin chahidâ","badran bighayri wahami"]},{"a":["فَكُلُّ مَنْ أَنْفَقَ فِي","مَوْلِدِهِ الْمُشَرَّفِ","مَالًا بِغَيْرِ سَرَفِ","وَلَوْ بِقَدْرِ دِرْهَمِ"],"p":["fakoullou man ʾanfaqa fî","mawlidihi almoucharrafi","mâlan bighayri sarafi","walaw biqadri dirhami"]},{"a":["فَإِنَّهُ كَمَنْ حَضَرْ","يَوْمَ حُنَيْنٍ وَصَبَرْ","وَيَوْمَ بَدْرٍ وَنَصَرْ","خَيْرَ الْوَرَى مُفَهِّمِي"],"p":["faʾinnahou kaman haḍar","yawma hounaynin waçabar","wayawma badrin wanaçar","khayra alwarâ moufahhimî"]},{"a":["فَمَنْ يُعَظِّمْ مَوْلِدَا","نَبِيِّنَا بَابِ الْهُدَى","فَلَا يُحَاسَبُ غَدَا","عِنْدَ الْحِسَابِ الْمُفْحِمِ"],"p":["faman youʿaẓẓim mawlidâ","nabiyyinâ bâbi alhoudâ","falâ youhâsabou ghadâ","ʿinda alhisâbi almoufhimi"]},{"a":["فَكُلُّ مَنْ قَدْ حَضَرَا","مَوْلِدَ أَفْضَلِ الْوَرَى","مُعَظِّمًا مُبَشِّرَا","بِسُكَّرٍ أَوْ لَحَمِ"],"p":["fakoullou man qad haḍarâ","mawlida ʾafḍali alwarâ","mouʿaẓẓiman moubachchirâ","bisoukkarin ʾaw lahami"]},{"a":["فَإِنَّهُ قَدْ ظَفِرَا","بِمَا يُدِيمُ الْبُشَرَا","وَلَا يُلَاقِي ضَرَرَا","يَوْمَ اجْتِمَاعِ الْأُمَمِ"],"p":["faʾinnahou qad ẓafirâ","bimâ youdîmou alboucharâ","walâ youlâqî ḍararâ","yawma djtimâʿi al oumami"]},{"a":["فَمَنْ طَعَامًا هَيَّآ","لِمَنْ لَهُ قَدْ قَرَآ","مُبَجِّلًا فَخَبَآ","خَيْرَاتِ أَهْلِ الْهِمَمِ"],"p":["faman ṭaʿâman hayyaʾâ","liman lahou qad qaraʾâ","moubadjdjilan fakhabaʾâ","khayrâti ʾahli alhimami"]},{"a":["وَمَنْ عَلَى شَيْءٍ قَرَا","مَوْلِدَ سَيِّدِ الْوَرَى","تَبَرُّكًا فَسَيَرَى","نُمُوَّهُ بِالْفَدْغَمِ"],"p":["waman ʿalâ chayʾin qarâ","mawlida sayyidi alwarâ","tabarroukan fasayarâ","noumouwwahou bilfadghami"]},{"a":["وَإِنْ عَلَى مَاءٍ قُرِي","مَوْلِدُ خَيْرِ الْبَشَرِ","فَالشُّرْبُ بِالْمُطَهَّرِ","يَكُفُّ كَيْدَ الْمُرْغَمِ"],"p":["waʾin ʿalâ mâʾin qourî","mawlidou khayri albachari","fachchourbou bilmouṭahhari","yakouffou kayda almourghami"]},{"a":["يُنَوِّرُ الْقَلْبَ الشَّرَابْ","مِنْ ذَلِكَ الْمَا بِالْمُجَابْ","وَالْقَلْبَ يُحْيِي دُونَ عَابْ","وَعَنْ شَقَاءٍ يَحْتَمِي"],"p":["younawwirou alqalba achcharâb","min dhalika almâ bilmoudjâb","walqalba youhyî doûna ʿâb","waʿan chaqâʾin yahtamî"]},{"a":["إِحْيَاءُ مَوْلِدِ الْبَشِيرْ","يَحْمِي الْعِيَالَ وَالدُّيُورْ","فِيهِ شِفَاءٌ لِلصُّدُورْ","لِكُلِّ هَادٍ يَنْتَمِي"],"p":["ʾihyâʾou mawlidi albachîr","yahmî alʿiyâla waddouyoûr","fîhi chifâʾoun lilççoudoûr","likoulli hâdin yantamî"]},{"a":["صَلَّى عَلَى خَيْرِ الْبَشَرْ","بَاقٍ يُدِيمُ لِي الْبُشَرْ","بِالْآلِ وَالصَّحْبِ الدُّرَرْ","مَعَ سَلَامٍ يَعْتَمِي"],"p":["çallâ ʿalâ khayri albachar","bâqin youdîmou lî albouchar","bilʾâli waççahbi addourar","maʿa salâmin yaʿtamî"]},{"a":["يَا مُلْهِمًا قَدْ وَفَّقَا","صَلِّ عَلَى مَنْ خُلِقَا","وَالْخَلْقَ فَاقَ خُلُقَا","كَالْخَلْقِ وَلْتُسَلِّمِ"],"p":["yâ moulhiman qad waffaqâ","çalli ʿalâ man khouliqâ","walkhalqa fâqa khoulouqâ","kalkhalqi waltousallimi"]},{"a":["قَدْ كَانَ ذَا تَوَسُّطِ","فِي الْقَدِّ جَالِي السُّطُطِ","وَلَمْ يَكُنْ بِالْمُفْرَطِ","وَلَمْ يَكُنْ بِئَادَمِ"],"p":["qad kâna dhâ tawassouṭi","fî alqaddi djâlî assouṭouṭi","walam yakoun bilmoufraṭi","walam yakoun biʾâdami"]},{"a":["وَلَمْ يَكُنْ مُطَهَّمَا","وَلَمْ يَكُنْ مُكَلْثَمَا","بَلْ فَاقَ كُلَّ مَنْ سَمَا","مِنْ مُنْتَمٍ لِئَادَمِ"],"p":["walam yakoun mouṭahhamâ","walam yakoun moukalthamâ","bal fâqa koulla man samâ","min mountamin liʾâdami"]},{"a":["كَانَ يَطُولُ كُلَّ مَنْ","مَاشَاهُ فِي كُلِّ زَمَنْ","وَكَانَ وَاسِعَ الْعَطَنْ","يَضْحَكُ بِالتَّبَسُّمِ"],"p":["kâna yaṭoûlou koulla man","mâchâhou fî koulli zaman","wakâna wâsiʿa alʿaṭan","yaḍhakou bittabassoumi"]},{"a":["وَهْوَ جَلِيلٌ قُلَّبُ","بَيَاضُهُ مُشَرَّبُ","بِحُمْرَةٍ وَأَهْدَبُ","وَأَنْجَلٌ ذُو رَسَمِ"],"p":["wahwa djalîloun qoullabou","bayâḍouhou moucharrabou","bihoumratin waʾahdabou","waʾandjaloun dhoû rasami"]},{"a":["يَفْتَرُّ فِي أَسْنَى ابْتِسَامْ","كَالْبَرْقِ أَوْحَبِّ الْغَمَامْ","وَضَحْكُهُ يَجْلُو الظَّلَامْ","كَسُرُجٍ فِي ظُلَمِ"],"p":["yaftarrou fî ʾasnâ btisâm","kalbarqi ʾawhabbi alghamâm","waḍahkouhou yadjloû aẓẓalâm","kasouroudjin fî ẓoulami"]},{"a":["وَوَجْهُهُ مُدَوَّرُ","وَهْوَ خَمِيصٌ أَزْهَرُ","وَهْوَ بَهِيٌّ أَسْمَرُ","مُرَتِّلُ التَّكَلُّمِ"],"p":["wawadjhouhou moudawwarou","wahwa khamîçoun ʾazharou","wahwa bahiyyoun ʾasmarou","mourattilou attakalloumi"]},{"a":["كَأَنَّ مَاءَ الذَّهَبِ","فِي خَدِّهِ الْمُهَذَّبِ","وَكَانَ سَبْطَ الْقَصَبِ","عِرْنِينُهُ ذُو شَمَمِ"],"p":["kaʾanna mâʾa adhdhahabi","fî khaddihi almouhadhdhabi","wakâna sabṭa alqaçabi","ʿirnînouhou dhoû chamami"]},{"a":["كَامِلُ أُذْنٍ أَدْعَجُ","وَأَشْنَبٌ مُفَلَّجُ","وَأَشْكَلٌ مُبْتَهِجُ","وَالْوَجْهُ مَاحِي الْغُمَمِ"],"p":["kâmilou ʾoudhnin ʾadʿadjou","waʾachnaboun moufalladjou","waʾachkaloun moubtahidjou","walwadjhou mâhî alghoumami"]},{"a":["وَهُوَ أَكْمَلُ الْوَرَى","خَلْقًا وَخُلْقًا ظَهَرَا","وَالْمِثْلُ قَطُّ لَمْ يُرَا","وَلَنْ يُرَى فِي الشِّيَمِ"],"p":["wahouwa ʾakmalou alwarâ","khalqan wakhoulqan ẓaharâ","walmithlou qaṭṭou lam yourâ","walan yourâ fî achchiyami"]},{"a":["أَحْمَدُنَا رَحْمَتُنَا","حَامِدُنَا نِعْمَتُنَا","مَحْمُودُنَا فَرْحَتُنَا","وَالْجُودُ مُزْرِي الدِّيَمِ"],"p":["ʾahmadounâ rahmatounâ","hâmidounâ niʿmatounâ","mahmoûdounâ farhatounâ","waldjoûdou mouzrî addiyami"]},{"a":["إِنِّي أُخَاطِبُ الْجَمِيلْ","مُصَلِّيًا عَلَى الرَّسُولْ","مُسَلِّمًا عَلَى الْوَصُولْ","بِحِزْبِهِ فِي كَلِمِي"],"p":["ʾinnî ʾoukhâṭibou aldjamîl","mouçalliyan ʿalâ arrasoûl","mousalliman ʿalâ alwaçoûl","bihizbihi fî kalimî"]},{"a":["صَلِّ عَلَى الْمُدَّثِّرِ","خَيْرِ الْوَرَى الْمُبَشَّرِ","مَاحِي الْفِرَى الْمُطَهَّرِ","وَآلِهِ وَسَلِّمِ"],"p":["çalli ʿalâ almouddaththiri","khayri alwarâ almoubachchari","mâhî alfirâ almouṭahhari","waʾâlihi wasallimi"]},{"a":["صَلِّ عَلَى الْمُزَّمِّلِ","جَالِي الدُّجَى الْمُؤَمَّلِ","هَامِي النَّدَى لِلْمُرْمِلِ","وَصَحْبِهِ وَسَلِّمِ"],"p":["çalli ʿalâ almouzzammili","djâlî addoudjâ almouʾammali","hâmî annadâ lilmourmili","waçahbihi wasallimi"]},{"a":["صَلِّ عَلَى عَبْدِ الْإِلَهْ","حَبِيبِهِ ذِكْرِ الْإِلَهْ","صَفِيِّهِ سَيْفِ الْإِلَهْ","وَآلِهِ وَسَلِّمِ"],"p":["çalli ʿalâ ʿabdi al ilah","habîbihi dhikri al ilah","çafiyyihi sayfi al ilah","waʾâlihi wasallimi"]},{"a":["صَلِّ عَلَى حِزْبِ الْإِلَهْ","نِعْمَتِهِ بَابِ الْإِلَهْ","صِرَاطِهِ هُدَى الْإِلَهْ","وَصَحْبِهِ وَسَلِّمِ"],"p":["çalli ʿalâ hizbi al ilah","niʿmatihi bâbi al ilah","çirâṭihi houdâ al ilah","waçahbihi wasallimi"]},{"a":["صَلِّ عَلَى سَيِّدِنَا","وَلِيِّنَا قُدْوَتِنَا","حَبِيبِنَا شَفِيعِنَا","وَآلِهِ وَسَلِّمِ"],"p":["çalli ʿalâ sayyidinâ","waliyyinâ qoudwatinâ","habîbinâ chafîʿinâ","waʾâlihi wasallimi"]},{"a":["صَلِّ عَلَى الْمُؤَدَّبِ","ذِي الْحُرْمَةِ الْمُؤَدِّبِ","خَيْرِ رَسُولٍ وَنَبِي","وَصَحْبِهِ وَسَلِّمِ"],"p":["çalli ʿalâ almouʾaddabi","dhî alhourmati almouʾaddibi","khayri rasoûlin wanabî","waçahbihi wasallimi"]},{"a":["صَلِّ عَلَى بَابِ النَّعِيمْ","ذَاكَ الصِّرَاطُ الْمُسْتَقِيمْ","مُحَمَّدٍ خَيْرِ الْأَنِيمْ","وَآلِهِ وَسَلِّمِ"],"p":["çalli ʿalâ bâbi annaʿîm","dhâka aççirâṭou almoustaqîm","mouhammadin khayri al anîm","waʾâlihi wasallimi"]},{"a":["صَلِّ عَلَى عِزِّ الْعَرَبْ","وَذَاكَ كَاشِفُ الْكُرَبْ","وَذَاكَ رَافِعُ الرُّتَبْ","وَصَحْبِهِ وَسَلِّمِ"],"p":["çalli ʿalâ ʿizzi alʿarab","wadhâka kâchifou alkourab","wadhâka râfiʿou arroutab","waçahbihi wasallimi"]},{"a":["صَلِّ عَلَى الْمَاحِي الْوَكِيلْ","وَالْمُتَوَكِّلِ الْكَفِيلْ","قَائِدِنَا إِلَى السَّبِيلْ","وَآلِهِ وَسَلِّمِ"],"p":["çalli ʿalâ almâhî alwakîl","walmoutawakkili alkafîl","qâʾidinâ ʾilâ assabîl","waʾâlihi wasallimi"]},{"a":["صَلِّ عَلَى بَحْرِ الْبُحُورْ","لَيْثِ الْعِدَى شَافِي الصُّدُورْ","نَافِي الشَّقَا بَدْرِ الْبُدُورْ","وَصَحْبِهِ وَسَلِّمِ"],"p":["çalli ʿalâ bahri albouhoûr","laythi alʿidâ châfî aççoudoûr","nâfî achchaqâ badri alboudoûr","waçahbihi wasallimi"]},{"a":["هُوَ الَّذِي قَادَ النَّدَى","لِمَنْ يَجِي لِلِاجْتِدَا","وَمَنْ نَحَاهُ بِاعْتِدَا","لَاقَى الرَّدَى بِالْوَكَمِ"],"p":["houwa aldhî qâda annadâ","liman yadjî lilidjtidâ","waman nahâhou biʿtidâ","lâqâ arradâ bilwakami"]},{"a":["هُوَ الَّذِي امْتَدَّتْ يَدِي","بِهِ لِرَبِّي الْأَفْيَدِ","وَجَادَ لِي بِالْجَيِّدِ","مِنْ غَيْرِ هَاتِ وَكَمِ"],"p":["houwa aldhî mtaddat yadî","bihi lirabbî al afyadi","wadjâda lî bildjayyidi","min ghayri hâti wakami"]},{"a":["لَهُ مِنَ الْخَوَارِقِ","مَا لَمْ يَجِئْ لِسَابِقِ","وَلَا يَفِي لِلَاحِقِ","فَضْلًا مِنَ الْمُقَدِّمِ"],"p":["lahou mina alkhawâriqi","mâ lam yadjiʾ lisâbiqi","walâ yafî lilâhiqi","faḍlan mina almouqaddimi"]},{"a":["مِنْهَا سَلَامُ الْحَجَرِ","عَلَيْهِ مَشْيُ الشَّجَرِ","لَهُ انْشِقَاقُ الْقَمَرِ","بِذِي الْبَقَا وَالْقِدَمِ"],"p":["minhâ salâmou alhadjari","ʿalayhi machyou achchadjari","lahou nchiqâqou alqamari","bidhî albaqâ walqidami"]},{"a":["كَانَ يُظِلُّهُ الْغَمَامْ","يَرَى وَرَاءَ وَأَمَامْ","وَعَيْنُهُ كَانَتْ تَنَامْ","وَقَلْبُهُ لَمْ يَنَمِ"],"p":["kâna youẓillouhou alghamâm","yarâ warâʾa waʾamâm","waʿaynouhou kânat tanâm","waqalbouhou lam yanami"]},{"a":["مِنْهَا تَجَنُّبُ الذُّبَابْ","عَنْ جِسْمِهِ مَعَ الثِّيَابْ","كَذَاكَ تَسْهِيلُ الصِّعَابْ","بِاللَّهِ مُولِي الْمَغْنَمِ"],"p":["minhâ tadjannoubou adhdhoubâb","ʿan djismihi maʿa aththiyâb","kadhâka tashîlou aççiʿâb","billâhi moûlî almaghnami"]},{"a":["مِنْهَا تَوَسُّلُ الطُّيُورْ","بِهِ لَهُ اشْتَكَى بَعِيرْ","وَانْفَجَرَ الْمَاءُ النَّمِيرْ","مِنْ يَدِ ذِي التَّكَرُّمِ"],"p":["minhâ tawassoulou aṭṭouyoûr","bihi lahou chtakâ baʿîr","wânfadjara almâʾou annamîr","min yadi dhî attakarroumi"]},{"a":["سُمِعَ تَسْبِيحُ الطَّعَامْ","فِي كَفِّ أَفْضَلِ الْأَنَامْ","خِطَابُ ظَبْيٍ بِكَلَامْ","مُعْجِزَةُ الْمُحْتَرَمِ"],"p":["soumiʿa tasbîhou aṭṭaʿâm","fî kaffi ʾafḍali al anâm","khiṭâbou ẓabyin bikalâm","mouʿdjizatou almouhtarami"]},{"a":["كَلَامُ ضَبٍّ قَدْ أَتَى","فِيهَا بِنَصٍّ ثَبَتَا","حَنِينُ جِذْعٍ قَدْ أَتَى","فِي مُعْجِزَاتِ الْمُكْرَمِ"],"p":["kalâmou ḍabbin qad ʾatâ","fîhâ binaççin thabatâ","hanînou djidhʿin qad ʾatâ","fî mouʿdjizâti almoukrami"]},{"a":["كَانَ يَزُورُ مَنْزِلَهْ","رِضْوَانُ كَيْ يُبَجِّلَهْ","مِنْهَا طُيُورٌ مُرْسَلَهْ","عَلَى ذَوِي التَّعَظُّمِ"],"p":["kâna yazoûrou manzilah","riḍwânou kay youbadjdjilah","minhâ ṭouyoûroun moursalah","ʿalâ dhawî attaʿaẓẓoumi"]},{"a":["نَحَا إِلَى الْبَيْتِ الْحَرَامْ","لِكَيْ يَصِيرَ ذَا انْهِدَامْ","مُسْتَدْرَجٌ مِنَ الْأَنَامْ","لِلْجَهْلِ بِالْمُعَظَّمِ"],"p":["nahâ ʾilâ albayti alharâm","likay yaçîra dhâ nhidâm","moustadradjoun mina al anâm","lildjahli bilmouʿaẓẓami"]},{"a":["وَاللَّهُ جَلَّ فَعَلَا","بِجَيْشِهِ مَا فَعَلَا","بِجَاهِهِ وَجَعَلَا","كَيْدَهُمُ فِي الْيَهَمِ"],"p":["wallâhou djalla faʿalâ","bidjaychihi mâ faʿalâ","bidjâhihi wadjaʿalâ","kaydahoumou fî alyahami"]},{"a":["فَالْكُلُّ مِنْ ذَوِي الْبَطَرْ","مَاتَ بِأَسْوَإِ حَجَرْ","جَعَلَهُمْ رَبُّ الْبَشَرْ","كَلُقَمٍ لِنَهِمِ"],"p":["falkoullou min dhawî albaṭar","mâta biʾaswaʾi hadjar","djaʿalahoum rabbou albachar","kalouqamin linahimi"]},{"a":["وَمِنْ خَوَارِقَ بَدَا","مَا حَازَ غَارُ الْمُقْتَدَى","صَلَّى عَلَيْهِ مَنْ هَدَى","بِهِ ذَوِي التَّفَهُّمِ"],"p":["wamin khawâriqa badâ","mâ hâza ghârou almouqtadâ","çallâ ʿalayhi man hadâ","bihi dhawî attafahhoumi"]},{"a":["بِعَنْكَبُوتٍ نَسَجَتْ","مَعَ حَمَامٍ أَثْبَتَتْ","حَوْمًا بِهِ قَدْ سَتَرَتْ","ذَاتَيْهِمَا كَظُلَمِ"],"p":["biʿankaboûtin nasadjat","maʿa hamâmin ʾathbatat","hawman bihi qad satarat","dhâtayhimâ kaẓoulami"]},{"a":["وَالْكَافِرُونَ قَدْ أَتَوْا","وَأَثَرَ الْمَاحِي قَفَوْا","وَمِنْهُ شَيْئًا لَمْ يَرَوْا","وَرَجَعُوا بِالْأَلَمِ"],"p":["walkâfiroûna qad ʾataw","waʾathara almâhî qafaw","waminhou chayʾan lam yaraw","waradjaʿoû bilʾalami"]},{"a":["وَهُوَ ذُو تَسَتُّرِ","مَعَ الْعَتِيقِ الْأَكْبَرِ","فِي الْغَارِ مَرْأَى نَظَرِ","وَمَا رَأَوْا مِنْ أَرِمِ"],"p":["wahouwa dhoû tasattouri","maʿa alʿatîqi al akbari","fî alghâri marʾâ naẓari","wamâ raʾaw min ʾarimi"]},{"a":["حِمَى الْحَفِيظِ الْمَانِعِ","يُغْنِي عَنِ الْمَدَافِعِ","لِكُلِّ عَبْدٍ خَاشِعِ","يَطْلُبُ خَيْرَ الْحُرُمِ"],"p":["himâ alhafîẓi almâniʿi","youghnî ʿani almadâfiʿi","likoulli ʿabdin khâchiʿi","yaṭloubou khayra alhouroumi"]},{"a":["كَانَ يُعِينُهُ الرِّيَاحْ","كَمَا يُعِينُهُ الرِّمَاحْ","وَهْوَ غَنِيٌّ عَنْ سِلَاحْ","بِرَبِّهِ الْمُكَرِّمِ"],"p":["kâna youʿînouhou arriyâh","kamâ youʿînouhou arrimâh","wahwa ghaniyyoun ʿan silâh","birabbihi almoukarrimi"]},{"a":["يَا رَبِّ صَلِّ سَرْمَدَا","عَلَى النَّبِيِّ أَحْمَدَا","وَآلِهِ ذَوِي الْهُدَى","وَصَحْبِهِ وَسَلِّمِ"],"p":["yâ rabbi çalli sarmadâ","ʿalâ annabiyyi ʾahmadâ","waʾâlihi dhawî alhoudâ","waçahbihi wasallimi"]},{"a":["يَا رَبِّ صَلِّ أَبَدَا","عَلَى نَبِيٍّ عَبَدَا","وَآلِهِ ذَوِي النَّدَى","وَصَحْبِهِ وَسَلِّمِ"],"p":["yâ rabbi çalli ʾabadâ","ʿalâ nabiyyin ʿabadâ","waʾâlihi dhawî annadâ","waçahbihi wasallimi"]},{"a":["يَا رَبِّ صَلِّ كُلَّ حِينْ","عَلَى رَسُولِكَ الْأَمِينْ","وَآلِهِ ذَوِي الْيَقِينْ","وَصَحْبِهِ وَسَلِّمِ"],"p":["yâ rabbi çalli koulla hîn","ʿalâ rasoûlika al amîn","waʾâlihi dhawî alyaqîn","waçahbihi wasallimi"]},{"a":["يَا رَبِّ صَلِّ فِي الدُّهُورْ","عَلَى الَّذِي مَحَا الثُّبُورْ","وَآلِهِ ذَوِي الْحُبُورْ","وَصَحْبِهِ وَسَلِّمِ"],"p":["yâ rabbi çalli fî addouhoûr","ʿalâ aldhî mahâ aththouboûr","waʾâlihi dhawî alhouboûr","waçahbihi wasallimi"]},{"a":["يَا رَبِّ صَلِّ كُلَّ عَامْ","عَلَى النَّبِي خَيْرِ الْأَنَامْ","وَآلِهِ عَلَى دَوَامْ","وَصَحْبِهِ وَسَلِّمِ"],"p":["yâ rabbi çalli koulla ʿâm","ʿalâ annabî khayri al anâm","waʾâlihi ʿalâ dawâm","waçahbihi wasallimi"]},{"a":["يَا رَبِّ صَلِّ فِي الْوُقُوتْ","عَلَى الْفَصِيحِ ذِي السُّكُوتْ","وَآلِهِ ذَوِي الْقُنُوتْ","وَصَحْبِهِ وَسَلِّمِ"],"p":["yâ rabbi çalli fî alwouqoût","ʿalâ alfaçîhi dhî assoukoût","waʾâlihi dhawî alqounoût","waçahbihi wasallimi"]},{"a":["يَا رَبِّ صَلِّ فِي النَّهَارْ","عَلَى النَّبِي فَخْرِ نِزَارْ","وَآلِهِ ذَوِي الْفَخَارْ","وَصَحْبِهِ وَسَلِّمِ"],"p":["yâ rabbi çalli fî annahâr","ʿalâ annabî fakhri nizâr","waʾâlihi dhawî alfakhâr","waçahbihi wasallimi"]},{"a":["يَا رَبِّ صَلِّ فِي الصَّبَاحْ","عَلَى النَّبِيِّ ذِي الصَّلَاحْ","وَآلِهِ ذَوِي الْفَلَاحْ","وَصَحْبِهِ وَسَلِّمِ"],"p":["yâ rabbi çalli fî aççabâh","ʿalâ annabiyyi dhî aççalâh","waʾâlihi dhawî alfalâh","waçahbihi wasallimi"]},{"a":["صَلِّ وَسَلِّمْ فِي الْمَسَا","وَاللَّيْلِ يَا مَنْ قَدُسَا","عَلَى رَئِيسِ الرُّؤَسَا","خَيْرِ الْبَرَايَا سُلَّمِي"],"p":["çalli wasallim fî almasâ","wallayli yâ man qadousâ","ʿalâ raʾîsi arrouʾasâ","khayri albarâyâ soullamî"]},{"a":["يَا رَبِّ صَلِّ بِسَلَامْ","عَلَى النَّبِيِّ فِي دَوَامْ","وَالْآلِ وَالصَّحْبِ الْكِرَامْ","وَاقْبَلْ بِهِ مُنْتَظِمِي"],"p":["yâ rabbi çalli bisalâm","ʿalâ annabiyyi fî dawâm","wal âli waççahbi alkirâm","wâqbal bihi mountaẓimî"]},{"a":["صَلِّ عَلَى لَيْثٍ شَفَى","بِيَوْمِ بَدْرٍ إِذْ وَفَى","مَعَ الصِّحَابِ الْحُنَفَا","بِعَهْدِهِ الْمُعَظَّمِ"],"p":["çalli ʿalâ laythin chafâ","biyawmi badrin ʾidh wafâ","maʿa aççihâbi alhounafâ","biʿahdihi almouʿaẓẓami"]},{"a":["سَلِّمْ عَلَى بَدْرٍ جَلَا","دُجَى الْقُلُوبِ وَعَلَا","ذَوِي الْمَقَامَاتِ الْعُلَى","وَحِزْبِهِ وَعَظِّمِ"],"p":["sallim ʿalâ badrin djalâ","doudjâ alqouloûbi waʿalâ","dhawî almaqâmâti alʿoulâ","wahizbihi waʿaẓẓimi"]},{"a":["قَدْ قَامَ خَيْرُ الْبَشَرِ","وَسْطَ خِيَارِ الزُّمَرِ","إِلَى ذَوِي التَّكَبُّرِ","كَالْبَدْرِ وَسْطَ أَنْجُمِ"],"p":["qad qâma khayrou albachari","wasṭa khiyâri azzoumari","ʾilâ dhawî attakabbouri","kalbadri wasṭa ʾandjoumi"]},{"a":["يَوْمًا بِهِ اشْتَدَّ النِّضَالْ","يَوْمًا بِهِ اشْتَدَّ الْقِتَالْ","يَوْمَ تَعَارُفِ الرِّجَالْ","يَوْمَ الرِّضَى وَالْوَجَمِ"],"p":["yawman bihi chtadda anniḍâl","yawman bihi chtadda alqitâl","yawma taʿâroufi arridjâl","yawma arriḍâ walwadjami"]},{"a":["وَذَلِكَ الْيَوْمُ فَلَاحْ","لِذِي اهْتِدَاءٍ وَرَبَاحْ","لِذِي ارْتِقَاءٍ وَصَلَاحْ","لِكُلِّ شَخْصٍ مُسْلِمِ"],"p":["wadhalika alyawmou falâh","lidhî htidâʾin warabâh","lidhî rtiqâʾin waçalâh","likoulli chakhçin mouslimi"]},{"a":["يَوْمٌ بِهِ قَدْ غَفَرَا","ذُنُوبَ مَنْ قَدْ حَضَرَا","قِتَالَهُ رَبُّ الْوَرَى","كَبِيرَةً كَلَمَمِ"],"p":["yawmoun bihi qad ghafarâ","dhounoûba man qad haḍarâ","qitâlahou rabbou alwarâ","kabîratan kalamami"]},{"a":["لَاقَى ذَوُو الْخَيْرِ الصِّحَابْ","فِيهِ ذَوِي الضَّيْرِ الصِّعَابْ","وَهُمْ مَعًا أُسْدٌ غِضَابْ","ذَوُو ارْتِفَاعِ هِمَمِ"],"p":["lâqâ dhawoû alkhayri aççihâb","fîhi dhawî aḍḍayri aççiʿâb","wahoum maʿan ʾousdoun ghiḍâb","dhawoû rtifâʿi himami"]},{"a":["تَنَازَعُوا الْمَوْتَ مَعَا","وَالْكُلُّ مِنْهُمْ شَجُعَا","يَبْغِي اللِّقَا أَوْ يُصْرَعَا","لِحُبِّ مَاحِي الْغُمَمِ"],"p":["tanâzaʿoû almawta maʿâ","walkoullou minhoum chadjouʿâ","yabghî alliqâ ʾaw youçraʿâ","lihoubbi mâhî alghoumami"]},{"a":["وَقَاتَلُوا مَنْ قَدْ نَعَا","هُمُ شَفِيعُ الشُّفَعَا","حَتَّى الْغُبَارُ سَطَعَا","بَيْنَ جَبَانٍ وَكَمِي"],"p":["waqâtaloû man qad naʿâ","houmou chafîʿou achchoufaʿâ","hattâ alghoubârou saṭaʿâ","bayna djabânin wakamî"]},{"a":["ثُمَّ نَحَا مِنَ السَّمَا","خَيْلٌ وَجُنْدٌ عَظُمَا","إِلَى رَئِيسِ الْكُرَمَا","بِشْرًا بِغَيْرِ وَكَمِ"],"p":["thoumma nahâ mina assamâ","khayloun wadjoundoun ʿaẓoumâ","ʾilâ raʾîsi alkouramâ","bichran bighayri wakami"]},{"a":["أَمَدَّهُ رَبُّ الْأَنَامْ","بِجُنْدِ أَمْلَاكٍ عِظَامْ","لِعَدَدٍ لَا لِلِحَامْ","أَرْدَوْا ذَوِي التَّعَظُّمِ"],"p":["ʾamaddahou rabbou al anâm","bidjoundi ʾamlâkin ʿiẓâm","liʿadadin lâ lilihâm","ʾardaw dhawî attaʿaẓẓoumi"]},{"a":["وَفِيهِمُ إِذْ وَرَدُوا","خَلِيلُهُ الْمُمَجَّدُ","جِبْرِيلُ نِعْمَ السَّنَدُ","فَوْقَ جَوَادٍ شَيْظَمِ"],"p":["wafîhimou ʾidh waradoû","khalîlouhou almoumadjdjadou","djibrîlou niʿma assanadou","fawqa djawâdin chayẓami"]},{"a":["وَسَارَعُوا إِلَى الْكِفَاحْ","مَعَ السُّيُوفِ وَالرِّمَاحْ","حُبَّ صَلَاحٍ وَفَلَاحْ","خَلْفَ الْإِمَامِ الْأَعْظَمِ"],"p":["wasâraʿoû ʾilâ alkifâh","maʿa assouyoûfi warrimâh","houbba çalâhin wafalâh","khalfa al imâmi al aʿẓami"]},{"a":["وَفِيهِمُ الْمُحَقِّقُ","سَيِّدُنَا الْمُوَفَّقُ","أَصْدَقُ مَنْ قَدْ صَدَّقُوا","بِالْهَاشِمِيِّ الْعَلَمِ"],"p":["wafîhimou almouhaqqiqou","sayyidounâ almouwaffaqou","ʾaçdaqou man qad çaddaqoû","bilhâchimiyyi alʿalami"]},{"a":["صِدِّيقُهُ الْمُكَبَّرُ","ذُو الْهَيْبَةِ الْمُوَقَّرُ","أَنِيسُهُ الْمُصَبَّرُ","فِي الْغَارِ بَعْدَ الْأَعْلَمِ"],"p":["çiddîqouhou almoukabbarou","dhoû alhaybati almouwaqqarou","ʾanîsouhou almouçabbarou","fî alghâri baʿda al aʿlami"]},{"a":["وَفِيهِمُ الْمُبَشَّرُ","بِكُلِّ خَيْرٍ عُمَرُ","سَيِّدُنَا الْمُؤْتَمِرُ","عِزَّةُ كُلِّ مُسْلِمِ"],"p":["wafîhimou almoubachcharou","bikoulli khayrin ʿoumarou","sayyidounâ almouʾtamirou","ʿizzatou koulli mouslimi"]},{"a":["وَفِيهِمُ مَنْ نَكَحَا","بِنْتَيْ رَئِيسِ الصُّلَحَا","نُورَيْنِ حِينَ أَفْلَحَا","بِحَطِّ كُلِّ مَأْثَمِ"],"p":["wafîhimou man nakahâ","bintay raʾîsi aççoulahâ","noûrayni hîna ʾaflahâ","bihaṭṭi koulli maʾthami"]},{"a":["سَيِّدُنَا الْمُجَمَّلُ","عُثْمَانُ مَنْ قَدْ قَتَلُوا","وَهْوَ إِذًا يُرَتِّلُ","كِتَابَ مُعْطِي الْأَكْثَمِ"],"p":["sayyidounâ almoudjammalou","ʿouthmânou man qad qataloû","wahwa ʾidhan yourattilou","kitâba mouʿṭî al akthami"]},{"a":["وَفِيهِمُ الْجَالِي الْوَثَنْ","أَبُو الْحُسَيْنِ وَالْحَسَنْ","بَابُ الْعُلُومِ وَالْخَتَنْ","أَبُو الشِّرَافِ الْأَنْجُمِ"],"p":["wafîhimou aldjâlî alwathan","ʾaboû alhousayni walhasan","bâbou alʿouloûmi walkhatan","ʾaboû achchirâfi al andjoumi"]},{"a":["سَيِّدُنَا الْمُكَرَّمُ","عَلِيُّهُ الْمُعَظَّمُ","مُرْدِي الْعِدَى الْعَثَمْثَمُ","مَاحِي الْأَذَى وَالْوَجَمِ"],"p":["sayyidounâ almoukarramou","ʿaliyyouhou almouʿaẓẓamou","mourdî alʿidâ alʿathamthamou","mâhî al adhâ walwadjami"]},{"a":["بِذَلِكَ الْيَوْمِ حَصَلْ","لَنَا أَمَانٌ مِنْ وَجَلْ","وَمِنْ عَنَاءٍ وَخَجَلْ","وَمِنْ جَوًى وَنَدَمِ"],"p":["bidhalika alyawmi haçal","lanâ ʾamânoun min wadjal","wamin ʿanâʾin wakhadjal","wamin djawanâ wanadami"]},{"a":["بِهِ غَنِينَا لِلْجِنَانْ","عَنْ غَزْوَةٍ وَعَنْ هَوَانْ","بِهِ لَنَا طَابَ الزَّمَانْ","مَعَ قَبُولِ الْخِدَمِ"],"p":["bihi ghanînâ lildjinân","ʿan ghazwatin waʿan hawân","bihi lanâ ṭâba azzamân","maʿa qaboûli alkhidami"]},{"a":["فَلْنَحْمَدِ اللَّهَ عَلَى","نَجَاتِنَا مِمَّنْ قَلَى","وَكُلِّ شَرٍّ مُسْجَلَا","بِالْمُصْطَفَى الْمُقَدَّمِ"],"p":["falnahmadi allâha ʿalâ","nadjâtinâ mimman qalâ","wakoulli charrin mousdjalâ","bilmouçṭafâ almouqaddami"]},{"a":["إِنِّي أُخَاطِبُ الْجَمِيلْ","فِيهِ وَفِي الْآلِ الْعُدُولْ","وَصَحْبِهِ بِلَا خُمُولْ","بِصَلِّيَنْ وَسَلِّمِ"],"p":["ʾinnî ʾoukhâṭibou aldjamîl","fîhi wafî al âli alʿoudoûl","waçahbihi bilâ khoumoûl","biçalliyan wasallimi"]},{"a":["يَا رَبَّنَا يَا رَبَّنَا","يَا خِلَّنَا يَا حِبَّنَا","صَلِّ عَلَى سَيِّدِنَا","مُحَمَّدٍ وَسَلِّمِ"],"p":["yâ rabbanâ yâ rabbanâ","yâ khillanâ yâ hibbanâ","çalli ʿalâ sayyidinâ","mouhammadin wasallimi"]},{"a":["وَآلِهِ وَصَحْبِهِ","وَذِي تَعَلُّقٍ بِهِ","مِنْ أَوْلِيَاءِ حِزْبِهِ","وَلْتَتَقَبَّلْ قَلَمِي"],"p":["waʾâlihi waçahbihi","wadhî taʿallouqin bihi","min ʾawliyâʾi hizbihi","waltataqabbal qalamî"]},{"a":["وَارْضَ عَنِ الصَّحْبِ الْكِرَامْ","رِضًى يَقُودُ لِي الْمَرَامْ","وَلِيَ كُنْ يَا ذَا الْأَنَامْ","بِلَا عِدًى أَوْ وَلَمِ"],"p":["wârḍa ʿani aççahbi alkirâm","riḍanâ yaqoûdou lî almarâm","waliya koun yâ dhâ al anâm","bilâ ʿidanâ ʾaw walami"]},{"a":["وَاشْكُرْ صَلَاتِيَ عَلَى","سَيِّدِنَا بَابِ الْعُلَى","وَتِي الْقَصِيدَةَ اقْبَلَا","لِوَجْهِكَ الْمُكَرَّمِ"],"p":["wâchkour çalâtiya ʿalâ","sayyidinâ bâbi alʿoulâ","watî alqaçîdata qbalâ","liwadjhika almoukarrami"]},{"a":["يَا رَبَّنَا صَلِّ عَلَى","خَيْرِ نَبِيٍّ أُرْسِلَا","مُحَمَّدٍ وَزِدْ عُلَى","أُمَّتِهِ وَسَلِّمِ"],"p":["yâ rabbanâ çalli ʿalâ","khayri nabiyyin ʾoursilâ","mouhammadin wazid ʿoulâ","ʾoummatihi wasallimi"]},{"a":["يَا رَبَّنَا صَلِّ عَلَى","خَيْرِ رَسُولٍ فُضِّلَا","مُحَمَّدٍ وَعَسِّلَا","كِتَابَتِي وَسَلِّمِ"],"p":["yâ rabbanâ çalli ʿalâ","khayri rasoûlin fouḍḍilâ","mouhammadin waʿassilâ","kitâbatî wasallimi"]},{"a":["يَا رَبَّنَا صَلِّ عَلَى","خَيْرِ نَبِيٍّ قَدْ عَلَا","مُحَمَّدٍ وَلْتَقْبَلَا","خَطِّي بِهِ وَسَلِّمِ"],"p":["yâ rabbanâ çalli ʿalâ","khayri nabiyyin qad ʿalâ","mouhammadin waltaqbalâ","khaṭṭî bihi wasallimi"]},{"a":["يَا رَبَّنَا صَلِّ عَلَى","خَيْرِ رَسُولٍ بُجِّلَا","مُحَمَّدٍ وَجَمِّلَا","حَالِي بِهِ وَسَلِّمِ"],"p":["yâ rabbanâ çalli ʿalâ","khayri rasoûlin boudjdjilâ","mouhammadin wadjammilâ","hâlî bihi wasallimi"]},{"a":["يَا رَبَّنَا صَلِّ عَلَى","خَيْرِ شَفِيعٍ قُبِلَا","مُحَمَّدٍ وَكَمِّلَا","قَصْدِي بِهِ وَسَلِّمِ"],"p":["yâ rabbanâ çalli ʿalâ","khayri chafîʿin qoubilâ","mouhammadin wakammilâ","qaçdî bihi wasallimi"]},{"a":["يَا رَبَّنَا صَلِّ عَلَى","مَاحٍ أَزَالَ الْوَجَلَا","مُحَمَّدٍ وَحَصِّلَا","مَا سَرَّنِي وَسَلِّمِ"],"p":["yâ rabbanâ çalli ʿalâ","mâhin ʾazâla alwadjalâ","mouhammadin wahaççilâ","mâ sarranî wasallimi"]},{"a":["يَا رَبَّنَا صَلِّ عَلَى","خَيْرِ سِرَاجٍ اعْتَلَى","مُحَمَّدٍ مَنْ غَسَلَا","مَا سَاءَنِي وَسَلِّمِ"],"p":["yâ rabbanâ çalli ʿalâ","khayri sirâdjin ʿtalâ","mouhammadin man ghasalâ","mâ sâʾanî wasallimi"]},{"a":["يَا رَبَّنَا صَلِّ عَلَى","خَيْرِ مُنِيرٍ أُرْسِلَا","مُحَمَّدٍ مَنْ كَمُلَا","مُرَادُهُ وَسَلِّمِ"],"p":["yâ rabbanâ çalli ʿalâ","khayri mounîrin ʾoursilâ","mouhammadin man kamoulâ","mourâdouhou wasallimi"]},{"a":["يَا رَبَّنَا صَلِّ عَلَى","خَيْرِ بَشِيرٍ نَوَّلَا","مُحَمَّدٍ مَنْ عَجَّلَا","بُشَارَتِي وَسَلِّمِ"],"p":["yâ rabbanâ çalli ʿalâ","khayri bachîrin nawwalâ","mouhammadin man ʿadjdjalâ","bouchâratî wasallimi"]},{"a":["يَا رَبَّنَا صَلِّ عَلَى","مَنْ سَبْقُهُ قَدْ عُقِلَا","مُحَمَّدٍ مَنْ أَخْجَلَا","قَالِيَنِي وَسَلِّمِ"],"p":["yâ rabbanâ çalli ʿalâ","man sabqouhou qad ʿouqilâ","mouhammadin man ʾakhdjalâ","qâliyanî wasallimi"]},{"a":["يَا رَبَّنَا صَلِّ عَلَى","مَنْ كَسَلِي قَدْ غَسَلَا","مُحَمَّدٍ مَنْ بَجَّلَا","قَصَائِدِي وَسَلِّمِ"],"p":["yâ rabbanâ çalli ʿalâ","man kasalî qad ghasalâ","mouhammadin man badjdjalâ","qaçâʾidî wasallimi"]},{"a":["يَا رَبَّنَا صَلِّ عَلَى","أَعْقَلِ كُلِّ الْعُقَلَا","مُحَمَّدٍ مَنْ عَقَلَا","مُبَارِزِي وَسَلِّمِ"],"p":["yâ rabbanâ çalli ʿalâ","ʾaʿqali koulli alʿouqalâ","mouhammadin man ʿaqalâ","moubârizî wasallimi"]},{"a":["صَلِّ عَلَى سَارٍ سَمَا","فَوْقَ الْبُرَاقِ لِلسَّمَا","مُحَمَّدٍ وَكَرِّمَا","بِحِزْبِهِ وَسَلِّمِ"],"p":["çalli ʿalâ sârin samâ","fawqa albourâqi lilssamâ","mouhammadin wakarrimâ","bihizbihi wasallimi"]},{"a":["قَدْ بَاتَ يَخْرِقُ الطِّبَاقْ","فِي اللَّيْلِ قَاصِدَ وِفَاقْ","وَالْأَنْبِيَاءُ بِاتِّفَاقْ","لَاقَوْهُ بِالتَّكَرُّمِ"],"p":["qad bâta yakhriqou aṭṭibâq","fî allayli qâçida wifâq","wal anbiyâʾou bittifâq","lâqawhou bittakarroumi"]},{"a":["وَاحْتَرَمُوا وَقَدَّمُوا","وَكَرَّمُوا وَاسْتَسْلَمُوا","تَوَاضُعًا وَعَظَّمُوا","لِقَدْرِهِ الْمُحْتَرَمِ"],"p":["wâhtaramoû waqaddamoû","wakarramoû wâstaslamoû","tawâḍouʿan waʿaẓẓamoû","liqadrihi almouhtarami"]},{"a":["تَوَاضَعُوا إِذْ عَرَفُوا","رُتْبَتَهُ وَشَرَّفُوا","لِقَاءَهُ وَاعْتَرَفُوا","بِالْفَضْلِ وَالتَّقَدُّمِ"],"p":["tawâḍaʿoû ʾidh ʿarafoû","routbatahou wacharrafoû","liqâʾahou wâʿtarafoû","bilfaḍli wattaqaddoumi"]},{"a":["وَابْتَدَرُوا بِالْمَرْحَبِ","وَالسَّهْلِ وَالتَّأَدُّبِ","وَالْبِشْرِ وَالتَّقَرُّبِ","لِرَبِّهِ الْمُقَدِّمِ"],"p":["wâbtadaroû bilmarhabi","wassahli wattaʾaddoubi","walbichri wattaqarroubi","lirabbihi almouqaddimi"]},{"a":["وَالْكُلُّ مِنْهُمْ شَرَعَا","فِي مَحْمَدٍ إِذْ سَمِعَا","ذِكْرَ شَفِيعِ الشُّفَعَا","مَعَ الْأَمِينِ الْأَقْدَمِ"],"p":["walkoullou minhoum charaʿâ","fî mahmadin ʾidh samiʿâ","dhikra chafîʿi achchoufaʿâ","maʿa al amîni al aqdami"]},{"a":["وَالْكُلُّ مِنْهُمْ مَدَحَا","مِنْ بَعْدِمَا قَدْ فَرِحَا","بِبَعْثِهِ وَانْشَرَحَا","صَدْرًا لِشُكْرِ النِّعَمِ"],"p":["walkoullou minhoum madahâ","min baʿdimâ qad farihâ","bibaʿthihi wâncharahâ","çadran lichoukri anniʿami"]},{"a":["فَغَابَ عَنْهُمْ وَارْتَقَى","فَوْقَ الْبُرَاقِ لِلِقَا","حَبِيبِهِ وَاخْتَرَقَا","حُجْبَ الْإِلَهِ الْمُنْعِمِ"],"p":["faghâba ʿanhoum wârtaqâ","fawqa albourâqi liliqâ","habîbihi wâkhtaraqâ","houdjba al ilahi almounʿimi"]},{"a":["ثُمَّ لِدَارِهِ انْثَنَى","وَقَدْ حَوَى كُلَّ مُنَى","مِنْهُ وَأَذْهَبَ الْعَنَا","وَجَالِبَاتِ النِّقَمِ"],"p":["thoumma lidârihi nthanâ","waqad hawâ koulla mounâ","minhou waʾadhhaba alʿanâ","wadjâlibâti anniqami"]},{"a":["نِعْمَ النَّبِيُّ وَالرَّسُولْ","نِعْمَ الَّذِي جَادَ بِسُولْ","لَنَا بِرَبِّهِ الْجَمِيلْ","مِنْ ذِكْرِهِ وَاللَّقَمِ"],"p":["niʿma annabiyyou warrasoûl","niʿma aldhî djâda bisoûl","lanâ birabbihi aldjamîl","min dhikrihi wallaqami"]},{"a":["آيَاتُ طَهَ أَحْمَدَا","لَا تَتَنَاهَى سَرْمَدَا","وَنَتْ قُوَى ذَوِي الْهُدَى","عَنْ خَطِّهَا بِالْقَلَمِ"],"p":["âyâtou ṭaha ʾahmadâ","lâ tatanâhâ sarmadâ","wanat qouwâ dhawî alhoudâ","ʿan khaṭṭihâ bilqalami"]},{"a":["أَرْسَلَهُ اللَّهُ إِلَى","كُلِّ الْوَرَى مُرَتِّلَا","ذِكْرًا عَلَيْهِ أُنْزِلَا","هُدًى لِذِي التَّعَلُّمِ"],"p":["ʾarsalahou allâhou ʾilâ","koulli alwarâ mourattilâ","dhikran ʿalayhi ʾounzilâ","houdanâ lidhî attaʿalloumi"]},{"a":["أَكْرِمْ بِذَلِكَ الْكِتَابْ","فِيهِ هُدَاهُ وَالثَّوَابْ","فِيهِ الْخِطَابُ وَالْجَوَابْ","مِنْ رَبِّنَا ذِي الْقِدَمِ"],"p":["ʾakrim bidhalika alkitâb","fîhi houdâhou waththawâb","fîhi alkhiṭâbou waldjawâb","min rabbinâ dhî alqidami"]},{"a":["هُوَ الشِّفَا مِنْ كُلِّ دَا","لِمَنْ عَلَيْهِ اعْتَمَدَا","وَمَنْ أَبَاهُ طُرِدَا","ذَا حَسْرَةٍ وَنَدَمِ"],"p":["houwa achchifâ min koulli dâ","liman ʿalayhi ʿtamadâ","waman ʾabâhou ṭouridâ","dhâ hasratin wanadami"]},{"a":["وَكُلُّ شَخْصٍ أَلْحَدَا","فِيهِ وَلَمْ يَجْتَهِدَا","بِتَوْبَةٍ لَاقَى الرَّدَى","مِنْ رَبِّهِ الْمُنْتَقِمِ"],"p":["wakoullou chakhçin ʾalhadâ","fîhi walam yadjtahidâ","bitawbatin lâqâ arradâ","min rabbihi almountaqimi"]},{"a":["وَهْوَ الَّذِي مَنِ اهْتَدَى","بِهَدْيِهِ نَالَ هُدَى","وَيَحْتَوِي الْفَوْزَ غَدَا","ذَا عِصْمَةٍ مِنْ نِقَمِ"],"p":["wahwa aldhî mani htadâ","bihadyihi nâla houdâ","wayahtawî alfawza ghadâ","dhâ ʿiçmatin min niqami"]},{"a":["وَهْوَ كِتَابُهُ الْمُبِينْ","جَاءَ بِهِ النَّدْبُ الْأَمِينْ","بإِذْنِ رَبِّ الْعَالَمِينْ","هُدًى لِحَاوِي الْأَقْوَمِ"],"p":["wahwa kitâbouhou almoubîn","djâʾa bihi annadbou al amîn","bʾidhni rabbi alʿâlamîn","houdanâ lihâwî al aqwami"]},{"a":["وَهْوَ الَّذِي مَنْ أَدْبَرَا","عَنْهُ وَمَا تَدَبَّرَا","فِيهِ عَصَى رَبَّ الْوَرَى","أُضْحُوكَةً لِلُّوَّمِ"],"p":["wahwa aldhî man ʾadbarâ","ʿanhou wamâ tadabbarâ","fîhi ʿaçâ rabba alwarâ","ʾouḍhoûkatan lillouwwami"]},{"a":["وَهْوَ الَّذِي مَنْ ثَبَتَا","فِيهِ وَلَمْ يَلْتَفِتَا","ذَا عَمَلٍ يَكُنْ فَتَى","عِنْدَ الشَّكُورِ الْأَكْرَمِ"],"p":["wahwa aldhî man thabatâ","fîhi walam yaltafitâ","dhâ ʿamalin yakoun fatâ","ʿinda achchakoûri al akrami"]},{"a":["وَهْوَ الَّذِي مَنِ اكْتَفَى","بِهِ احْتَوَى مَا قَدْ كَفَى","وَلَا يُلَاقِي كُلَفَا","ذَوِي الْأَذَى بِالْكَرَمِ"],"p":["wahwa aldhî mani ktafâ","bihi htawâ mâ qad kafâ","walâ youlâqî koulafâ","dhawî al adhâ bilkarami"]},{"a":["أَحْمَدُ رَبِّيَ عَلَى","كِتَابِهِ الَّذِي عَلَا","كُلَّ كِتَابٍ نُزِّلَا","بِكَلْكَلِي وَبِالْفَمِ"],"p":["ʾahmadou rabbiya ʿalâ","kitâbihi aldhî ʿalâ","koulla kitâbin nouzzilâ","bikalkalî wabilfami"]},{"a":["أَشْكُرُ رَبِّيَ الْعَظِيمْ","عَلَى كِتَابِهِ الْحَكِيمْ","وَفُزْتُ فِيهِ بِعُلُومْ","تُفْحِمُ ذَا تَلَفُّمِ"],"p":["ʾachkourou rabbiya alʿaẓîm","ʿalâ kitâbihi alhakîm","wafouztou fîhi biʿouloûm","toufhimou dhâ talaffoumi"]},{"a":["كِتَابُ رَبِّيَ الْكِتَابْ","بِنَصِّ ذَلِكَ الْكِتَابْ","بِهِ عُصِمْتُ مِنْ عِتَابْ","وَجَالِبَاتِ السَّقَمِ"],"p":["kitâbou rabbiya alkitâb","binaççi dhalika alkitâb","bihi ʿouçimtou min ʿitâb","wadjâlibâti assaqami"]},{"a":["هُوَ خَلِيلٌ وَحَبِيبْ","لِي مُغْنِيًا لِي عَنْ طَبِيبْ","بِهِ يُحِبُّنِي لَبِيبْ","يَطْلُبُ خَيْرَ اللَّقَمِ"],"p":["houwa khalîloun wahabîb","lî moughniyan lî ʿan ṭabîb","bihi youhibbounî labîb","yaṭloubou khayra allaqami"]},{"a":["يَا خَيْرَ ذِكْرٍ نُزِّلَا","مِنْ خَيْرِ رَبٍّ أَنْزَلَا","لِيَ تَقُودُ نُزُلَا","مِنْ ذِي الْبَقَا وَالْقِدَمِ"],"p":["yâ khayra dhikrin nouzzilâ","min khayri rabbin ʾanzalâ","liya taqoûdou nouzoulâ","min dhî albaqâ walqidami"]},{"a":["يَا خَيْرَ ذِكْرٍ قَدْ بَدَا","مِمَّنْ صَفَائِي أَبَّدَا","لِي خَلِّدَنَّ رَغَدَا","ذَا أَمَنٍ وَخِدَمِ"],"p":["yâ khayra dhikrin qad badâ","mimman çafâʾî ʾabbadâ","lî khallidanna raghadâ","dhâ ʾamanin wakhidami"]},{"a":["أَنْتَ رَفِيقِي لِلْجِنَانْ","يَا مَنْ يَصُونُ لِي الْمَكَانْ","وَلِي تُطَيِّبُ الْجَنَانْ","يَا خَيْرَ ذِكْرٍ مُحْكَمِ"],"p":["ʾanta rafîqî lildjinân","yâ man yaçoûnou lî almakân","walî touṭayyibou aldjanân","yâ khayra dhikrin mouhkami"]},{"a":["يَا خَيْرَ ذِكْرٍ رُتِّلَا","بِفَمِ ذَاكِرٍ تَلَا","سُقْ لِسِوَايَ مَنْ قَلَى","وَلِيَ كُنْ وَحَكِّمِ"],"p":["yâ khayra dhikrin routtilâ","bifami dhâkirin talâ","souq lisiwâya man qalâ","waliya koun wahakkimi"]},{"a":["يَا خَيْرَ مُنْزَلٍ يُرِي","مَا غَابَ ذَا تَدَبُّرِ","رَبِّي يُصَفِّي فِكَرِي","بِكَ بِغَيْرِ تُهَمِ"],"p":["yâ khayra mounzalin yourî","mâ ghâba dhâ tadabbouri","rabbî youçaffî fikarî","bika bighayri touhami"]},{"a":["يَا خَيْرَ ذِكْرٍ قَدْ جَمَعْ","خَيْرَ الْعُلُومِ وَقَمَعْ","لِيَ عِدَايَ وَمَنَعْ","مِنِّي أَذَى تَوَهُّمِ"],"p":["yâ khayra dhikrin qad djamaʿ","khayra alʿouloûmi waqamaʿ","liya ʿidâya wamanaʿ","minnî ʾadhâ tawahhoumi"]},{"a":["أَنْتَ سَبِيلِي وَالْأَنِيسْ","لِي قُدْتَ فَائِقَ الْمَقِيسْ","بِخِدْمَةِ الْمَاحِي الرَّئِيسْ","مُكَيِّسِي بِالْمُلْهِمِ"],"p":["ʾanta sabîlî wal anîs","lî qoudta fâʾiqa almaqîs","bikhidmati almâhî arraʾîs","moukayyisî bilmoulhimi"]},{"a":["يَا خَيْرَ ذِكْرٍ قَدْ مَحَا","مَا سَاءَ قَلْبِي فَامَّحَى","هَبْ لِيَ كَوْنِي مُفْلِحَا","بِالْمُنْزِلِ الْمُفَهِّمِ"],"p":["yâ khayra dhikrin qad mahâ","mâ sâʾa qalbî fâmmahâ","hab liya kawnî mouflihâ","bilmounzili almoufahhimi"]},{"a":["بِكَ سَأَلْتُ مَالِكِي","كَوْنِيَ نُورَ سَالِكِ","وَذِي انْجِذَابٍ نَاسِكِ","بِمَا انْجَلَى وَالْمُبْهَمِ"],"p":["bika saʾaltou mâlikî","kawniya noûra sâliki","wadhî ndjidhâbin nâsiki","bimâ ndjalâ walmoubhami"]},{"a":["وَأَنْ يَقُودَ لِلنَّبِي","فِي أَبَدٍ بِالنُّخَبِ","سَلَامَيِ الْمُقَرِّبِ","بِلَا انْتِهَا وَمَخْتَمِ"],"p":["waʾan yaqoûda lilnnabî","fî ʾabadin binnoukhabi","salâmayi almouqarribi","bilâ ntihâ wamakhtami"]},{"a":["سُبْحَٰنَ رَبِّكَ رَبِّ الْعِزَّةِ عَمَّا يَصِفُونَ","وَسَلَٰمٌ عَلَى الْمُرْسَلِينَ"],"p":["soubhâna rabbika rabbi alʿizzati ʿammâ yaçifoûna","wasalâmoun ʿalâ almoursalîna"]},{"a":["وَالْحَمْدُ لِلَّهِ رَبِّ الْعَٰلَمِينَ"],"p":["walhamdou lillâhi rabbi alʿâlamîna"]}]}