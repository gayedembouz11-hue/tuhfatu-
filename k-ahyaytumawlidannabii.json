{"id":"ahyaytumawlidannabii","ar":"أَحْيَيْتُ مَوْلِدَ النَّبِى","fr":"Ahyaytu Mawlidan Nabii","lines":[{"a":["أَحْيَيْتُ مَوْلِدَ النَّبِىِّ مِنْ أَسَشِ","وَانْقَادَ لِى فَوْقُ الْمُنَى فِى هَمْسَشِ"],"p":["ahyaytou mawlida nnabiyyi min asach","wanqâda lî fawqou lmounâ fî hamsach"]},{"a":["عَلَّمَنِى مِمَّا يَشَآءُ اللَّهُ","فَفَرَّ إِبْلِيسُ وَمَنْ وَالَاهُ"],"p":["ʿallamanî mimmâ yachâʾou llâh","fafarra iblîsou wa man wâlâh"]},{"a":["وَاجَهَنِى يَوْمُ الْخَمِيسِ فِى رَجَبْ","بِمَا يَدُومُ سَرْمَدًا خَيْرَ عَجَبْ"],"p":["wâdjahanî yawmou lkhamîsi fî radjab","bimâ yadoûmou sarmadan khayra ʿadjab"]},{"a":["ذَبَّ مَبِيعَاتِى لِغَيْرِى بِالثَّمَنْ","اللَّهُ خَالِقُ الْبَرَايَا وَالزَّمَنْ"],"p":["dhabba mabîʿâtî lighayrî biththaman","allâhou khâliqou lbarâyâ wazzaman"]},{"a":["بَرَّأَنِى الْقُدُّوسُ مِنْ أَمْرَاضِى","وَأَسْكَنَ الْأَعْظَمَ فِى أَغْرَاضِى"],"p":["barraʾanî lqouddoûsou min amrâḍî","wa askana laʿẓama fî aghrâḍî"]},{"a":["إِذَا كَتَبْتُ أَوْ قَرَأْتُ جَآءَا","إِلَىَّ مَا يُحَقِّقُ الرَّجَآءَا"],"p":["idhâ katabtou aw qaraʾtou djâʾâ","ilayya mâ youhaqqiqou rradjâʾâ"]},{"a":["لَمْ يَبْقَ بَيْنِى وَبَيْنَ رَبِّى","مُكَدِّرٌ وَقَادَنِى بِالْحُبِّ"],"p":["lam yabqa baynî wa bayna rabbî","moukaddir wa qâdanî bilhoubb"]},{"a":["لَمْ يَبْقَ بَيْنِى وَبَيْنَ الْمُنْتَقَى","صَلَّى عَلَيْهِ اللَّهُ مَانِعُ ارْتِقَآ"],"p":["lam yabqa baynî wa bayna lmountaqâ","çallâ ʿalayhi llâhou mâniʿou rtiqâʾ"]},{"a":["اللَّهُ رَبِّى وَخَلِّى وَالْحَبِيبْ","وَالْمُنْتَقَى وَسِيلَتِى خِلٌّ حَبِيبْ"],"p":["allâhou rabbî wa khallî walhabîb","walmountaqâ wa wasîlatî khillon habîb"]},{"a":["هَرَبَ إِبْلِيسُ لِغَيْرِ ضَرَرِى","مَعَ قَبِيلِهِ وَتَنْمُو دُرَرِى"],"p":["haraba iblîsou lighayri ḍararî","maʿa qabîlihi wa tanmoû dourarî"]},{"a":["مَدَّ لِىَ النَّافِعُ نَفْعًا عَظُمَا","وَلِسِوَاىَ دَعَّ مَنْ تَعَظَّمَا"],"p":["madda liya nnâfiʿou nafʿan ʿaẓoumâ","wa lisiwâya daʿʿa man taʿaẓẓamâ"]},{"a":["نَوَيْتُ شُكْرَ اللَّهِ بِالْكِتَابِ","وَصَانَنِى اللَّهُ عَنِ الْعِتَابِ"],"p":["nawaytou choukra llâhi bilkitâb","waçânanî llâhou ʿani lʿitâb"]},{"a":["كَرَامَتِى خَطُّ يَدِى وَلِى جَذَبْ","أَعْظَمَهُ رَبِّى بِخَطِّى فَانْجَذَبْ"],"p":["karâmatî khaṭṭou yadî wa lî djadhab","aʿẓamahou rabbî bikhaṭṭî fandjadhab"]},{"a":["لَقَّنَنِى فِى الْخَطِّ مُعْطِى الْوَحْىِ","وَلِلْجَنَانِ صَانَ عُمْرِى الْمُحْيِى"],"p":["laqqananî fî lkhaṭṭi mouʿṭî lwahy","wa lildjanâni çâna ʿoumrî lmouhyî"]},{"a":["لَقَّنَنِى طَهَّرَ لُبِّى سَلَّمَا","كُلِّىَ شَاكِرًا لَدَيْهِ الْقَلَمَآ"],"p":["laqqananî ṭahhara loubbî sallamâ","kullîya châkiran ladayhi lqalamâ"]},{"a":["ضَمَّتْنِىَ الْأَقْلَامُ لِلْجُنْدِ الْكِرَامْ","وَقَادَ لِى اللَّهُ بِهَا خَيْرَ مَرَامْ"],"p":["ḍammatniya laqlâmou lildjoundi lkirâm","wa qâda lî llâhou bihâ khayra marâm"]},{"a":["رَدَّتْ كِتَابَتِى عِدَى اللَّهِ إِلَى","سِوَى جِهَاتِى وَظَفِرْتُ بِإِلَى"],"p":["raddat kitâbatî ʿidâ llâhi ilâ","siwâ djihâtî wa ẓafirtou bi ilâ"]},{"a":["رَفَعَ مَا كَتَبْتُهُ مِنْ أَسَشِ","مُنَبِّهًا فِى رَفْعِهِ فِى هَمْسَشِ"],"p":["rafaʿa mâ katabtouhou min asach","mounabbihan fî rafʿihi fî hamsach"]}]}