{
 "id": "allaahuhayyunsamadun",
 "ar": "اللَّهُ حَيٌّ صَمَدٌ",
 "fr": "Allaahu Hayyun Samadun",
 "lines": [
  {
   "a": [
    "اللَّهُ حَيٌّ صَمَدٌ وَبَاقِ",
    "سُبْحَانَهُ ذُو كَنَفٍ وَوَاقِ"
   ],
   "p": [
    "Allâhou hayyoun çamadoun wa bâq",
    "Soubhânahou dhoû kanafin wa wâq"
   ]
  },
  {
   "a": [
    "وَنَحْنُ فِي كَنَفِهِ الْمَنِيعِ",
    "مِنْ كُلِّ شَرٍّ وَأَذًى شَنِيعِ"
   ],
   "p": [
    "Wa nahnou fî kanafihi lmanîʿ",
    "Min kulli sharrin wa adhan shanîʿ"
   ]
  },
  {
   "a": [
    "مُسْتَمْسِكِينَ بِالْغِيَاثِ أَحْمَدَا",
    "خَيْرِ الْأَنَامِ مُنْتَهًى وَمُبْتَدَا"
   ],
   "p": [
    "Moustamsikîna bilghiyâthi ahmadâ",
    "Khayri lanâmi mountahan wa moubtadâ"
   ]
  },
  {
   "a": [
    "مَنْ قَالَهَا فِي زَمَنِ الْوَبَآءِ",
    "أَمَّنَهُ اللَّهُ مِنَ الْبَلَآءِ"
   ],
   "p": [
    "Man qâlahâ fî zamani lwabâʾ",
    "Ammanahou llâhou mina lbalâʾ"
   ]
  },
  {
   "a": [
    "سُبْحَانَ رَبِّكَ رَبِّ الْعِزَّةِ عَمَّا يَصِفُونَ وَسَلَامٌ عَلَى الْمُرْسَلِينَ وَالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ"
   ],
   "p": [
    "Soubhâna rabbika rabbi lʿizzati ʿammâ yaçifoûn wa salâmoun ʿalâ lmoursalîn wa lhamdou lillâhi rabbi lʿâlamîn"
   ]
  }
 ]
}