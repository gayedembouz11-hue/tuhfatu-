{"id":"tuhfatu","ar":"تُحْفَةُ الْمُتَضَرِّعِينَ","fr":"Tuhfatu","lines":[{"a":["الْحَمْدُ لِلَّهِ وَصَلَّى أَبَدَا","عَلَى الَّذِي بِهِ لَنَا الْهُدَى بَدَا"],"p":["alhamdou lillâhi waçallâ ʾabadâ","ʿala lladhî bihi lana lhoudâ badâ"]},{"a":["سَيِّدِنَا مُحَمَّدٍ وَالْآلِ","وَصَحْبِهِ ذَوِي نَوَالِ الْوَالِي"],"p":["sayyidinâ mouhammadin wal âli","waçahbihi dhawî nawâli lwâlî"]},{"a":["هَذَا وَإِنِّي الْيَوْمَ ذُو تَوَسُّلِ","لَهُ بِأَسْمَاءِ ذَوِي التَّفَضُّلِ"],"p":["hadhâ waʾinni lyawma dhoû tawassouli","lahou biʾasmâʾi dhawi ttafaḍḍouli"]},{"a":["فَقُلْتُ يَا قَرِيبُ يَا مُجِيبُ","صَلِّ عَلَى الَّذِي بِهِ تُجِيبُ"],"p":["faqoultou yâ qarîbou yâ moudjîbou","çalli ʿala lladhî bihi toudjîbou"]},{"a":["وَاقْبَلْ بِهِ نَظْمِيَ هَذَا يَا كَرِيمْ","وَهَبْ لِمَنْ بِهِ يُنَاجِي مَا يَرُومْ"],"p":["wâqbal bihi naẓmiya hadhâ yâ karîm","wahab liman bihi younâdjî mâ yaroûm"]},{"a":["رَبِّ بِنُوحٍ وَبِإِبْرَاهِيمَا","لِي اغْفِرْ ذُنُوبِي وَاكْفِنِي الرَّجِيمَا"],"p":["rabbi binoûhin wabiʾibrâhîmâ","lî aghfir dhounoûbî wâkfini rradjîmâ"]},{"a":["وَكُنْ بِمُوسَى وَبِجَاهِ عِيسَى","وَاقِيَنِي دُنْيَا وَأُخْرَى بُوسَى"],"p":["wakoun bimoûsâ wabidjâhi ʿîsâ","wâqiyanî dounyâ waʾoukhrâ boûsâ"]},{"a":["وَبِمُحَمَّدٍ رَسُولِ اللَّهِ","عَلَيْهِ خَيْرُ صَلَوَاتِ اللَّهِ"],"p":["wabimouhammadin rasoûli llâhi","ʿalayhi khayrou çalawâti llâhi"]},{"a":["ثُمَّ عَلَيْهِمْ لِيَ هَبْ إِيمَانَا","قَدْ صَاحَبَ الْإِسْلَامَ وَالْإِحْسَانَا"],"p":["thoumma ʿalayhim liya hab ʾîmânâ","qad çâhaba lʾislâma wal ihsânâ"]},{"a":["بِحُرْمَةِ الصِّدِّيقِ وَالْفَارُوقِ","جُدْ لِيَ بِالْإِخْلَاصِ وَالتَّوْفِيقِ"],"p":["bihourmati ççiddîqi walfâroûqi","djoud liya bilʾikhlâçi wattawfîqi"]},{"a":["بِحَقِّ عُثْمَانَ أَخِي النُّورَيْنِ","وَبِعَلِيٍّ وَالِدِ السِّبْطَيْنِ"],"p":["bihaqqi ʿouthmâna ʾakhi nnoûrayni","wabiʿaliyyin wâlidi ssibṭayni"]},{"a":["هَبْ لِيَ فِي دُنْيَايَ مَعْ أُخْرَايَا","النُّورَ وَالْعُلُوَّ وَالْمَزَايَا"],"p":["hab liya fî dounyâya maʿ ʾoukhrâyâ","annoûra walʿoulouwwa walmazâyâ"]},{"a":["بِحَقِّ طَلْحَةَ وَبِالزُّبَيْرِ","وَحَقِّ سَعْدٍ نَجِّنِي مِنْ ضَيْرِ"],"p":["bihaqqi ṭalhata wabilzzoubayri","wahaqqi saʿdin nadjdjinî min ḍayri"]},{"a":["وَبِسَعِيدٍ وَابْنِ عَوْفٍ نَجِّنِي","مِنْ كُلِّ مَا أَخَافُهُ مِنْ فِتَنِ"],"p":["wabisaʿîdin wâbni ʿawfin nadjdjinî","min koulli mâ ʾakhâfouhou min fitani"]},{"a":["وَبِأَبِي عُبَيْدَةَ اجْلُبْ مَا يُفِيدْ","إِلَى جَنَابِي وَاكْفِ عَنِّي مَا يُبِيدْ"],"p":["wabiʾabî ʿoubaydata adjloub mâ youfîd","ʾilâ djanâbî wâkfi ʿannî mâ youbîd"]},{"a":["بِحَقِّ عَبْدِ اللَّهِ نَجْلِ الْعَمِّ","أَيْ وَلَدِ الْعَبَّاسِ كَثِّرْ عِلْمِي"],"p":["bihaqqi ʿabdi llâhi nadjli lʿammi","ʾay waladi lʿabbâsi kaththir ʿilmî"]},{"a":["بِحَقِّ عَبْدِ اللَّهِ نَجْلِ عُمَرَا","عَنِّي اكْفِ دَأْبًا مَا يَجُرُّ ضَرَرَا"],"p":["bihaqqi ʿabdi llâhi nadjli ʿoumarâ","ʿannî akfi daʾban mâ yadjourrou ḍararâ"]},{"a":["وَبِابْنِ مَسْعُودٍ وَجَاهِ ابْنِ سَلَامْ","قِنِي الْبَلَا وَضُرَّ عَيْنٍ وَكَلَامْ"],"p":["wabibni masʿoûdin wadjâhi abni salâm","qini lbalâ waḍourra ʿaynin wakalâm"]},{"a":["يَا رَبَّنَا بِحُرْمَةِ الْعَبَّاسِ","وَحَمْزَةٍ عَنِّي اكْفِ كُلَّ بَاسِ"],"p":["yâ rabbanâ bihourmati lʿabbâsi","wahamzatin ʿannî akfi koulla bâsi"]},{"a":["بِحُرْمَةِ الْحَسَنِ وَالْحُسَيْنِ","جُدْ لِيَ فِي الدَّارَيْنِ بِالنُّورَيْنِ"],"p":["bihourmati lhasani walhousayni","djoud liya fi ddârayni binnoûrayni"]},{"a":["بِحُرْمَةِ الْقَاسِمِ ثُمَّ الطَّاهِرِ","صَفِّ ظَوَاهِرِيَ مَع ضَمَائِرِي"],"p":["bihourmati lqâsimi thoumma ṭṭâhiri","çaffi ẓawâhiriya maʿ ḍamâʾirî"]},{"a":["بِحُرْمَةِ الطَّيِّبِ إِبْرَاهِيمَا","أَدِمْ عَلَيَّ الْبِشْرَ وَالتَّكْرِيمَا"],"p":["bihourmati ṭṭayyibi ʾibrâhîmâ","ʾadim ʿalayya lbichra wattakrîmâ"]},{"a":["بِجَاهِ فَاطِمَةَ أَفْطِمْ نَفْسِي","عَنْ كُلِّ مَا يَجُرُّنِي لِحَبْسِ"],"p":["bidjâhi fâṭimata ʾafṭim nafsî","ʿan koulli mâ yadjourrounî lihabsi"]},{"a":["وَبِرُقَيَّةَ وَزَيْنَبَ اكْفِنِي","الطَّرْدَ وَالْحِجَابَ كُلَّ زَمَنِ"],"p":["wabirouqayyata wazaynaba akfinî","aṭṭarda walhidjâba koulla zamani"]},{"a":["وَأُمَّنِي دُنْيَا وَأُخْرَى بِالْكَرَمْ","بِأُمِّ كُلْثُومٍ وَجَنِّبْنِي النِّقَمْ"],"p":["waʾoummanî dounyâ waʾoukhrâ bilkaram","biʾoummi koulthoûmin wadjannibni nniqam"]},{"a":["بِأَوْسٍ بْنِ عَامِرٍ وَهَرِمِ","وَحَقِّ مَسْرُوقٍ تَقَبَّلْ كَلِمِي"],"p":["biʾawsin bni ʿâmirin waharimi","wahaqqi masroûqin taqabbal kalimî"]},{"a":["وَبِالرَّبِيعِ وَبِجَاهِ الْأسَْوَدِ","هَبْ لِي اسْتِقَامَةً وَقَوِّمْ أَوَدِي"],"p":["wabilrrabîʿi wabidjâhi lʾsawadi","hab lî astiqâmatan waqawwim ʾawadî"]},{"a":["بِعَامِرِ بْنِ عَابِدِ الرَّحْمَانِ","وَبِأَبِي مَسْلَمَةَ الْخَوْلَانِي"],"p":["biʿâmiri bni ʿâbidi rrahmâni","wabiʾabî maslamata lkhawlânî"]},{"a":["جُدْ لِيَ بِالْغُفْرَانِ وَالسَّعَادَهْ","وَالْعِلْمِ وَالْعَمَلِ وَالْعِبَادَهْ"],"p":["djoud liya bilghoufrâni wassaʿâdah","walʿilmi walʿamali walʿibâdah"]},{"a":["بِالْحَسَنِ الْبَصْرِيِّ هَبْ لِيَ الْوَرَعْ","وَالِانْسِلَاخَ مِنْ هَوَايَ وَالْبِدَعْ"],"p":["bilhasani lbaçriyyi hab liya lwaraʿ","wâlinsilâkha min hawâya walbidaʿ"]},{"a":["وَبِأَبِي هُرَيْرَةٍ وَبِبِلَالْ","وَبِصُهَيْبٍ رَبِّ جُدْ لِي بِنَوَالْ"],"p":["wabiʾabî hourayratin wabibilâl","wabiçouhaybin rabbi djoud lî binawâl"]},{"a":["وَطَاعَتِي اقْبَلْ وَاشْفِنِي مِنْ دَاءِ","سِرًّا وَجَهْرًا بِأَبِي الدَّرْدَاءِ"],"p":["waṭâʿatî aqbal wâchfinî min dâʾi","sirran wadjahran biʾabi ddardâʾi"]},{"a":["بِحُرْمَةِ الْمِقْدَادِ ثُمَّ خَالِدِ","وَبِالزُّبَيْرِ أَوْلِنِي مَقَاصِدِي"],"p":["bihourmati lmiqdâdi thoumma khâlidi","wabilzzoubayri ʾawlinî maqâçidî"]},{"a":["وَبِأَمِيرِ الْمُؤْمِنِينَ عُمَرَا","قِنِيَ مَكْرًا وَشَقَا وَغَرَرَا"],"p":["wabiʾamîri lmouʾminîna ʿoumarâ","qiniya makran wachaqâ waghararâ"]},{"a":["بِحَقِّ قَائِدِ الْمُجَاهِدِينَا","عَلِيٍّ الَّذِي أَعَانَ الدِّينَا"],"p":["bihaqqi qâʾidi lmoudjâhidînâ","ʿaliyyin alladhî ʾaʿâna ddînâ"]},{"a":["بِحَقِّ سَعْدٍ وَبِحَقِّ عُرْوَهْ","زِدْنِي تَمَسُّكًا بِوُثْقَى عُرْوَهْ"],"p":["bihaqqi saʿdin wabihaqqi ʿourwah","zidnî tamassoukan biwouthqâ ʿourwah"]},{"a":["بِحُرْمَةِ الْقَاسِمِ ثُمَّ خَارِجَهْ","زِدْنِيَ قَفْوِي الْمُجْتَبَى مَنَاهِجَهْ"],"p":["bihourmati lqâsimi thoumma khâridjah","zidniya qafwi lmoudjtabâ manâhidjah"]},{"a":["وَبِأَبِي بَكْرٍ وَعَبْدِ اللَّهِ","زِدْنِيَ فَضْلًا مَا لَهُ تَنَاهِ"],"p":["wabiʾabî bakrin waʿabdi llâhi","zidniya faḍlan mâ lahou tanâhi"]},{"a":["وَبِسُلَيْمَانَ قِنِي كَيْدَ اللَّعِينْ","وَكَيْدَ غَيْرِهِ وَكُنْ لِيَ مُعِينْ"],"p":["wabisoulaymâna qinî kayda llaʿîn","wakayda ghayrihi wakoun liya mouʿîn"]},{"a":["بِأُمِّنَا خَدِيجَةٍ هَبْ لِي الْأَمَلْ","فِي الْعِلْمِ وَالْأَدَبِ رَبِّ وَالْعَمَلْ"],"p":["biʾoumminâ khadîdjatin hab li lʾamal","fi lʿilmi wal adabi rabbi walʿamal"]},{"a":["بِأُمِّنَا عَائِشَةٍ قِنِيَ مَا","يَضُرُّنِي فِي الْأَرَضِينَ وَالسَّمَا"],"p":["biʾoumminâ ʿâʾichatin qiniya mâ","yaḍourrounî fi lʾaraḍîna wassamâ"]},{"a":["بِأُمِّنَا حَفْصَةَ حُلْ بَيْنِي أَبَدْ","وَبَيْنَ مَا يَجُرُّ سُوءًا وَنَكَدْ"],"p":["biʾoumminâ hafçata houl baynî ʾabad","wabayna mâ yadjourrou soûʾan wanakad"]},{"a":["بِأُمِّنَا زَيْنَبَ زَيِّنْ مَا ظَهَرْ","مِنِّي وَمَا بَطَنَ وَاجْعَلْنِي وَزَرْ"],"p":["biʾoumminâ zaynaba zayyin mâ ẓahar","minnî wamâ baṭana wâdjʿalnî wazar"]},{"a":["بِمَالِكٍ وَالشَّافِعِيِّ وَأَبِي","حَنِيفَةٍ وَأَحْمَدٍ لِي اسْتَجِبِ"],"p":["bimâlikin wachchâfiʿiyyi waʾabî","hanîfatin waʾahmadin lî astadjibi"]},{"a":["بِجَاهِ جِبْرِيلَ اسْتَجِبْ سُؤَالِي","وَبَلِّغَنِّي مَبْلَغَ الرِّجَالِ"],"p":["bidjâhi djibrîla astadjib souʾâlî","waballighannî mablagha rridjâli"]},{"a":["بِجَاهِ مِيكَائِيلَ هَبْ لِي نِعَمَا","وَنَفْعِيَ اجْعَلْ مِثلَ غَيْثٍ كَرَمَا"],"p":["bidjâhi mîkâʾîla hab lî niʿamâ","wanafʿiya adjʿal mithla ghaythin karamâ"]},{"a":["بِجَاهِ إِسْرَافِيلَ هَبْ لِي عِصْمَهْ","وَلْتَكْفِنِي أَهْوَالَ يَومِ الْغُمَّهْ"],"p":["bidjâhi ʾisrâfîla hab lî ʿiçmah","waltakfinî ʾahwâla yawmi lghoummah"]},{"a":["بِجَاهِ عَزْرَائِيلَ كُنْ لِي يَا جَمِيلْ","طُولَ حَيَاتِي وَكَذَا بَعْدَ الرَّحِيلْ"],"p":["bidjâhi ʿazrâʾîla koun lî yâ djamîl","ṭoûla hayâtî wakadhâ baʿda rrahîl"]},{"a":["وَاجْعَلْ تَوَسُّلِي لِمَنْ يَدْعُو بِهِ","سَعَادَةَ الدَّارَيْنِ وَاغْفِرْ لِي بِهِ"],"p":["wâdjʿal tawassoulî liman yadʿoû bihi","saʿâdata ddârayni wâghfir lî bihi"]},{"a":["وَلِيَ جُدْ وَلِلَّذِي دَعَانِي","لِنَظْمِهِ بِالْأمَْنِ وَالرِّضْوَانِ"],"p":["waliya djoud walilladhî daʿânî","linaẓmihi bilʾmani warriḍwâni"]},{"a":["وَبِالسَّعَادَةِ وَبِالْحِمَايَهْ","عَنْ جُمْلَةِ الْأسَْوَاءِ وَالْعِنَايَهْ"],"p":["wabilssaʿâdati wabilhimâyah","ʿan djoumlati lʾsawâʾi walʿinâyah"]},{"a":["وَبِالنَّجَاةِ مِنْ سُؤَالٍ وَعَذَابْ","وَسَكَرَاتِ الْمَوْتِ رَبِّ وَالْحِسَابْ"],"p":["wabilnnadjâti min souʾâlin waʿadhâb","wasakarâti lmawti rabbi walhisâb"]},{"a":["وَبِالْبُشَارَاتِ وَبِالسُّرُورِ","عِنْدَ مَمَاتِنَا وَفِي النُّشُورِ"],"p":["wabilbouchârâti wabilssouroûri","ʿinda mamâtinâ wafi nnouchoûri"]},{"a":["وَصَلِّيَنْ وَسَلِّمَنْ عَلَى النَّبِي","وَآلِهِ مَعَ الصِّحَابِ النُّجُبِ"],"p":["waçalliyan wasalliman ʿala nnabî","waʾâlihi maʿa ççihâbi nnoudjoubi"]},{"a":["وَاغْفِرْ لِوَالِدَيَّ وَاغْفِرْ لِجَمِيعْ","أَهْلِي وَجُمْلَةِ صِحَابِي يَا سَمِيعْ"],"p":["wâghfir liwâlidayya wâghfir lidjamîʿ","ʾahlî wadjoumlati çihâbî yâ samîʿ"]},{"a":["وَاغْفِرْ لِكُلِّ ذِي تَعَلُّقٍ بِيَا","وَحَقِّقَنْ سَعَادَتِي يَا رَبِّيَا"],"p":["wâghfir likoulli dhî taʿallouqin biyâ","wahaqqiqan saʿâdatî yâ rabbiyâ"]},{"a":["وَالْطُفْ بِنَا وَقَوِّنَا وَكُنْ لَنَا","وَهَبْ لَنَا حُسْنَ الْخِتَامِ رَبَّنَا"],"p":["walṭouf binâ waqawwinâ wakoun lanâ","wahab lanâ housna lkhitâmi rabbanâ"]},{"a":["وَصَلِّيَنْ عَلَى النَّبِي وَسَلِّمِ","وَاقْضِ بِهِ حَاجَةَ كُلِّ مُسْلِمِ"],"p":["waçalliyan ʿala nnabî wasallimi","wâqḍi bihi hâdjata koulli mouslimi"]},{"a":["سُبْحَانَ رَبِّكَ رَبِّ الْعِزَّةِ عَمَّا يَصِفُونَ","وَسَلَامٌ عَلَى الْمُرْسَلِينَ وَالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ"],"p":["soubhâna rabbika rabbi lʿizzati ʿammâ yaçifoûna","wasalâmoun ʿala lmoursalîna walhamdou lillâhi rabbi lʿâlamîna"]}]}