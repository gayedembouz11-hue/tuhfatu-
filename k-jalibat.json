{"id":"jalibat","ar":"هَمَّتْ سُلَيْمَى","fr":"Hammat Sulaymâ","lines":[{"a":["جَالِبَةُ الْمَزِيَّاتِ وَدَافِعَةُ الرَّزِيَّاتِ"],"p":["djâlibatou lmaziyyâti wadâfiʿatou rraziyyâti"]},{"a":["فِي مَدْحِ خَيْرِ الْبَرِيَّاتِ"],"p":["fî madhi khayri lbariyyâti"]},{"a":["لِبِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَلَهُ أَيْضًا زِيدَ فَيْضًا فِي شَهْرِ الْمَوْلِدِ"],"p":["libismi llâhi rrahmâni rrahîmi walahou ʾayḍan zîda fayḍan fî chahri lmawlidi"]},{"a":["مَدْحُهُ صَلَّى اللَّهُ تَعَالَى عَلَيْهِ وَسَلَّمَ عَامَ أَحَدَ عَشَرَ وَثَلَاثِمِائَةٍ وَأَلْفٍ"],"p":["madhouhou çalla llâhou taʿâlâ ʿalayhi wasallama ʿâma ʾahada ʿachara wathalâthimiʾatin waʾalfin"]},{"a":["فِي وَطَنِهِ طُوبَى حَرَسَهَا اللَّهُ تَعَالَى بِجَاهِ الْمَمْدُوحِ صَلَّى اللَّهُ"],"p":["fî waṭanihi ṭoûbâ harasaha llâhou taʿâlâ bidjâhi lmamdoûhi çalla llâhou"]},{"a":["تَعَالَى عَلَيْهِ وَسَلَّمَ"],"p":["taʿâlâ ʿalayhi wasallama"]},{"a":["جَالِبَةُ الْمَزِيَّاتِ وَدَافِعَةُ الرَّزِيَّاتِ فِي مَدْحِ خَيْرِ الْبَرِيَّاتِ"],"p":["djâlibatou lmaziyyâti wadâfiʿatou rraziyyâti fî madhi khayri lbariyyâti"]},{"a":["صَلَّى اللَّهُ تَعَالَى عَلَيْهِ وَسَلَّمَ"],"p":["çalla llâhou taʿâlâ ʿalayhi wasallama"]},{"a":["هَمَّتْ سُلَيْمَى بِصَرْفِي عَنْ مَزِيَّاتِ","كَيْ مَا تَقُودَ زِمَامِي لِلرَّزِيَّاتِ"],"p":["hammat soulaymâ biçarfî ʿan maziyyâti","kay mâ taqoûda zimâmî lirraziyyâti"]},{"a":["أَبْدَتْ لِتَصْطَادَ قَلْبِي حُسْنَ بَهْجَتِهَا","وَوَجَّهَتْ لِي الْهَدَايَا بِالْمَبَرَّاتِ"],"p":["ʾabdat litaçṭâda qalbî housna bahdjatihâ","wawadjdjahat li lhadâyâ bilmabarrâti"]},{"a":["أَمْسَتْ تُطَيِّبُ نَفْسِي كَيْ أَمِيلَ لَهَا","وَحَاوَلَتْ مَيْلَ قَلْبِي لِلْهَدِيَّاتِ"],"p":["ʾamsat touṭayyibou nafsî kay ʾamîla lahâ","wahâwalat mayla qalbî lilhadiyyâti"]},{"a":["وَخَاطَبَتْنِي بِمَا يَدْعُو لِخِطْبَتِهَا","وَأَظْهَرَتْ صِدْقَ وَعْدٍ بِالرَّغِيبَاتِ"],"p":["wakhâṭabatnî bimâ yadʿoû likhiṭbatihâ","waʾaẓharat çidqa waʿdin birraghîbâti"]},{"a":["طَوْرًا تَجِينِي وَتُولِينِي جَوَائِزَهَا","وَتَارَةً لِيَ تُهْدِي بِالْبُشَارَاتِ"],"p":["ṭawran tadjînî watoûlînî djawâʾizahâ","watâratan liya touhdî bilbouchârâti"]},{"a":["لَكِنْ عَلِمْتُ وَعِلْمِي سَوْفَ يَنْفَعُنِي","بِأَنَّهَا ذَاتُ مَيْنٍ فِي الْمَقَالَاتِ"],"p":["lakin ʿalimtou waʿilmî sawfa yanfaʿounî","biʾannahâ dhâtou maynin fi lmaqâlâti"]},{"a":["كَانَتْ مَوَاعِيدُ عُرْقُوبٍ لَهَا مَثَلًا","وَمَا مَوَاعِيدُهَا غَيْرُ الْخِيَانَاتِ"],"p":["kânat mawâʿîdou ʿourqoûbin lahâ mathalan","wamâ mawâʿîdouhâ ghayrou lkhiyânâti"]},{"a":["لَيْسَتْ تُرِي الصَّفْوَ إِلَّا قَدْ أَرَتْ كَدَرًا","مِنْ بَعْدِهِ وَتُدَارِي بِالْمَكِيدَاتِ"],"p":["laysat touri ççafwa ʾillâ qad ʾarat kadaran","min baʿdihi watoudârî bilmakîdâti"]},{"a":["وَلَا تُرِي النَّفْعَ إِلَّا أَدْخَلَتْ ضَرَرًا","فِيهِ وَتُضْمِرُ هَضْمًا فِي الْمَعُونَاتِ"],"p":["walâ touri nnafʿa ʾillâ ʾadkhalat ḍararan","fîhi watouḍmirou haḍman fi lmaʿoûnâti"]},{"a":["فَعُجْتُ عَنْهَا إِلَى مَا اللَّهُ يُدْخِلُنِي","بِهِ جِنَانًا حَوَتْ حُورًا وَفِيَّاتِ"],"p":["faʿoudjtou ʿanhâ ʾilâ ma llâhou youdkhilounî","bihi djinânan hawat hoûran wafiyyâti"]},{"a":["هُنَّ الْغَوَانِي اللَّوَاتِي لَا تُكَافِئُهَا","سَلْمَى وَهِنْدٌ وَلَيْلَى فِي الْخَرِيدَاتِ"],"p":["hounna lghawâni llawâtî lâ toukâfiʾouhâ","salmâ wahindoun walaylâ fi lkharîdâti"]},{"a":["هُنَّ الْغَوَانِي اللَّوَاتِي لَا يَفُوزُ بِهَا","إِلَّا الَّذِي ازْدَانَ بِالتَّقْوَى بِطَاعَاتِ"],"p":["hounna lghawâni llawâtî lâ yafoûzou bihâ","ʾilla lladhî azdâna bittaqwâ biṭâʿâti"]},{"a":["هُنَّ الْغَوَانِي اللَّوَاتِي الدَّهْرَ مَاكِثَةٌ","فِيمَا لَهَا مِنْ خِيَامٍ وَسْطَ جَنَّاتِ"],"p":["hounna lghawâni llawâti ddahra mâkithatoun","fîmâ lahâ min khiyâmin wasṭa djannâti"]},{"a":["حُورٌ لَدَى اللَّهِ عِينٌ لَا يُقَارِبُهَا","حَيْضٌ وَلَا دَرَنٌ دَامَتْ نَقِيَّاتِ"],"p":["hoûroun lada llâhi ʿînoun lâ youqâribouhâ","hayḍoun walâ daranoun dâmat naqiyyâti"]},{"a":["حُورٌ لَدَى اللَّهِ أَتْرَابٌ مُخَدَّرَةٌ","تَحْتَ الْقِبَابِ مِنَ الْبُؤْسَى سَلِيمَاتِ"],"p":["hoûroun lada llâhi ʾatrâboun moukhaddaratoun","tahta lqibâbi mina lbouʾsâ salîmâti"]},{"a":["فُقْنَ الْقَنَادِيلَ نُورًا طِيبُهَا عَبِقٌ","يُخْجِلْنَ بَدْرَ يَدٍ فَوْقَ السَّمَاوَاتِ"],"p":["fouqna lqanâdîla noûran ṭîbouhâ ʿabiqoun","youkhdjilna badra yadin fawqa ssamâwâti"]},{"a":["لَهُنَّ جِسْمٌ رَطِيبٌ خَالِصٌ خَضِرٌ","ضَوْءُ التَّرَائِبِ جَالٍ لِلدُّجُنَّاتِ"],"p":["lahounna djismoun raṭîboun khâliçoun khaḍiroun","ḍawʾou ttarâʾibi djâlin liddoudjounnâti"]},{"a":["مِرْآةُ أَزْوَاجِهَا أَبْدَانُهُنَّ نَعَمْ","إِذْ نُورُ أَبْدَانِهَا يُزْرِي السِّرَاجَاتِ"],"p":["mirʾâtou ʾazwâdjihâ ʾabdânouhounna naʿam","ʾidh noûrou ʾabdânihâ youzri ssirâdjâti"]},{"a":["مَا مَسَّهُنَّ لَدُنْ ذُو الْعَرْشِ أَنْشَأَهَا","شَيْءٌ مِنَ الْوَصْمِ فِي وَصْفٍ وَلَا ذَاتِ"],"p":["mâ massahounna ladoun dhou lʿarchi ʾanchaʾahâ","chayʾoun mina lwaçmi fî waçfin walâ dhâti"]},{"a":["وَلَيْسَ يَبْغِينَ بِالْأَزْوَاجِ مِنْ بَدَلٍ","وَبَهْجَةُ النُّورِ تَنْمُو كُلَّ سَاعَاتِ"],"p":["walaysa yabghîna bilʾazwâdji min badalin","wabahdjatou nnoûri tanmoû koulla sâʿâti"]},{"a":["وَلَا يَزَلْنَ عُذَارَى عِنْدَهُمْ أَبَدًا","أَكْرِمْ بِهِنَّ خَرِيدَاتٍ صَفِيَّاتِ"],"p":["walâ yazalna ʿoudhârâ ʿindahoum ʾabadan","ʾakrim bihinna kharîdâtin çafiyyâti"]},{"a":["وَلَا يَصِرْنَ إِلَى مَوْتٍ وَلَا هَرَمٍ","بَلْ لَا يَزَلْنَ مُقِيمَاتٍ مُحِبَّاتِ"],"p":["walâ yaçirna ʾilâ mawtin walâ haramin","bal lâ yazalna mouqîmâtin mouhibbâti"]},{"a":["هُنَّ الْغَوَانِي اللَّوَاتِي الْقَلْبُ طَابَ بِهَا","يَخْتَارُهُنَّ عَلَى سَلْمَى وَهِنْدَاتِ"],"p":["hounna lghawâni llawâti lqalbou ṭâba bihâ","yakhtârouhounna ʿalâ salmâ wahindâti"]},{"a":["وَمَهْرُهُنَّ اتِّقَاءُ اللَّهِ فَاطِرِهَا","بِتَوْبَةٍ مِنْ هَوَى نَفْسٍ لِطَاعَاتِ"],"p":["wamahrouhounna attiqâʾou llâhi fâṭirihâ","bitawbatin min hawâ nafsin liṭâʿâti"]},{"a":["بِتَوْبَةٍ وَبِإِسْلَامٍ إِلَى مَلِكٍ","قَدْ جَادَ بِالْمُصْطَفَى كَنْزِ الْبَرِيَّاتِ"],"p":["bitawbatin wabiʾislâmin ʾilâ malikin","qad djâda bilmouçṭafâ kanzi lbariyyâti"]},{"a":["أَسْلَمْتُ نَفْسِي لِرَبٍّ لَا شَرِيكَ لَهُ","مَعَ الَّذِي قَفْوُهُ شُغْلِي وَحَاجَاتِي"],"p":["ʾaslamtou nafsî lirabbin lâ charîka lahou","maʿa lladhî qafwouhou choughlî wahâdjâtî"]},{"a":["أَسْلَمْتُ نَفْسِي لِرَبٍّ لَا شَبِيهَ لَهُ","مَعَ الَّذِي حُبُّهُ أَقْصَى مَرَامَاتِي"],"p":["ʾaslamtou nafsî lirabbin lâ chabîha lahou","maʿa lladhî houbbouhou ʾaqçâ marâmâtî"]},{"a":["أَسْلَمْتُ نَفْسِي لِرَبٍّ لَا نَظِيرَ لَهُ","مَعَ الَّذِي نَهْجُهُ خَيْرُ الْمَحَجَّاتِ"],"p":["ʾaslamtou nafsî lirabbin lâ naẓîra lahou","maʿa lladhî nahdjouhou khayrou lmahadjdjâti"]},{"a":["أَسْلَمْتُ نَفْسِي لِرَبٍّ لَا مُعِينَ لَهُ","مَعَ الَّذِي دِينُهُ خَيْرُ الدِّيَانَاتِ"],"p":["ʾaslamtou nafsî lirabbin lâ mouʿîna lahou","maʿa lladhî dînouhou khayrou ddiyânâti"]},{"a":["أَسْلَمْتُ نَفْسِي لِرَبٍّ لَا ابْتِدَاءَ لَهُ","مَعَ الَّذِي قَدْ حَوَى خَيْرَ الطَّرِيقَاتِ"],"p":["ʾaslamtou nafsî lirabbin lâ abtidâʾa lahou","maʿa lladhî qad hawâ khayra ṭṭarîqâti"]},{"a":["أَسْلَمْتُ نَفْسِي لِرَبٍّ لَا انْتِهَاءَ لَهُ","مَعَ الَّذِي قُرْبُهُ كُبْرَى مُهِمَّاتِي"],"p":["ʾaslamtou nafsî lirabbin lâ antihâʾa lahou","maʿa lladhî qourbouhou koubrâ mouhimmâtî"]},{"a":["أَسْلَمْتُ نَفْسِي لِرَبٍّ جَلَّ عَنْ وَلَدٍ","مَعَ الَّذِي مَدْحُهُ شَرْعِي وَعَادَاتِي"],"p":["ʾaslamtou nafsî lirabbin djalla ʿan waladin","maʿa lladhî madhouhou charʿî waʿâdâtî"]},{"a":["أَسْلَمْتُ نَفْسِي لِرَبٍّ جَلَّ عَنْ غَرَضٍ","مَعَ الَّذِي جَزْلُهُ أَرْجَى ذَخِيرَاتِي"],"p":["ʾaslamtou nafsî lirabbin djalla ʿan gharaḍin","maʿa lladhî djazlouhou ʾardjâ dhakhîrâtî"]},{"a":["أَسْلَمْتُ نَفْسِي لِرَبٍّ جَلَّ عَنْ مَثَلٍ","مَعَ الَّذِي قَدْ نَجَا مِنْ كُلِّ آفَاتِ"],"p":["ʾaslamtou nafsî lirabbin djalla ʿan mathalin","maʿa lladhî qad nadjâ min koulli âfâti"]},{"a":["أَسْلَمْتُ لِلَّهِ رَبِّ الْعَالَمِينَ بِمَا","مُحَمَّدٍ خَيْرِ مَنْ وَلَّى وَمَنْ يَاتِي"],"p":["ʾaslamtou lillâhi rabbi lʿâlamîna bimâ","mouhammadin khayri man wallâ waman yâtî"]},{"a":["صَلَّى عَلَيْهِ الَّذِي أَعْلَى مَرَاتِبَهُ","فَوْقَ الْمَرَاتِبِ فِي الْمَاضِي وَفِي الْآتِي"],"p":["çallâ ʿalayhi lladhî ʾaʿlâ marâtibahou","fawqa lmarâtibi fi lmâḍî wafi lʾâtî"]},{"a":["وَالْآلِ وَالصَّحْبِ وَالْمُسْتَمْسِكِينَ بِهِ","أَزْكَى صَلَاةٍ بِهَا تَنْفِي الرُّعُونَاتِ"],"p":["wal âli waççahbi walmoustamsikîna bihi","ʾazkâ çalâtin bihâ tanfi rrouʿoûnâti"]},{"a":["صَلَّى عَلَيْهِ الَّذِي أَعْلَاهُ مُعْتَلِيًا","فَوْقَ الَّذِينَ احْتَوَوْا أَعْلَى الْمَقَامَاتِ"],"p":["çallâ ʿalayhi lladhî ʾaʿlâhou mouʿtaliyan","fawqa lladhîna ahtawaw ʾaʿla lmaqâmâti"]},{"a":["وَالْآلِ وَالصَّحْبِ وَالْقَافِينَ سُنَّتَهُ","أَزْكَى صَلَاةٍ بِهَا أَحْوِي الْفُتُوحَاتِ"],"p":["wal âli waççahbi walqâfîna sounnatahou","ʾazkâ çalâtin bihâ ʾahwi lfoutoûhâti"]},{"a":["صَلَّى عَلَيْهِ الَّذِي أَعْلَى نُبُوَّتَهُ","حَتَّى اسْتَجَارَتْ بِهِ أَهْلُ النُّبُوَّاتِ"],"p":["çallâ ʿalayhi lladhî ʾaʿlâ noubouwwatahou","hattâ astadjârat bihi ʾahlou nnoubouwwâti"]},{"a":["وَالْآلِ وَالصَّحْبِ وَالْمُسْتَرْشِدِينَ بِهِ","أَزْكَى صَلَاةٍ بِهَا أَحْوِي السَّعَادَاتِ"],"p":["wal âli waççahbi walmoustarchidîna bihi","ʾazkâ çalâtin bihâ ʾahwi ssaʿâdâti"]},{"a":["صَلَّى عَلَيْهِ الَّذِي أَعْطَاهُ مُعْجِزَةً","أَخْزَتْ ذَوِي السِّحْرِ طُرًّا وَالْكَهَانَاتِ"],"p":["çallâ ʿalayhi lladhî ʾaʿṭâhou mouʿdjizatan","ʾakhzat dhawi ssihri ṭourran walkahânâti"]},{"a":["وَالْآلِ وَالصَّحْبِ وَالْمُسْتَنْجِدِينَ بِهِ","أَزْكَى صَلَاةٍ بِهَا أَحْوِي الْكَرَامَاتِ"],"p":["wal âli waççahbi walmoustandjidîna bihi","ʾazkâ çalâtin bihâ ʾahwi lkarâmâti"]},{"a":["صَلَّى عَلَيْهِ الَّذِي أَبْدَى تَقَدُّمَهُ","عَلَى مَلَا الْأَرْضِ طُرًّا وَالسَّمَاوَاتِ"],"p":["çallâ ʿalayhi lladhî ʾabdâ taqaddoumahou","ʿalâ mala lʾarḍi ṭourran wassamâwâti"]},{"a":["وَالْآلِ وَالصَّحْبِ وَالْمُسْتَنْقِذِينَ بِهِ","أَزْكَى صَلَاةٍ بِهَا أَحْوِي الْفُيُوضَاتِ"],"p":["wal âli waççahbi walmoustanqidhîna bihi","ʾazkâ çalâtin bihâ ʾahwi lfouyoûḍâti"]},{"a":["صَلَّى عَلَيْهِ صَلَاةً أَسْتَقِيمُ بِهَا","مَنْ خَصَّهُ بِالتَّدَلِّي فِي الْمُلَاقَاةِ"],"p":["çallâ ʿalayhi çalâtan ʾastaqîmou bihâ","man khaççahou bittadallî fi lmoulâqâti"]},{"a":["وَالْآلِ وَالصَّحْبِ وَالْمُحْيِينَ سُنَّتَهُ","مَعَ السَّلَامِ بِلَا إِنْهَاءِ غَايَاتِ"],"p":["wal âli waççahbi walmouhyîna sounnatahou","maʿa ssalâmi bilâ ʾinhâʾi ghâyâti"]},{"a":["ذَاكَ الْمُجِيرُ الَّذِي قَدِ اسْتَجَرْتُ بِهِ","مِنْ شَرِّ نَفْسِي وَشَيْطَانٍ وَعَاهَاتِ"],"p":["dhâka lmoudjîrou lladhî qadi astadjartou bihi","min charri nafsî wachayṭânin waʿâhâti"]},{"a":["وَمِنْ مَكَايِدِ أَعْدَائِي وَمِنْ زَمَنِي","وَمِنْ كَلَامٍ وَعَيْنٍ كُلَّ أَوْقَاتِ"],"p":["wamin makâyidi ʾaʿdâʾî wamin zamanî","wamin kalâmin waʿaynin koulla ʾawqâti"]},{"a":["وَمِنْ تَغَيُّرِ أَحْوَالِي لِغَيْرِ هُدًى","وَمِنْ جَمِيعِ الرَّزَايَا وَالْخَطِيئَاتِ"],"p":["wamin taghayyouri ʾahwâlî lighayri houdanâ","wamin djamîʿi rrazâyâ walkhaṭîʾâti"]},{"a":["مُحَمَّدٌ ذِكْرُهُ أُنْسِي وَمَفْرَحَتِي","وَنُورُ قَلْبِي وَأَعْضَائِي وَرَاحَاتِي"],"p":["mouhammadoun dhikrouhou ʾounsî wamafrahatî","wanoûrou qalbî waʾaʿḍâʾî warâhâtî"]},{"a":["وَهْوَ رَجَائِيَ فِي الدَّارَيْنِ يَحْضُرُنِي","عِنْدَ احْتِضَارِي وَقَبْرِي وَالْقِيَامَاتِ"],"p":["wahwa radjâʾiya fi ddârayni yahḍourounî","ʿinda ahtiḍârî waqabrî walqiyâmâti"]},{"a":["وَهْوَ الشَّفِيعُ الَّذِي الْغَفَّارُ يَغْفِرُ لِي","بِجَاهِهِ كُلَّ عِصْيَانٍ وَزَلَّاتِ"],"p":["wahwa chchafîʿou lladhi lghaffârou yaghfirou lî","bidjâhihi koulla ʿiçyânin wazallâti"]},{"a":["وَهْوَ النَّصِيحُ الَّذِي الرَّحْمَانُ يَلْطُفُ بِي","بِجَاهِهِ وَيَقِينِي مِنْ غُرُورَاتِ"],"p":["wahwa nnaçîhou lladhi rrahmânou yalṭoufou bî","bidjâhihi wayaqînî min ghouroûrâti"]},{"a":["وَهْوَ الْوَصُولُ الَّذِي مَوْلَايَ يُوصِلُنِي","بِجَاهِهِ وَيَقِينِي مِنْ حِجَابَاتِ"],"p":["wahwa lwaçoûlou lladhî mawlâya yoûçilounî","bidjâhihi wayaqînî min hidjâbâti"]},{"a":["وَهْوَ الْكَرِيمُ الَّذِي الْبَارِي يُكَرِّمُنِي","بِجَاهِهِ وَيَقِينِي مِنْ إِهَانَاتِ"],"p":["wahwa lkarîmou lladhi lbârî youkarrimounî","bidjâhihi wayaqînî min ʾihânâti"]},{"a":["وَهْوَ الْوَكِيلُ الَّذِي الْمَنَّانُ يُسْعِدُنِي","بِجَاهِهِ وَيَقِينِي مِنْ شَقَاوَاتِ"],"p":["wahwa lwakîlou lladhi lmannânou yousʿidounî","bidjâhihi wayaqînî min chaqâwâti"]},{"a":["وَهْوَ الْعَلِيُّ الَّذِي الْحَنَّانُ يَرْفَعُنِي","بِجَاهِهِ وَيُوَلِّينِي الْعِبَادَاتِ"],"p":["wahwa lʿaliyyou lladhi lhannânou yarfaʿounî","bidjâhihi wayouwallîni lʿibâdâti"]},{"a":["وَهْوَ الْقَوِيُّ الَّذِي الْعَالِي يُؤَيِّدُنِي","بِجَاهِهِ وَيَقِينِي مِنْ مَكِيدَاتِ"],"p":["wahwa lqawiyyou lladhi lʿâlî youʾayyidounî","bidjâhihi wayaqînî min makîdâti"]},{"a":["وَهْوَ الْبَشِيرُ الَّذِي الْهَادِي يُبَشِّرُنِي","بِجَاهِهِ وَيَقِينِي كُلَّ غُمَّاتِ"],"p":["wahwa lbachîrou lladhi lhâdî youbachchirounî","bidjâhihi wayaqînî koulla ghoummâti"]},{"a":["وَهْوَ الَّذِي الْبَرُّ يَحْمِينِي وَيَكْلَؤُنِي","بِجَاهِهِ وَيَقِينِي مِنْ مَضَرَّاتِ"],"p":["wahwa lladhi lbarrou yahmînî wayaklaʾounî","bidjâhihi wayaqînî min maḍarrâti"]},{"a":["وَهْوَ السَّخِيُّ الَّذِي الرَّزَّاقُ يَرْزُقُنِي","بِجَاهِهِ وَيَقِينِي مِنْ فَضِيحَاتِ"],"p":["wahwa ssakhiyyou lladhi rrazzâqou yarzouqounî","bidjâhihi wayaqînî min faḍîhâti"]},{"a":["وَهْوَ النَّجِيُّ الَّذِي الْوَالِي يُعَلِّمُنِي","بِجَاهِهِ مِنْهُ أَسْرَارًا خَفِيَّاتِ"],"p":["wahwa nnadjiyyou lladhi lwâlî youʿallimounî","bidjâhihi minhou ʾasrâran khafiyyâti"]},{"a":["وَهْوَ الْقَوِيُّ الَّذِي لَا شَكَّ يَصْرِفُنِي","عَنِ الْعَوَائِقِ طُرًّا وَالرَّذِيلَاتِ"],"p":["wahwa lqawiyyou lladhî lâ chakka yaçrifounî","ʿani lʿawâʾiqi ṭourran warradhîlâti"]},{"a":["وَهْوَ الْمُرَقِّي الَّذِي لَا شَكَّ يَنْظُرُنِي","دَهْرًا بِنَظْرَةِ تَطْهِيرٍ لِئَافَاتِ"],"p":["wahwa lmouraqqi lladhî lâ chakka yanẓourounî","dahran binaẓrati taṭhîrin liʾâfâti"]},{"a":["وَهْوَ الْجَوَادُ الَّذِي جَلَّتْ جَوَائِزُهُ","عِنْدِي وَقَادَ زِمَامِي كُلَّ سَاعَاتِ"],"p":["wahwa ldjawâdou lladhî djallat djawâʾizouhou","ʿindî waqâda zimâmî koulla sâʿâti"]},{"a":["مِنْ ذَا الْتَزَمْتُ لَهُ فِي كُلِّ مَا سَنَةٍ","دَيْنَ امْتِدَاحٍ بِأَبْيَاتٍ غَرِيبَاتِ"],"p":["min dha ltazamtou lahou fî koulli mâ sanatin","dayna amtidâhin biʾabyâtin gharîbâti"]},{"a":["قَدِ الْتَزَمْتُ لَهُ فِي كُلِّ مَا سَنَةٍ","مَا دَامَ عَقْلِي مَعِي دَيْنَ الْهَدِيَّاتِ"],"p":["qadi ltazamtou lahou fî koulli mâ sanatin","mâ dâma ʿaqlî maʿî dayna lhadiyyâti"]},{"a":["فَكَيْفَ أَتْرُكُ عَامًا شُكْرَ وَاسِطَةٍ","أَسْنَى الْوَسَائِطِ طُرًّا وَالْوَسِيلَاتِ"],"p":["fakayfa ʾatroukou ʿâman choukra wâsiṭatin","ʾasna lwasâʾiṭi ṭourran walwasîlâti"]},{"a":["وَكُلَّ عَامٍ تُوَافِينِي مَوَاهِبُهُ","بَلْ كُلَّ وَقْتٍ يُوَاسِينِي بِمِنَّاتِ"],"p":["wakoulla ʿâmin touwâfînî mawâhibouhou","bal koulla waqtin youwâsînî biminnâti"]},{"a":["نُورٌ ضَرِيحَتُهُ بَحْرٌ قَرِيحَتُهُ","عَمَّتْ نَصِيحَتُهُ كُلَّ الْبَرِيَّاتِ"],"p":["noûroun ḍarîhatouhou bahroun qarîhatouhou","ʿammat naçîhatouhou koulla lbariyyâti"]},{"a":["وَهْوَ الْمَلَاذُ الَّذِي لَاذَ الْكِرَامُ بِهِ","لَمَّا دَرَوْا أَنَّهُ مُشْكِي الشِّكَايَاتِ"],"p":["wahwa lmalâdhou lladhî lâdha lkirâmou bihi","lammâ daraw ʾannahou mouchki chchikâyâti"]},{"a":["وَلَمْ يَكُنْ مِنْ رَئِيسٍ حَازَ مَرْتَبَةً","إِلَّا وَمَتَّ بِهِ وَقْتًا مِنَ اَوْقَاتِ"],"p":["walam yakoun min raʾîsin hâza martabatan","ʾillâ wamatta bihi waqtan mina awqâti"]},{"a":["أَجْدَادُهُ الْفُضَلَا مَتُّوا بِهِ وَحَوَوْا","بِهِ مِنَ اللَّهِ فَوْزًا بِالْإِجَابَاتِ"],"p":["ʾadjdâdouhou lfouḍalâ mattoû bihi wahawaw","bihi mina llâhi fawzan bilʾidjâbâti"]},{"a":["نَالُوا جَمِيعًا بِهِ قَبْلَ الْوِلَادَةِ مَا","رَامُوا بِهِ مِنْ مُهِمَّاتٍ وَحَاجَاتِ"],"p":["nâloû djamîʿan bihi qabla lwilâdati mâ","râmoû bihi min mouhimmâtin wahâdjâti"]},{"a":["بِجَاهِهِ فَازَ بِالْغُفْرَانِ آدَمُ مِنْ","بَعْدِ انْهِبَاطٍ مِنَ اَنْهَارٍ وَجَنَّاتِ"],"p":["bidjâhihi fâza bilghoufrâni âdamou min","baʿdi anhibâṭin mina anhârin wadjannâti"]},{"a":["نَجَّى بِهِ اللَّهُ نُوحًا فِي سَفِينَتِهِ","وَجَاهُهُ كَفَّ يَعْقُوبَ الْبَلِيَّاتِ"],"p":["nadjdjâ bihi llâhou noûhan fî safînatihi","wadjâhouhou kaffa yaʿqoûba lbaliyyâti"]},{"a":["بِالْمُصْطَفَى أَخْرَجُ الْمَنَّانُ يُوسُفَ مِنْ","سِجْنٍ مَتِينٍ وَمِنْ تِلْكَ الْغَيَابَاتِ"],"p":["bilmouçṭafâ ʾakhradjou lmannânou yoûsoufa min","sidjnin matînin wamin tilka lghayâbâti"]},{"a":["وَصَاحِبُ النُّونِ لِلْمَوْلَى الْتَجَا فَنَجَا","بِالْمُنْتَقَى فَتَنَاءَى كُلَّ غُمَّاتِ"],"p":["waçâhibou nnoûni lilmawla ltadjâ fanadjâ","bilmountaqâ fatanâʾâ koulla ghoummâti"]},{"a":["بِغَدَتْ نَارُ إِبْرَا يمَ بَارِدَةً","مَعَ السَّلَامِ وَهَذَا خَرْقُ عَادَاتِ"],"p":["bighadat nârou ʾibrâ yma bâridatan","maʿa ssalâmi wahadhâ kharqou ʿâdâti"]},{"a":["مِثْلُ انْشِقَاقِ سِنِمَّارٍ لِطَلْعَتِهِ","وَالضَّبُّ خَاطَبَهُ يَوْمًا بِكِلْمَاتِ"],"p":["mithlou anchiqâqi sinimmârin liṭalʿatihi","waḍḍabbou khâṭabahou yawman bikilmâti"]},{"a":["وَالْجِذْعُ قَدْ حَنَّ مِنْ شَوْقٍ وَمِنْ أَسَفٍ","حَنِينَ ثَكْلَى شَجَاهَا فَقْدُ أَمْوَاتِ"],"p":["waldjidhʿou qad hanna min chawqin wamin ʾasafin","hanîna thaklâ chadjâhâ faqdou ʾamwâti"]},{"a":["مِنَ الْخَوَارِقِ سَيْرُ السَّرْحِ مُسْرِعَةً","وَالذِّئْبُ كَلَّمَهُ يَوْمًا بِأَصْوَاتِ"],"p":["mina lkhawâriqi sayrou ssarhi mousriʿatan","wadhdhiʾbou kallamahou yawman biʾaçwâti"]},{"a":["مِنْهَا لَعَمْرِيَ إِسْرَاءُ الْإِلَهِ بِهِ","بِالرُّوحِ وَالْجِسْمِ لَيْلًا لِلسَّمَاوَاتِ"],"p":["minhâ laʿamriya ʾisrâʾou lʾilahi bihi","birroûhi waldjismi laylan lissamâwâti"]},{"a":["وَبَاتَ يَسْرِي وَجِبْرِيلٌ سَرَى مَعَهُ","فَوْقَ الْبُرَاقِ إِلَى أَقْصَى النِّهَايَاتِ"],"p":["wabâta yasrî wadjibrîloun sarâ maʿahou","fawqa lbourâqi ʾilâ ʾaqça nnihâyâti"]},{"a":["وَالْأَنْبِيَاءُ وَكُلُّ الْمُرْسَلِينَ مَعًا","تَعَلَّمُوا مِنْهُ آدَابَ الْعِبَادَاتِ"],"p":["wal anbiyâʾou wakoullou lmoursalîna maʿan","taʿallamoû minhou âdâba lʿibâdâti"]},{"a":["فَحَازَ مَا حَازَ مِنْ سِرٍّ يُخَصُّ بِهِ","وَقَدْ دَنَا فَتَدَلَّى بِالْمُنَاجَاةِ"],"p":["fahâza mâ hâza min sirrin youkhaççou bihi","waqad danâ fatadallâ bilmounâdjâti"]},{"a":["وَخَصَّهُ بِالَّذِي لَمْ يُحْظَ قَطُّ بِهِ","وَلَيْسَ يَحْظَى بِهِ مَاضٍ وَلَا آتِ"],"p":["wakhaççahou billadhî lam youhẓa qaṭṭou bihi","walaysa yahẓâ bihi mâḍin walâ âti"]},{"a":["فَآبَ فِي اللَّيْلِ قَبْلَ الْفَجْرِ يُعْلِمُ مَا","قَدْ كَانَ بِالشَّرْعِ ذَا نَفْيٍ أَوِ اثْبَاتِ"],"p":["faʾâba fi llayli qabla lfadjri youʿlimou mâ","qad kâna bichcharʿi dhâ nafyin ʾawi athbâti"]},{"a":["تِلْكَ الْخَوَارِقُ مَا زَالَتْ تُؤَيِّدُهُ","إِذْ لَمْ يَزَلْ خِلُّهُ يَأْتِي بِئَايَاتِ"],"p":["tilka lkhawâriqou mâ zâlat touʾayyidouhou","ʾidh lam yazal khillouhou yaʾtî biʾâyâti"]},{"a":["حَتَّى أَتَى بِكِتَابٍ أَعْجَزَ الْبُلَغَا","وَكَلَّ عَنْ مِثْلِهِ أَهْلُ الْفَصَاحَاتِ"],"p":["hattâ ʾatâ bikitâbin ʾaʿdjaza lboulaghâ","wakalla ʿan mithlihi ʾahlou lfaçâhâti"]},{"a":["أَكْرِمْ بِهِ مِنْ كِتَابٍ قَدْ شَفَى عِلَلًا","فَأَنْقَذَ الصَّحْبَ طُرًّا مِنْ غَبَاوَاتِ"],"p":["ʾakrim bihi min kitâbin qad chafâ ʿilalan","faʾanqadha ççahba ṭourran min ghabâwâti"]},{"a":["وَهْوَ الْكِتَابُ الَّذِي لَا رَيْبَ فِيهِ هُدًى","لِكُلِّ مَنْ يَتَّقِي نَارًا بِطَاعَاتِ"],"p":["wahwa lkitâbou lladhî lâ rayba fîhi houdanâ","likoulli man yattaqî nâran biṭâʿâti"]},{"a":["وَهْوَ الْهُدَى وَالصِّرَاطُ الْمُسْتَقِيمُ لَنَا","فَكُلُّ مَنْ عَافَهُ لَاقَى الشَّقَاوَاتِ"],"p":["wahwa lhoudâ waççirâṭou lmoustaqîmou lanâ","fakoullou man ʿâfahou lâqa chchaqâwâti"]},{"a":["وَهْوَ الشِّفَاءُ لِأَهْلِ الدَّاءِ كُلِّهِمُ","يُنْجِي ذَوِي الْعَقْلِ مِنْ غَيٍّ وَآفَاتِ"],"p":["wahwa chchifâʾou liʾahli ddâʾi koullihimou","youndjî dhawi lʿaqli min ghayyin waʾâfâti"]},{"a":["وَمَنْ يَرُمْ وُصْلَةً لِلَّهِ مُنْصَرِفًا","عَنْهُ فَقَدْ فَاتَهُ حَبْلُ الْوِصَالَاتِ"],"p":["waman yaroum wouçlatan lillâhi mounçarifan","ʿanhou faqad fâtahou hablou lwiçâlâti"]},{"a":["فَهْوَ السَّبِيلُ الَّذِي مَا فِيهِ مِنْ عِوَجٍ","لِمَنْ يَسِيرُ إِلَى مُعْطِي الرَّغِيبَاتِ"],"p":["fahwa ssabîlou lladhî mâ fîhi min ʿiwadjin","liman yasîrou ʾilâ mouʿṭi rraghîbâti"]},{"a":["أَمْرٌ وَنَهْيٌ وَوَعْدٌ وَالْوَعِيدُ مَعًا","قَدْ أُثْبِتَتْ فِيهِ إِرْشَادًا لِخَيْرَاتِ"],"p":["ʾamroun wanahyoun wawaʿdoun walwaʿîdou maʿan","qad ʾouthbitat fîhi ʾirchâdan likhayrâti"]},{"a":["فَمَنْ يُدِمْ قَصْدَ وَجْهِ اللَّهِ خِدْمَتَهُ","فَإِنَّهُ سَوْفَ يَحْظَى بِالْعَطِيَّاتِ"],"p":["faman youdim qaçda wadjhi llâhi khidmatahou","faʾinnahou sawfa yahẓâ bilʿaṭiyyâti"]},{"a":["وَمَنْ يَكُنْ فِي جَمِيعِ الدَّهْرِ مُعْتَصِمًا","بِهِ فَذَلِكَ مِنْ أَهْلِ الْوِلَايَاتِ"],"p":["waman yakoun fî djamîʿi ddahri mouʿtaçiman","bihi fadhalika min ʾahli lwilâyâti"]},{"a":["فَإِنَّهُ الْعُرْوَةُ الْوُثْقَى فَمُمْسِكُهَا","غَدًا يَفُوزُ لَدَى الْمَوْلَى بِجَنَّاتِ"],"p":["faʾinnahou lʿourwatou lwouthqâ famoumsikouhâ","ghadan yafoûzou lada lmawlâ bidjannâti"]},{"a":["وَمَنْ يُلَازِمْهُ فِي دُنْيَاهُ جَادَ لَهُ","يَوْمَ الْقِيَامَةِ بِالْبُشْرَى وَغِبْطَاتِ"],"p":["waman youlâzimhou fî dounyâhou djâda lahou","yawma lqiyâmati bilbouchrâ waghibṭâti"]},{"a":["وَمَنْ يُلَازِمْهُ يَتْلُ الدَّهْرَ نُسْخَتَهُ","مَعَ التَّدَبُّرِ يَظْفَرْ بِالسَّنِيَّاتِ"],"p":["waman youlâzimhou yatlou ddahra nouskhatahou","maʿa ttadabbouri yaẓfar bissaniyyâti"]},{"a":["وَمَنْ يَمِلْ عَنْهُ فِي الْأَوْقَاتِ مُعْتَزِلًا","فَإِنَّهُ صَدَّهُ كُثْرُ الرَّذِيلَاتِ"],"p":["waman yamil ʿanhou fi lʾawqâti mouʿtazilan","faʾinnahou çaddahou kouthrou rradhîlâti"]},{"a":["قَدْ صَدَّهُ عَنْهُ أَشْيَاءٌ تُعَدُّ إِلَى","سَبْعِ الرَّذَائِلِ آفَاتٍ دَسِيسَاتِ"],"p":["qad çaddahou ʿanhou ʾachyâʾoun touʿaddou ʾilâ","sabʿi rradhâʾili âfâtin dasîsâti"]},{"a":["ذَنْبٌ وَكِبْرٌ وَإِصْرَارٌ عَلَى لَعِبٍ","حُبٌّ لِدُنْيَا اعْتِمَادٌ لِلْخَلِيقَاتِ"],"p":["dhanboun wakibroun waʾiçrâroun ʿalâ laʿibin","houbboun lidounyâ aʿtimâdoun lilkhalîqâti"]},{"a":["كَذَاكَ ضُعْفُ يَقِينٍ وَهْوَ سَادِسُهَا","وَسَبَّعُوهَا بِتَكْثِيرِ ابْتِدَاعَاتِ"],"p":["kadhâka ḍouʿfou yaqînin wahwa sâdisouhâ","wasabbaʿoûhâ bitakthîri abtidâʿâti"]},{"a":["نِعْمَ الَّذِي جَاءَنَا مِنْ ذِي الْجَلَالِ بِهِ","وَقَادَنَا مِنْ غُرُورٍ لِلْفَضِيلَاتِ"],"p":["niʿma lladhî djâʾanâ min dhi ldjalâli bihi","waqâdanâ min ghouroûrin lilfaḍîlâti"]},{"a":["وَهْوَ الْمَلَاذُ لَنَا دُنْيَا وَآخِرَةً","فِي كُلِّ خَطْبٍ هُنَا أَوْ فِي غَدٍ يَاتِي"],"p":["wahwa lmalâdhou lanâ dounyâ waʾâkhiratan","fî koulli khaṭbin hounâ ʾaw fî ghadin yâtî"]},{"a":["مُنْجٍ مُجِيرٌ شَفِيعٌ نَاصِرٌ وَزَرٌ","عَنَّا يَكُفُّ الْبَلَايَا وَالْمُصِيبَاتِ"],"p":["moundjin moudjîroun chafîʿoun nâçiroun wazaroun","ʿannâ yakouffou lbalâyâ walmouçîbâti"]},{"a":["فَلَا أُفَوِّضُ أَمْرِي هَاهُنَا وَغَدًا","لِغَيْرِهِ بَعْدَ رَبِّي ذِي الْبَرِيَّاتِ"],"p":["falâ ʾoufawwiḍou ʾamrî hâhounâ waghadan","lighayrihi baʿda rabbî dhi lbariyyâti"]},{"a":["يَا أَكْرَمَ الْخَلْقِ إِنِّي خَادِمٌ لَكَ مَا","أَحْيَا بِمَدْحٍ وَذَبٍّ بِالْقَصِيدَاتِ"],"p":["yâ ʾakrama lkhalqi ʾinnî khâdimoun laka mâ","ʾahyâ bimadhin wadhabbin bilqaçîdâti"]},{"a":["وَلَمْ أُرِدْ زَهْرَةَ الدُّنْيَا الَّتِي اقْتَطَفَتْ","يَدَا زُهَيْرٍ بِمَا أَثْنَى مِنَ اَبْيَاتِ"],"p":["walam ʾourid zahrata ddounya llatî aqtaṭafat","yadâ zouhayrin bimâ ʾathnâ mina abyâti"]},{"a":["بَلِ امْتَدَحْتُكَ يَا مَوْلَايَ مُبْتَغِيًا","مِنْكَ الرِّضَى بَعْدَمَا تَمْحُو خَطِيئَاتِي"],"p":["bali amtadahtouka yâ mawlâya moubtaghiyan","minka rriḍâ baʿdamâ tamhoû khaṭîʾâtî"]},{"a":["عَلَيْكَ وَالْآلِ وَالْأَصْحَابِ خَيْرُ صَلَا","ةٍ بِسَلَامٍ بِهَا أَحْوِي الْمَزِيَّاتِ"],"p":["ʿalayka wal âli wal açhâbi khayrou çalâ","tin bisalâmin bihâ ʾahwi lmaziyyâti"]},{"a":["سُبْحَٰنَ رَبِّكَ رَبِّ الْعِزَّةِ عَمَّا يَصِفُونَ","وَسَلَٰمٌ عَلَى الْمُرْسَلِينَ"],"p":["soubhâna rabbika rabbi lʿizzati ʿammâ yaçifoûna","wasalâmoun ʿala lmoursalîna"]},{"a":["وَالْحَمْدُ لِلَّهِ رَبِّ الْعَٰلَمِينَ"],"p":["walhamdou lillâhi rabbi lʿâlamîna"]}]}