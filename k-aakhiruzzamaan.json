{"id":"aakhiruzzamaan","ar":"آخِرُ الزَّمَانِ","fr":"Aakhiruz Zamaan","lines":[{"a":["حَمْدًا لِّذِى الْجَلَالِ وَالْإِكْرَامِ","ثُمَّ صَلَاتُهُ مَعَ السَّلَامِ"],"p":["hamdan llidhi ldjalâli walʾikrâm","thoumma çalâtouhou maʿa ssalâm"]},{"a":["عَلَى الرَّسُولِ مُدَّةَ الْإِسْلَامِ","وَءَالِهِۦ وَصَحْبِهِۦ الْأَعْلَامِ"],"p":["ʿala rrasoûli mouddata lʾislâm","waʾâlihî waçahbihi lʾaʿlâm"]},{"a":["وَبَعْدُ فَهَاذِهِ وَصِيَّهْ","نَافِعَةً جَمِيلَةً صُوفِيَّهْ"],"p":["wabaʿdou fahâdhihi waçiyyah","nâfiʿatan djamîlatan çoûfiyyah"]},{"a":["لِجَمْعِهَآ أَوَامِرَ الرَّحْمَانِ","وَسُنَّةَ الرَّسُولِ ذِى الْفُرْقَانِ"],"p":["lidjamʿihâ awâmira rrahmân","wasounnata rrasoûli dhi lfourqân"]},{"a":["وَأَنَّهَا كَثِيرَةُ الْمَعَانِي","مَعْ أَنَّهَا قَلِيلَةُ الْمِيدَانِ"],"p":["waʾannahâ kathîratou lmaʿânî","maʿ annahâ qalîlatou lmîdân"]},{"a":["وَأَنَّهَا تُنْجِي مِنَ النِّيرَانِ","وَأَنَّهَا تُفْضِي إِلَى الْجِنَانِ"],"p":["waʾannahâ toundjî mina nnîrân","waʾannahâ toufḍî ila ldjinân"]},{"a":["وَأَنَّهَا دَافِعَةُ الْبَوَارِ","وَأَنَّهَا جَالِبَةُ الْأَنْوَارِ"],"p":["waʾannahâ dâfiʿatou lbawâr","waʾannahâ djâlibatou lʾanwâr"]},{"a":["إِذْ كُلُّ مَا فِيهَا مِنَ الْمَسَآئِلِ","وَمَا لَهَا أَيْضًا مِّنَ الدَّلَآئِلِ"],"p":["idh koullou mâ fîhâ mina lmasâʾil","wamâ lahâ ayḍan mmina ddalâʾil"]},{"a":["نَقَلْتُهَا عَنْ كُتُبِ الْأَحْبَارِ","السَّالِكِينَ مَسْلَكَ الْأَبْرَارِ"],"p":["naqaltouhâ ʿan koutoubi lʾahbâr","assâlikîna maslaka lʾabrâr"]},{"a":["مَضْمُونُهَآ أَوَامِرُ الرَّحْمَانِ","وَسُنَّةُ الرَّسُولِ ذِى الْبُرْهَانِ"],"p":["maḍmoûnouhâ awâmirou rrahmân","wasounnatou rrasoûli dhi lbourhân"]},{"a":["وَأَنَّهَا جَالِبَةُ الْمَرَامِ","لَهَا لِمَنْ مَّالَ مِنَ الْأَقْوَامِ"],"p":["waʾannahâ djâlibatou lmarâm","lahâ liman mmâla mina lʾaqwâm"]},{"a":["عَلَيْكُمُ بِطَاعَةِ الرَّحْمَانِ","يَاجُمْلَةَ الطُّلَابِ وَالْإِخْوَانِ"],"p":["ʿalaykoumou biṭâʿati rrahmân","yâdjoumlata ṭṭoulâbi walʾikhwân"]},{"a":["بَعْدَ تَعَلُّمٍ وَبِالْآدَابِ","وَكُلُّ ذِى يُنْجِى مِنَ الْعَذَابِ"],"p":["baʿda taʿalloumin wabilâdâb","wakoullou dhî youndjî mina lʿadhâb"]},{"a":["وَبَالتِّبَاعِ سُنَّةِ الرَّسُولِ","وَسُنَّةِ الصَّحَابَةِ الْعُدُولِ"],"p":["wabattibâʿi sounnati rrasoûl","wasounnati ççahâbati lʿoudoûl"]},{"a":["وَبِامْتِثَالِ أَمْرِ ذِى الْجَلَالِ","وَتَرْكِ نَهْيِهِ إِلَى الْمَآلِ"],"p":["wabimtithâli amri dhi ldjalâl","watarki nahyihi ila lmâl"]},{"a":["لَا تُشْرِكُوا بِاللَّهِ يَاإِخْوَانِي","لِأَنَّهُ يَهْدِى إِلَى النِّيرَانِ"],"p":["lâ touchrikoû billâhi yâʾikhwânî","liʾannahou yahdî ila nnîrân"]},{"a":["لَا تَقْتُلُوا النَّفْسَ بِغَيْرِ نَفْسِ","إِذْ نَهْيُهُ بَدَا بِغَيْرِ لَبْسِ"],"p":["lâ taqtoulou nnafsa bighayri nafs","idh nahyouhou badâ bighayri labs"]},{"a":["لَا تَقْرَبُوا الزِّنَى مَعَ الطُّغْيَانِ","وَمَالَ غَيْرِكُمْ مَعَ الْمَيْلَانِ"],"p":["lâ taqrabou zzinâ maʿa ṭṭoughyân","wamâla ghayrikoum maʿa lmaylân"]},{"a":["اجْتَنِبُوا الْغِيبَةَ وَالرِّيَاءَا","وَالسُّوءَ وَالْمُنْكَرَ وَالْفَحْشَاءَا"],"p":["idjtanibou lghîbata warriyâʾâ","wassoûʾa walmounkara walfahchâʾâ"]},{"a":["نَمِيمَةً كِذْبًا وَكِبْرِيَاءَ","رِيَاءً خِيَانَةً كَذَا الْمِرَاءَا"],"p":["namîmatan kidhban wakibriyâʾ","riyâʾan khiyânatan kadha lmirâʾâ"]},{"a":["وَرُؤْيَةُ الْفَضْلِ عَلَى الْأَغْيَارِ","صُحْبَةَ فَاسِقٍ بِلَا اضْطِرَارِ"],"p":["warouʾyatou lfaḍli ʿala lʾaghyâr","çouhbata fâsiqin bila ḍṭirâr"]},{"a":["تُوبُوا عَلَى الْفَوْرِ إِذَا أَذْنَبْتُمُ","دُومُوا عَلَى السُّكُوتِ إِنْ غَضِبْتُمُ"],"p":["toûboû ʿala lfawri idhâ adhnabtoum","doûmoû ʿala ssoukoûti in ghaḍibtoum"]},{"a":["دُومُوا عَلَى مَكَارِمِ الْأَخْلَاقِ","وَاجْتَنِبُوا جِدًّا عَلَى النِّفَاقِ"],"p":["doûmoû ʿalâ makârimi lʾakhlâq","wadjtaniboû djiddan ʿala nnifâq"]},{"a":["كُونُوا عَنِ الْكَلَامِ سَاكِتِينَا","كُونُوا إِلَى الْخَيْرَاتِ سَارِعِينَا"],"p":["koûnoû ʿani lkalâmi sâkitînâ","koûnoû ila lkhayrâti sâriʿînâ"]},{"a":["كُونُوا لَدَى الصَّلَاةِ نَاهِضِينَا","لِأَوَّلِ الْأَوْقَاتِ عَاجِلِينَا"],"p":["koûnoû lada ççalâti nâhiḍînâ","liʾawwali lʾawqâti ʿâdjilînâ"]},{"a":["وَلْتَحْفَظُوا الرَّأْسَ وَمَا حَوَاهُ","وَالْبَطْنَ مِثْلَهُ وَمَا وَالَاهُ"],"p":["waltahfaẓou rraʾsa wamâ hawâh","walbaṭna mithlahou wamâ wâlâh"]},{"a":["أَعْنِي بِهِۦ الْعَيْنَيْنِ وَالْأُذْنَيْنِ","وَالْفَرْجَ وَاللِّسَانَ وَالرِّجْلَيْنِ"],"p":["aʿnî bihi lʿaynayni walʾoudhnayn","walfardja wallisâna warridjlayn"]},{"a":["صَلُّوا عَلَى الرَّسُولِ ذِى الْغَمَامِ","وَسَلِّمُوا أَيْضًا مَدَى الْأَيَّامِ"],"p":["çalloû ʿala rrasoûli dhi lghamâm","wasallimoû ayḍan mada lʾayyâm"]},{"a":["دُومُوا عَلَى الْأَوْرَادِ وَالْأَذْكَارِ","فِي كُلِّ لَيْلَةٍ وَفِي النَّهَارِ"],"p":["doûmoû ʿala lʾawrâdi walʾadhkâr","fî koulli laylatin wafi nnahâr"]},{"a":["صُومُوا ثَلَاثَةً مِنَ الْأَيَّامِ","مِنْ كُلِّ مَا شَهْرٍ عَلَى الدَّوَامِ"],"p":["çoûmoû thalâthatan mina lʾayyâm","min koulli mâ chahrin ʿala ddawâm"]},{"a":["تُوبُوا إِلَى بَارِئِكُمْ مِنْ قَبْلِ أَنْ","جَآئَكُمُ الْمَمَاتُ مُدَّةَ الزَّمَنْ"],"p":["toûboû ilâ bâriʾikoum min qabli an","djâʾakoumou lmamâtou mouddata zzaman"]},{"a":["وَالضَّيْفَ أَكْرِمُوا إِذَآ أَتَاكُمُ","وَأَكْرِمُوا الْكَرِيمَ إِذْ وَافَاكُمُ"],"p":["waḍḍayfa akrimoû idhâ atâkoum","waʾakrimou lkarîma idh wâfâkoum"]},{"a":["عُودُوا مَرِيضَ مُسْلِمٍ لِلَّهِ","صُونُوا حَيَاتَكُمْ عَنِ الْمَلَاهِي"],"p":["ʿoûdoû marîḍa mouslimin lillâh","çoûnoû hayâtakoum ʿani lmalâhî"]},{"a":["مِيلُوا عَنِ الْمِزَاحِ وَالْفُضُولِ","لِلذِّكْرِ التَّسْبِيحِ وَالتَّهْلِيلِ"],"p":["mîloû ʿani lmizâhi walfouḍoûl","lidhdhikri ttasbîhi wattahlîl"]},{"a":["صَلُّوا بِلَيْلٍ أَطْعِمُوا الطَّعَامَا","أَفْشُوا السَّلَامَ وَصِلُوا الْأَرْحَامَا"],"p":["çalloû bilaylin aṭʿimou ṭṭaʿâmâ","afchou ssalâma waçilou lʾarhâmâ"]},{"a":["وَلَا تَكُونُوا مُتَمَاوِتِينَا","وَلَا تَكُونُوا مُتَعَائِبِينَا"],"p":["walâ takoûnoû moutamâwitînâ","walâ takoûnoû moutaʿâʾibînâ"]},{"a":["وَلَا تَقَاتِلُوا وَلَا تُدَابِرُوا","وَلَا تُبَاغِضُوا وَلَا تُنَافِرُوا"],"p":["walâ taqâtiloû walâ toudâbiroû","walâ toubâghiḍoû walâ tounâfiroû"]},{"a":["وَلَا طَعَّانِينَ وَلَا مَدَّاحِينَ","وَلَا تُسَابِبُوا وَلَا لَعَّانِينَ"],"p":["walâ ṭaʿʿânîna walâ maddâhîn","walâ tousâbiboû walâ laʿʿânîn"]},{"a":["وَلْتُبْجِلُوا الشُّيُوخَ وَالْكِبَارَا","وَلْتَرْحَمُوا الْأَيْتَامَ وَالصِّغَارَا"],"p":["waltoubdjilou chchouyoûkha walkibârâ","waltarhamou lʾaytâma waççighârâ"]},{"a":["وَلْتَبْذُلُوا الْفَقِيرَ وَالْمِسْكِينَا","وَلْتَنْصُرُوا الْعَدِيمَ وَالْمَدِينَا"],"p":["waltabdhoulou lfaqîra walmiskînâ","waltançourou lʿadîma walmadînâ"]},{"a":["رُدُّوا الْمَظَالِمَ إِلَى الْأَرْبَابِ","قَبْلَ حُضُورِكُمْ لَدَى الْحِسَابِ"],"p":["rouddou lmaẓâlima ila lʾarbâb","qabla houḍoûrikoum lada lhisâb"]},{"a":["كُونُوا عَلَى الْبَلَآءِ صَابِرِينَا","وَنِعْمَةَ الْإِلَاهِ شَاكِرِينَا"],"p":["koûnoû ʿala lbalâʾi çâbirînâ","waniʿmata lʾilâhi châkirînâ"]},{"a":["وَجْتَنِبُوا الْحَسَدَ وَالْبَغْضَآءَا","سُخْرِيَّةً وَالْفَخْرَ وَالشَّحْنَآءَا"],"p":["wadjtanibou lhasada walbaghḍâʾâ","soukhriyyatan walfakhra wachchahnâʾâ"]},{"a":["وَأَوْقِعُوا الصَّلَاةَ فِي الْجَمَاعَهْ","نِلْتُمْ كَرَامَةً مَّعَ الشَّفَاعَهْ"],"p":["waʾawqiʿou ççalâta fi ldjamâʿah","niltoum karâmatan mmaʿa chchafâʿah"]},{"a":["دُومُوا عَلَى قَوَاعِدِ الْإِسْلَامِ","نِلْتُمْ سَلَامَةً لَّدَى الْقِيَامِ"],"p":["doûmoû ʿalâ qawâʿidi lʾislâm","niltoum salâmatan llada lqiyâm"]},{"a":["أَوَّلُهَا التَّوْحِيدُ وَالصَّلَاةُ","وَالْحَجُّ وَالصِّيَامُ وَالزَّكَاةُ"],"p":["awwalouha ttawhîdou waççalâh","walhadjdjou waççiyâmou wazzakâh"]},{"a":["لَا تَنْظُرُوا إِلَى عُيُوبِ النَّاسِ","لِأَنَّهُ عَلَامَةُ الْإِفْلَاسِ"],"p":["lâ tanẓouroû ilâ ʿouyoûbi nnâs","liʾannahou ʿalâmatou lʾiflâs"]},{"a":["نَقُّوا ثِيَابَكُمْ عَنِ الْأَدْنَاسِ","لِأَنَّهُ مِنْ فِعْلَةِ الْأَكْيَاسِ"],"p":["naqqoû thiyâbakoum ʿani lʾadnâs","liʾannahou min fiʿlati lʾakyâs"]},{"a":["دُومُوا أَيَاقَوْمِي عَلَى الطَّهَارَهْ","وَالرِّجْزَ فَاهْجُرُوا مَعَ الْغَذَارَهْ"],"p":["doûmoû ayâqawmî ʿala ṭṭahârah","warridjza fahdjouroû maʿa lghadhârah"]},{"a":["دُومُوا أَيَاقَوْمِي عَلَى الْبُرُورِ","لِلْوَالِدَيْنِ جُمْلَةَ الدُّهُورِ"],"p":["doûmoû ayâqawmî ʿala lbouroûr","lilwâlidayni djoumlata ddouhoûr"]},{"a":["فَلْتَعْلَمُوا يَاجُمْلَةَ الْإِخْوَانِ","بِأَنَّكُمْ فِي ءَاخِرِ الزَّمَانِ"],"p":["faltaʿlamoû yâdjoumlata lʾikhwân","biʾannakoum fî âkhiri zzamân"]},{"a":["قَدْ ظَهَرَتْ عَلَامَةُ الْقِيَامَهْ","لِكُلِّ عَاقِلٍ فَعِ الْعَلَامَهْ"],"p":["qad ẓaharat ʿalâmatou lqiyâmah","likoulli ʿâqilin faʿi lʿalâmah"]},{"a":["هَاذَا الزَّمَانُ أَقْبَحُ الزَّمَانِ","لِكَثْرَةِ الْعِصْيَانِ فِي الْبُلْدَانِ"],"p":["hâdha zzamânou aqbahou zzamân","likathrati lʿiçyâni fi lbouldân"]},{"a":["وَكَثْرَةِ الْأَمْرَاضِ وَالْأَسْقَامِ","وَكَثْرَةِ الْمَوْتِ عَلَى الْأَقْوَامِ"],"p":["wakathrati lʾamrâḍi walʾasqâm","wakathrati lmawti ʿala lʾaqwâm"]},{"a":["وَكَثْرَةِ الْجَهْلِ مَعَ الْخِيَانَهْ","وَقِلَّةِ الْوَفَآءِ لِلْأَمَانَهْ"],"p":["wakathrati ldjahli maʿa lkhiyânah","waqillati lwafâʾi lilʾamânah"]},{"a":["وَقِلَّةِ الْحَيَآءِ فِي النِّسْوَانِ","وَقِلَّةِ الْحَيَآءِ فِي الصِّبْيَانِ"],"p":["waqillati lhayâʾi fi nniswân","waqillati lhayâʾi fi ççibyân"]},{"a":["وَقِلَّةِ الْأَخْيَارِ وَالْأَبْرَارِ","وَكَثْرَةِ النِّفَاقِ وَالْفُجَّارِ"],"p":["waqillati lʾakhyâri walʾabrâr","wakathrati nnifâqi walfoudjdjâr"]},{"a":["تَعْظِيمُ ذِي مَالٍ وَتَحْقِيرُ الْعَلِيمْ","تَقْدِيمُ جَاهِلٍ وَتَاخِيرُ الْعَلِيمْ"],"p":["taʿẓîmou dhî mâlin watahqîrou lʿalîm","taqdîmou djâhilin watâkhîrou lʿalîm"]},{"a":["هَاذَ الزَّمَانُ زَمَنُ السُّكُوتِ","وَزَمَنُ اللُّزُومِ لِلْبُيُوتِ"],"p":["hâdha zzamânou zamanou ssoukoût","wazamanou llouzoûmi lilbouyoût"]},{"a":["وَزَمَنُ الرِّضَا بِدُونِ الْغُوتِ","وَزَمَنُ الزُّهْدِ مَعَ الصُّمُوتِ"],"p":["wazamanou rriḍâ bidoûni lghoût","wazamanou zzouhdi maʿa ççoumoût"]},{"a":["وَزَمَنُ الْعُزْلَةِ وَالْفِرَارِ","إِلَى الْجِبَالِ وَإِلَى الصَّحَارِى"],"p":["wazamanou lʿouzlati walfirâr","ila ldjibâli waʾila ççahârî"]},{"a":["وَمَيْلُ جُلِّ النَّاسِ لِلنَّصْرَانِ","وَيْلٌ لِّمَنْ مَّالَ إِلَى النَّصْرَانِ"],"p":["wamaylou djoulli nnâsi linnaçrân","wayloun lliman mmâla ila nnaçrân"]},{"a":["لَعْنَةُ رَبِّنَا عَلَى النَّصَارَى","بِجَاهِ مَنْ حَجَّ وَمَنْ قَدْ زَارَا"],"p":["laʿnatou rabbinâ ʿala nnaçârâ","bidjâhi man hadjdja waman qad zârâ"]},{"a":["لَعْنَةُ رَبِّنَا عَلَى الْيَهُودِ","بِجَاهِ نُوحٍ صَالِحٍ وَهُودِ"],"p":["laʿnatou rabbinâ ʿala lyahoûd","bidjâhi noûhin çâlihin wahoûd"]},{"a":["لَعْنَةُ رَبِّنَا عَلَى الْمَجُوسِ","بِجَاهِ جَدِّ شَيْخِنَا السَّنُوسِي"],"p":["laʿnatou rabbinâ ʿala lmadjoûs","bidjâhi djaddi chaykhina ssanoûsî"]},{"a":["لَعْنَةُ رَبِّنَا عَلَى الْكُفَّارِ","بِحُرْمَةِ الرَّسُولِ ذِى الْأَنْوَارِ"],"p":["laʿnatou rabbinâ ʿala lkouffâr","bihourmati rrasoûli dhi lʾanwâr"]},{"a":["وَيْلٌ لِّمَنْ مَّالَ إِلَى الْكُفَّارِ","لِكَوْنِهِ صَارَ إِلَى الْبَوَارِ"],"p":["wayloun lliman mmâla ila lkouffâr","likawnihi çâra ila lbawâr"]},{"a":["وَيْلٌ لِّمَنْ مَّاجَ إِلَى الْأَعْدَآءِ","لِكَوْنِهِ صَارَ إِلَى الْبَلَآءِ"],"p":["wayloun lliman mmâdja ila lʾaʿdâʾ","likawnihi çâra ila lbalâʾ"]},{"a":["الْوَيْلُ كُلُّ الْوَيْلِ لِلنَّصَارَى","مَسْكَنُهُمْ إِلَى الْجَحِيمِ صَارَا"],"p":["alwaylou koullou lwayli linnaçârâ","maskanouhoum ila ldjahîmi çârâ"]},{"a":["إِنَّ الَّذِى قَدْ سَارَ لِلْكُفَّارِ","وَلَمْ يَكُونْ ذَاكَ بِالْإِضْطِرَارِ"],"p":["inna lladhî qad sâra lilkouffâr","walam yakoûn dhâka bilʾiḍṭirâr"]},{"a":["لِطَلَبِ الْجَاهِ أَوِ الْأَمْوَالِ","أَوْ طَلَبِ النُّصْرَةِ وَالنَّوَالِ"],"p":["liṭalabi ldjâhi awi lʾamwâl","aw ṭalabi nnouçrati wannawâl"]},{"a":["فَذَاكَ مُذْمُومٌ لَّدَى الْإِلَاهِ","مَعَ رَسُولِهِ بِلَا اشْتِبَاهِ"],"p":["fadhâka moudhmoûmoun llada lʾilâh","maʿa rasoûlihi bila chtibâh"]},{"a":["فَلْتَحْذَرُوا الْكُفَّارَ وَالْأَعْدَاءَا","النَّفْسَ وَالشَّيْطَانَ وَالْهَوَآءَا"],"p":["faltahdharou lkouffâra walʾaʿdâʾâ","annafsa wachchayṭâna walhawâʾâ"]},{"a":["وَاجْتَنِبُوا جِدًّا عَلَى ابْتِدَاعِ","دُومُوا مَدَى الدُّهُورِ بِاتِّبَاعِ"],"p":["wadjtaniboû djiddan ʿala btidâʿ","doûmoû mada ddouhoûri bittibâʿ"]},{"a":["وَبِاتِّبَاعِ سُنَّةِ الرَّسُولِ","وَبِابْتِدَاعِ سُنَّةِ الْجُهُولِ"],"p":["wabittibâʿi sounnati rrasoûl","wabibtidâʿi sounnati ldjouhoûl"]},{"a":["فَلْتُمْسِكُوا بِسُنَّةِ الْمُخْتَارِ","وَسُنَّةِ الصَّحَابَةِ الْأَخْيَارِ"],"p":["faltoumsikoû bisounnati lmoukhtâr","wasounnati ççahâbati lʾakhyâr"]},{"a":["وَهَاهُنَا قَدْ تَمَّتِ الْوَصِيَّهْ","شَامِخَةً جَمِيلَةً سَنِيَّهْ"],"p":["wahâhounâ qad tammati lwaçiyyah","châmikhatan djamîlatan saniyyah"]},{"a":["فَاسْتَعْمِلُوا بِهَا أَيَا إِخْوَانِ","نِلْتُمْ سَلَامَةً مَعَ الرِّضْوَانِ"],"p":["fastaʿmiloû bihâ ayâ ikhwân","niltoum salâmatan maʿa rriḍwân"]},{"a":["وَالْحَمْدُ لِلَّهِ عَلَى التَّمَامِ","ثُمَّ السَّلَامَانِ مَدَى الْأَيَّامِ"],"p":["walhamdou lillâhi ʿala ttamâm","thoumma ssalâmâni mada lʾayyâm"]},{"a":["عَلَى الرَّسُولِ صَاحِبِ الْغَمَامِ","وَءَالِهِۦ وَصَحْبِهِۦ الْأَعْلَامِ"],"p":["ʿala rrasoûli çâhibi lghamâm","waʾâlihî waçahbihi lʾaʿlâm"]},{"a":["وَالْمُقْتَدِ بِهِمْ مِنَ الْإِخْوَانِ","مَادَامَتِ الْوَرَقُ مِنَ الْأَغْصَانِ"],"p":["walmouqtadi bihim mina lʾikhwân","mâdâmati lwaraqou mina lʾaghçân"]}]}