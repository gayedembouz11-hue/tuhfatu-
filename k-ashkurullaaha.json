{"id":"ashkurullaaha","ar":"أَشْكُرُ اللَّهَ","fr":"Ashkurul Laaha","lines":[{"a":["أَشْكُرُ اللَّهَ ذَا الْوَرَى بِانْتِفَاعِ","بِكِتَابٍ سَاقَ الْعِدَى بِانْدِفَاعِ"],"p":["ashkourou llâha dhâ lwarâ bintifâʿi","bikitâbin sâqa lʿidâ bindifâʿi"]},{"a":["لَمْ يَمِلْ كَلْكَلِى لِغَيْرِ إِلَاهِى","وَلِرَبِّى قَوْلِى انْتَحَى وَسَمَاعِ"],"p":["lam yamil kalkalî lighayri ilâhî","walirabbî qawlî ntahâ wasamâʿi"]},{"a":["لَمْ يَلِجْ فِى الْفُؤَادِ مِنِّى ارْتِيَابٌ","فِى الَّذِى اللَّهُ قَادَ لِى ذَا اجْتِمَاعِ"],"p":["lam yadjil fî lfouʾâdi minnî rtiyâboun","fî lladhî llâhou qâda lî dhâ djtimâʿi"]},{"a":["أَذْهَبَ ذِكْرُ مَالِكِى كُلَّ شَكٍّ","وَلِغَيْرِى ذَبَّ الْعِدَى بِانْقِمَاعِ"],"p":["adhhaba dhikrou mâlikî koulla chakkin","walighayrî dhabba lʿidâ binqimâʿi"]},{"a":["هَدَّدَ اللَّهُ مَنْ قَلَانِى بَعِيدًا","لِّسَوَى جَانِبِى بِغَيْرِ اسْتِمَاعِ"],"p":["haddada llâhou man qalânî baʿîdan","lisiwâ djânibî bighayri stimâʿi"]},{"a":["تَشْكُرُ اللَّهَ لِلْجِنَانِ حَيَاتِى","بِكِتَابٍ بَدَا بِهِۦ لِى انْتِفَاعِ"],"p":["tachkourou llâha lildjinâni hayâtî","bikitâbin badâ bihî lî ntifâʿi"]},{"a":["عَلِمَ الْقَلْبُ أَنَّ خَيْرَ الْبَرَايَا","جَآءَهُ الْوَحْىُ بِالْأَمِينِ الْمُطَاعِ"],"p":["ʿalima lqalbou anna khayra lbarâyâ","djâʾahou lwahyou bilamîni lmouṭâʿi"]},{"a":["أَحَدِيثَ النَّبِىِّ إِنَّكَ حَقٌّ","لَكَ خَطَّى نَحَا بِأَمْرٍ مُّطَاعِ"],"p":["ahadîtha nnabiyyi innaka haqqoun","laka khaṭṭî nahâ biʾamrin mouṭâʿi"]},{"a":["لَكَ أَنْحُو بِمِرْقَمِى وَمِدَادِى","لَسْتُ أَنْفَكُّ بِالرِّضَآءِ بِطَاعِ"],"p":["laka anhoû bimirqamî wamidâdî","lastou anfakkou birridâʾi biṭâʿi"]},{"a":["أَنْتَ خَلِّى مَعَ الْكِتَابِ وَحِبِّى","كُنْتَ لِى بِالْقِطَاعِ بَعْدَ الْقِطَاعِ"],"p":["anta khillî maʿa lkitâbi wahibbî","kounta lî bilqiṭâʿi baʿda lqiṭâʿi"]},{"a":["بِكَ تَنْمُو مَسَرَّتِى لِجَنَانٍ","صَافِيَاتٍ بِلَا انْتِهَا وَقِطَاعِ"],"p":["bika tanmoû masarratî lidjanânin","çâfiyâtin bilâ ntihâ waqiṭâʿi"]},{"a":["هَرَبَتْ مِنْ غَيْرِ انْثِنَآءٍ لِنَحْوِى","مَنْ قَلَوْنِى مِنَ الْوَرَى بِانْقِطَاعِ"],"p":["harabat min ghayri nthinâʾin linahwî","man qalawnî mina lwarâ binqiṭâʿi"]}]}