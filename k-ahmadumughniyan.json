{"id":"ahmadumughniyan","ar":"أَحْمَدُ مُغْنِيًا","fr":"Ahmadu Mughniyan","lines":[{"a":["أَحْمَدُ مُغْنِيًا تَعَالَى عَنْ سِنَهْ","وَكَانَ لِي بِكُلِّ شَهْرٍ وَسَنَهْ"],"p":["ahmadou moughniyan taʿâlâ ʿan sinah","wakâna lî bikoulli chahrin wasanah"]},{"a":["خَاطَبْتُهُ فِي الْبَرِّ وَالْبَحْرِ وَفِي","السِّرِّ وَالْجَهْرِ مَعَ الْهَادِي الْوَفِي"],"p":["khâṭabtouhou fi lbarri walbahri wafî","assirri waldjahri maʿa lhâdi lwafî"]},{"a":["فَقُلْتُ يَارَبَّ الْوَرَى يَارَبَّنَا","يَارَبَّنَا يَارَبَّنَا يَارَبَّنَا"],"p":["faqoultou yâ rabba lwarâ yâ rabbanâ","yâ rabbanâ yâ rabbanâ yâ rabbanâ"]},{"a":["يَارَبَّنَا صَلِّ صَلَاةً فَآئِقَهْ","كُلَّ صَلَاةٍ بِرَئِيسٍ لَّآئِقَهْ"],"p":["yâ rabbanâ çalli çalâtan fâʾiqah","koulla çalâtin biraʾîsin llâʾiqah"]},{"a":["مَعَ سَلَامٍ لَّا يُجَارِيهِ سَلَامْ","عَلَى وَسِيلَتِي لَكَ الْمَاحِي الْمَلَامْ"],"p":["maʿa salâmin llâ youdjârîhi salâm","ʿalâ wasîlatî laka lmâhi lmalâm"]},{"a":["سَيِّدِنَا مُحَمَّدٍ وَالْآلِ","وَصَحْبِهِ فِي الْحَالِ وَالْمَئَالِ"],"p":["sayyidinâ mouhammadin walâl","waçahbihi fi lhâli walmaʾâl"]},{"a":["وَاكْتُبْ لَهُ الْيَوْمَ بُشَارَاتِ الْكَرِيمْ","لَدَيْكَ يَابَاقِي مَزِيدٌ لَّا يَرِيمْ"],"p":["waktoub lahou lyawma bouchârâti lkarîm","ladayka yâ bâqî mazîdoun llâ yarîm"]},{"a":["يَارَبَّنَا صَلِّ صَلَاةً بَارِعَهْ","مَعَ سَلَامٍ بِالْمُنَى مُسَارِعَهْ"],"p":["yâ rabbanâ çalli çalâtan bâriʿah","maʿa salâmin bilmounâ mousâriʿah"]},{"a":["عَلَى الَّذِى أَعْطَيْتُهُ مِدَادِي","مُذْ زَمَنٍ مَّعْ صَفَا وِدَادِي"],"p":["ʿala lladhî aʿṭaytouhou midâdî","moudh zamanin mmaʿ çafâ widâdî"]},{"a":["سَيِّدِنَا مُحَمَّدٍ وَالْآلِ","وَصَحْبِهِ فِي الْحَالِ وَالْمَئَالِ"],"p":["sayyidinâ mouhammadin walâl","waçahbihi fi lhâli walmaʾâl"]},{"a":["وَمِنْ مِدَادِي قُدْ لَهُ مَاشَآءَا","يَامَنْ لَّهُ أُوَجِّهُ الْإِنْشَآءَا"],"p":["wamin midâdî qoud lahou mâchâʾâ","yâ man llahou ouwadjdjihou linchâʾâ"]},{"a":["يَارَبَّنَا صَلِّ صَلَاةً طَاهِرَهْ","مَعَ سَلَامٍ لِّي عِدَاكَ قَاهِرَهْ"],"p":["yâ rabbanâ çalli çalâtan ṭâhirah","maʿa salâmin llî ʿidâka qâhirah"]},{"a":["عَلَى الَّذِى أَعْطَيْتُهُ أَقْلَامِي","مُذْ زَمَنٍ بِأَقِيدِ الْكَلَامِ"],"p":["ʿala lladhî aʿṭaytouhou aqlâmî","moudh zamanin biʾaqîdi lkalâm"]},{"a":["سَيِّدِنَا مُحَمَّدٍ وَالْآلِ","وَصَحْبِهِ فِي الْحَالِ وَالْمَئَالِ"],"p":["sayyidinâ mouhammadin walâl","waçahbihi fi lhâli walmaʾâl"]},{"a":["وَمِنْ قِلَامِي قُدْ لَّهُ تَبْشِيرَا","يَامَنْ لَّنَآ أَرْسَلْتَهُ بَشِيرَا"],"p":["wamin qilâmî qoud llahou tabchîrâ","yâ man llanâ arsaltahou bachîrâ"]},{"a":["يَارَبَّنَا صَلِّ صَلَاةً نَآئِرَهْ","مَعَ سَلَامٍ بِرِضَاكَ زَآئِرَهْ"],"p":["yâ rabbanâ çalli çalâtan nâʾirah","maʿa salâmin biriḍâka zâʾirah"]},{"a":["عَلَى الَّذِى أَعْطَيْتُهُ قِرْطَاسِي","بِخِدَمٍ ضُمَّتْ إِلَى أَوْطَاسِي"],"p":["ʿala lladhî aʿṭaytouhou qirṭâsî","bikhidamin ḍoummat ilâ awṭâsî"]},{"a":["سَيِّدِنَا مُحَمَّدٍ وَالْآلِ","وَصَحْبِهِ فِي الْحَالِ وَالْمَئَالِ"],"p":["sayyidinâ mouhammadin walâl","waçahbihi fi lhâli walmaʾâl"]},{"a":["وَمِنْ قَرَاطِيسِي لَهُ قُدِ الْغَرَضْ","يَامَنْ كَفَانِي عِدَاكَ وَالْمَرَضْ"],"p":["wamin qarâṭîsî lahou qoudi lgharaḍ","yâ man kafânî ʿidâka walmaraḍ"]},{"a":["يَارَبَّنَا صَلِّ صَلَاةً رَاقِيَهْ","مَعَ سَلَامٍ بِالْمَرَاضِي بَاقِيَهْ"],"p":["yâ rabbanâ çalli çalâtan râqiyah","maʿa salâmin bilmarâḍî bâqiyah"]},{"a":["عَلَى الَّذِى جِدْمَتُهُ قَدْ أَخْرَجَتْ","مِنِّي عُيُوبِي مَعًا فَخَرَجَتْ"],"p":["ʿala lladhî djidmatouhou qad akhradjat","minnî ʿouyoûbî maʿan fakharadjat"]},{"a":["سَيِّدِنَا مُحَمَّدٍ وَالْآلِ","وَصَحْبِهِ فِي الْحَالِ وَالْمَئَالِ"],"p":["sayyidinâ mouhammadin walâl","waçahbihi fi lhâli walmaʾâl"]},{"a":["وَقُدْ لَهُ مِنْ خِدَمِي سُرُورَا","يَاوَاهِبًا وَهَبْ لِي بُرُورَا"],"p":["waqoud lahou min khidamî souroûrâ","yâ wâhiban wahab lî bouroûrâ"]},{"a":["يَارَبَّنَا صَلِّ صَلَاةً مُشْكِيَهْ","كُلَّ اشْتِكَآءٍ مَّعْ سَلَامٍ مُّرْضِيَهْ"],"p":["yâ rabbanâ çalli çalâtan mouchkiyah","koulla chtikâʾin mmaʿ salâmin mmourḍiyah"]},{"a":["عَلَى الَّذِى أَرْضَيْتُهُ سِنِينَا","مُجَاهِدًا مُغْتَرِبًا ظَنِينَا"],"p":["ʿala lladhî arḍaytouhou sinînâ","moudjâhidan moughtariban ẓanînâ"]},{"a":["سَيِّدِنَا مُحَمَّدٍ وَالْآلِ","وَصَحْبِهِ فِي الْحَالِ وَالْمَئَالِ"],"p":["sayyidinâ mouhammadin walâl","waçahbihi fi lhâli walmaʾâl"]},{"a":["وَقُدْ لَهُ مِنْ خِدَمِي مَاسَرَّا","يَامَنْ كَفَانِي مَنْ وَّشَى وَاغْتَرَّا"],"p":["waqoud lahou min khidamî mâsarrâ","yâ man kafânî man wwachâ waghtarrâ"]},{"a":["وَاعْصِمْ بِوَجْهِكَ الْكَرِيمِ عُمْرِي","مِنَ الْمَكَارِهِ وَأَصْلِحْ أَمْرِي"],"p":["waʿçim biwadjhika lkarîmi ʿoumrî","mina lmakârihi waʾaçlih amrî"]},{"a":["وَاجْعَلْ فُؤَادِي خَزِينَةَ الْعُلُومْ","النَّافِعَاتِ إِنَّكَ الْمُعْطِي الْعَلِيمْ"],"p":["wadjʿal fouʾâdî khazînata lʿouloûm","annâfiʿâti innaka lmouʿṭi lʿalîm"]},{"a":["وَاجْعَلْ جَوَارِحِي أَوْطَانَ هُدَاكْ","إِلَى الْجِنَانِ سَالِمَاتٍ مِّنْ عِدَاكْ"],"p":["wadjʿal djawârihî awṭâna houdâk","ila ldjinâni sâlimâtin mmin ʿidâk"]},{"a":["يَارَبَّنَا صَلِّ صَلَاةً جَالِبَهْ","إِلَى رِضَاكَ لِعِدَاكَ غَالِبَهْ"],"p":["yâ rabbanâ çalli çalâtan djâlibah","ilâ riḍâka liʿidâka ghâlibah"]},{"a":["عَلَى الَّذِى جَعَلَنِي لَدَيْهِ","كَصَحْبِهِ مُصَلِّيًا عَلَيْهِ"],"p":["ʿala lladhî djaʿalanî ladayh","kaçahbihi mouçalliyan ʿalayh"]},{"a":["سَيِّدِنَا مُحَمَّدٍ وَالْآلِ","وَصَحْبِهِ فِي الْحَالِ وَالْمَئَالِ"],"p":["sayyidinâ mouhammadin walâl","waçahbihi fi lhâli walmaʾâl"]},{"a":["وَقُدْ لَهُ مِنْ عُمُرِي فَوْقَ الْمُنَى","وَعِنْدَكَ اجْعَلْنِي سُرُورَ الْأُمَنَا"],"p":["waqoud lahou min ʿoumourî fawqa lmounâ","waʿindaka djʿalnî souroûra loumanâ"]},{"a":["يَارَبَّنَا صَلِّ صَلَاةً شَامِلَهْ","لِلصَّلَوَاتِ كُلِّهِنَّ كَامِلَهْ"],"p":["yâ rabbanâ çalli çalâtan châmilah","liççalawâti koullihinna kâmilah"]},{"a":["مَعَ سَلَامٍ لَّا يَزَالُ نَامِيَا","مِمَّا يَضُرُّنِي جِهَاتِي حَامِيَا"],"p":["maʿa salâmin llâ yazâlou nâmiyâ","mimmâ yaḍourrounî djihâtî hâmiyâ"]},{"a":["عَلَى خَلِيلِكَ الْحَبِيبِ عَبْدِكَا","أَحْمَدِنَا الْمُخْتَارِ نُورِ جُنْدِكَا"],"p":["ʿalâ khalîlika lhabîbi ʿabdikâ","ahmadina lmoukhtâri noûri djoundikâ"]},{"a":["وَءَالِهِ وَصَحْبِهِ وَلْتَجْعَلِ","جَمِيعَ خِدْمَتِي رِضًى تَنْجَعِلِ"],"p":["waʾâlihi waçahbihi waltadjʿal","djamîʿa khidmatî riḍan tandjaʿil"]},{"a":["يَارَبَّنَا صَلِّ صَلَاةً جَامِعَهْ","كُلَّ صَلَاةٍ ذَاتِ قَهْرٍ قَامِعَهْ"],"p":["yâ rabbanâ çalli çalâtan djâmiʿah","koulla çalâtin dhâti qahrin qâmiʿah"]},{"a":["مَعَ سَلَامٍ نُّورُهُ لَا يَنْقَطِعْ","عَلَى الَّذِى بِهِ أَذَاى مُنْقَطِعْ"],"p":["maʿa salâmin nnoûrouhou lâ yanqaṭiʿ","ʿala lladhî bihi adhâ mounqaṭiʿ"]},{"a":["سَيِّدِنَا مُحَمَّدٍ وَالْآلِ","وَصَحْبِهِ فِي الْحَالِ وَالْمَئَالِ"],"p":["sayyidinâ mouhammadin walâl","waçahbihi fi lhâli walmaʾâl"]},{"a":["وَارْفَعْ جَمِيعَ صَلَوَاتِي الْيَوْمَا","لَكَ وَجَنِّبْنِي الْعِدَى وَاللَّوْمَا"],"p":["warfaʿ djamîʿa çalawâti lyawmâ","laka wadjannibni lʿidâ wallawmâ"]},{"a":["يَارَبَّنَا صَلِّ صَلَاةً حَآئِلَهْ","بَيْنِي وَبَيْنَ كَدَرَاتٍ جَآئِلَهْ"],"p":["yâ rabbanâ çalli çalâtan hâʾilah","baynî wabayna kadarâtin djâʾilah"]},{"a":["مَعَ سَلَامٍ جَالِبٍ لِّي مَآ أُحِبْ","مُزَحْزِحًا لِّغَيْرِنَا مَالَا نُحِبْ"],"p":["maʿa salâmin djâlibin llî mâ ouhib","mouzahzihan llighayrinâ mâlâ nouhib"]},{"a":["عَلَى وَسِيلَتِي إِلَيْكَ أَحْمَدَا","وَالْءَالِ وَالصَّحْبِ وَعُمْرِي احْمَدَا"],"p":["ʿalâ wasîlatî ilayka ahmadâ","walâli waççahbi waʿoumri hmadâ"]},{"a":["يَارَبَّنَا صَلِّ صَلَاةً ذَاهِبَهْ","بِكُلِّ ضُرٍّ مَّعْ سَلَامٍ ذَاهِبَهْ"],"p":["yâ rabbanâ çalli çalâtan dhâhibah","bikoulli ḍourrin mmaʿ salâmin dhâhibah"]},{"a":["لَنَا سَعَادَةً وَرِبْحًا وَسَعَهْ","يَامُغْنِيًا قَدْ كُنْتَ لِي بِتَوْسِعَهْ"],"p":["lanâ saʿâdatan waribhan wasaʿah","yâ moughniyan qad kounta lî bitawsiʿah"]},{"a":["عَلَى الَّذِى بِهِ تَقُودُ لِي الْغَرَضْ","بِلَا عِدًى وَلَآ أَذًى وَلَا مَرَضْ"],"p":["ʿala lladhî bihi taqoûdou li lgharaḍ","bilâ ʿidan walâ adhan walâ maraḍ"]},{"a":["سَيِّدِنَا مُحَمَّدٍ وَالْآلِ","وَصَحْبِهِ فِي الْحَالِ وَالْمَئَالِ"],"p":["sayyidinâ mouhammadin walâl","waçahbihi fi lhâli walmaʾâl"]},{"a":["يَارَبَّنَا يَامَنْ تَعَالَى عَنْ سِنَهْ","عَنِّيَ صَلِّ كُلَّ شَهْرٍ وَسَنَهْ"],"p":["yâ rabbanâ yâ man taʿâlâ ʿan sinah","ʿanniya çalli koulla chahrin wasanah"]},{"a":["مَعَ سَلَامِكَ عَلَى الْمُشَفَّعِ","مَنْ قَادَ لِي مُخْجِلَ كُلِّ مِدْفَعِ"],"p":["maʿa salâmika ʿala lmouchaffaʿ","man qâda lî moukhdjila koulli midfaʿ"]},{"a":["سَيِّدِنَا مُحَمَّدٍ وَالْآلِ","وَصَحْبِهِ فِي الْحَالِ وَالْمَئَالِ"],"p":["sayyidinâ mouhammadin walâl","waçahbihi fi lhâli walmaʾâl"]},{"a":["وَاكْتُبْ لَهُ فِي كُلِّ مَا مِنِّي صَدَرْ","مِنْ خِدَمٍ حَلَاوَةً بِلَا كَدَرْ"],"p":["waktoub lahou fî koulli mâ minnî çadar","min khidamin halâwatan bilâ kadar"]},{"a":["وَجْعَلْ صَلَاتِي وَسَلَامِي خَيْرَا","عِبَادَةً لَّكَ تُصَفِّي مِيرَا"],"p":["wadjʿal çalâtî wasalâmî khayrâ","ʿibâdatan llaka touçaffî mîrâ"]},{"a":["وَاجْعَلْ حَيَاتِي عِبَادَةً تَدُومْ","لَهُ بُشَارَاتٍ تُقَدِّمُ الْخَدِيمْ"],"p":["wadjʿal hayâtî ʿibâdatan tadoûm","lahou bouchârâtin touqaddimou lkhadîm"]},{"a":["وَارْفَعْ لِعَرْشِكَ وَلِلْكُرْسِيِّ","نَظْمِي هَاذَا بِاسْمِكَ الْقُدْسِيِّ"],"p":["warfaʿ liʿarchika walilkoursiyy","naẓmî hâdhâ bismika lqoudsiyy"]},{"a":["يَاللَّهُ يَاأَحَدُ إِنَّكَ الصَّمَدْ","يَارَافِعَ السَّمَآءِ مِنْ غَيْرِ عَمَدْ"],"p":["yâ allâhou yâ ahadou innaka ççamad","yâ râfiʿa ssamâʾi min ghayri ʿamad"]},{"a":["صَلِّ بِحَقِّ قُلْ هُوَ اللَّهُ أَحَدْ","عَلَى وَسِيلَتِي نَبِيِّكَ الْأَحَدْ"],"p":["çalli bihaqqi qoul houwa llâhou ahad","ʿalâ wasîlatî nabiyyika lahad"]},{"a":["سَيِّدِنَا مُحَمَّدٍ وَالْآلِ","وَصَحْبِهِ فِي الْحَالِ وَالْمَئَالِ"],"p":["sayyidinâ mouhammadin walâl","waçahbihi fi lhâli walmaʾâl"]},{"a":["وَهَبْ لَهُ يَارَبِّ مِنْ يَوْمِ الْأَحَدْ","أَعْلَى بُشَارَاتٍ لَّدَى كُلِّ أَحَدْ"],"p":["wahab lahou yâ rabbi min yawmi lahad","aʿlâ bouchârâtin lladâ koulli ahad"]},{"a":["وَاجْعَلْ كِتَابَتِي مَزَايَا قُوتَا","لَهُ وَزَيْنًا يَزْدَرِي يَاقُوتَا"],"p":["wadjʿal kitâbatî mazâyâ qoûtâ","lahou wazaynan yazdarî yâqoûtâ"]},{"a":["يَارَبَّنَا صَلِّ صَلَاةً بِسَلَامْ","عَلَى الَّذِى مَحَا الْعَنَآءَ وَالْمَلَامْ"],"p":["yâ rabbanâ çalli çalâtan bisalâm","ʿala lladhî maha lʿanâʾa walmalâm"]},{"a":["وَقَادَنِي إِلَيْكَ يَارَبِّ بِكَا","وَقُدْتَّنِي بِكَ لَهُ بِحُبِّكَا"],"p":["waqâdanî ilayka yâ rabbi bikâ","waqoudttanî bika lahou bihoubbikâ"]},{"a":["سَيِّدِنَا مُحَمَّدٍ وَالْآلِ","وَصَحْبِهِ فِي الْحَالِ وَالْمَئَالِ"],"p":["sayyidinâ mouhammadin walâl","waçahbihi fi lhâli walmaʾâl"]},{"a":["وَهَبْ لَهُ يَارَبِّ فِي الْإِثْنَيْنِ","فَوْقَ الْمُنَى وَالْحَاجِ مِنْ مَّنَّيْنِ"],"p":["wahab lahou yâ rabbi fi lithnayn","fawqa lmounâ walhâdji min mmannayn"]},{"a":["بِغَيْرِ ءَافَةٍ وَغَيْرِ كَدَرِ","يَامَنْ كَفَانِي كَدَرَاتِ الْقَدَرِ"],"p":["bighayri âfatin waghayri kadar","yâ man kafânî kadarâti lqadar"]},{"a":["يَارَبَّنَا صَلِّ صَلَاةً دَارِئَهْ","كُلَّ مَفَاسِدٍ تَصُولُ طَارِئَهْ"],"p":["yâ rabbanâ çalli çalâtan dâriʾah","koulla mafâsidin taçoûlou ṭâriʾah"]},{"a":["إِلَى سِوَانَا قَبْلَ أَنْ تَنْتَحِيَا","يَامَنْ لَّدَيْهِ ضَرَرِي قَدْ مُحِيَا"],"p":["ilâ siwânâ qabla an tantahiyâ","yâ man lladayhi ḍararî qad mouhiyâ"]},{"a":["مَعَ سَلَامٍ عُمُرِي يُسَلِّمُ","مِنْ كُلِّ مَا بِهِ تَجِيءُ الظُّلَمُ"],"p":["maʿa salâmin ʿoumourî yousallim","min koulli mâ bihi tadjîʾou ẓẓoulam"]},{"a":["عَلَى النَّبِيِّ وَالرَّسُولِ أَحْمَدَا","وَالْءَالِ وَالصَّحْبِ وَخَطِّي احْمَدَا"],"p":["ʿala nnabiyyi warrasoûli ahmadâ","walâli waççahbi wakhaṭṭi hmadâ"]},{"a":["وَاجْعَلْ حُرُوفِي كُلَّهَا عِبَادَهْ","يَامَنْ لَّهُ الْعِبَادُ وَالْعِبَادَهْ"],"p":["wadjʿal houroûfî koullahâ ʿibâdah","yâ man llahou lʿibâdou walʿibâdah"]},{"a":["وَهَبْ لِخَيْرِ الْخَلْقِ فِي خَطِّي الْبُشَرْ","يَاخَالِقًا جَعَلْتَهُ خَيْرَ الْبَشَرْ"],"p":["wahab likhayri lkhalqi fî khaṭṭi lbouchar","yâ khâliqan djaʿaltahou khayra lbachar"]},{"a":["وَجُدْ لَهُ يَارَبِّ فِي الثُّلَاثَا","بِمَا ازْدَرَى الرُّبَاعَ وَالثُّلَاثَا"],"p":["wadjoud lahou yâ rabbi fi ththoulâthâ","bima zdara rroubâʿa waththoulâthâ"]},{"a":["مِمَّا يَسُرُّ أَبَدًا وَيَنْفَعُ","يَامَنْ بِهِ الضُّرُّ لِغَيْرِي يَدْفَعُ"],"p":["mimmâ yasourrou abadan wayanfaʿ","yâ man bihi ḍḍourrou lighayrî yadfaʿ"]},{"a":["يَارَبَّنَا صَلِّ صَلَاةً لَّمْ تُرَا","نَظِيرُهَا وَمِثْلُهَا لَيْسَتْ تُرَى"],"p":["yâ rabbanâ çalli çalâtan llam tourâ","naẓîrouhâ wamithlouhâ laysat tourâ"]},{"a":["مِنَ الْخَلَآئِقِ عَلَى مَنْ فُضِّلَا","عَلَى جَمِيعِهِمْ مَّعًا فَفُضِّلَا"],"p":["mina lkhalâʾiqi ʿalâ man fouḍḍilâ","ʿalâ djamîʿihim mmaʿan fafouḍḍilâ"]},{"a":["مَعَ سَلَامٍ لَّا يُرَى وَلَمْ يُرَا","مِنَ الْوَرَى عَلَى الَّذِى قَدْ صُيِّرَا"],"p":["maʿa salâmin llâ yourâ walam yourâ","mina lwarâ ʿala lladhî qad çouyyirâ"]},{"a":["نُورًا لَّهُمْ مُحَمَّدٍ وَالْءَالِ","وَصَحْبِهِ فِي الْحَالِ وَالْمَئَالِ"],"p":["noûran llahoum mouhammadin walâl","waçahbihi fi lhâli walmaʾâl"]},{"a":["وَهَبْ لَهُ يَارَبِّ يَوْمَ الْأَرْبُعَآ","يَابَاقِيًا مُرَوِّيًا وَمُشْبِعَا"],"p":["wahab lahou yâ rabbi yawma larbouʿâ","yâ bâqiyan mourawwiyan wamouchbiʿâ"]},{"a":["مَافِيهِ كُلُّ مَلَكٍ وَبَشَرِ","يَغْبِطُهُ مِنْ زَيْدٍ وَبُشَرِ"],"p":["mâfîhi koullou malakin wabachar","yaghbiṭouhou min zaydin wabouchar"]},{"a":["وَاجْعَلْ حُرُفِي لَهُ لَذَّاتِ","بِلَا نِهَايَةٍ بِقَدْرِ الذَّاتِ"],"p":["wadjʿal houroufî lahou ladhdhât","bilâ nihâyatin biqadri dhdhât"]},{"a":["يَارَبَّنَا صَلِّ صَلَاةً صَافِيَهْ","صُدُورَ قَوْمٍ مُّؤْمِنِينَ شَافِيَهْ"],"p":["yâ rabbanâ çalli çalâtan çâfiyah","çoudoûra qawmin mmouʾminîna châfiyah"]},{"a":["مَعَ سَلَامٍ صَارِفٍ مَّفَاسِدَا","لِغَيْرِنَا وَشِقْوَةً وَفَاسِدَا"],"p":["maʿa salâmin çârifin mmafâsidâ","lighayrinâ wachiqwatan wafâsidâ"]},{"a":["عَلَى الَّذِى بَشَّرَهُ مِدَادِي","وَقَلَمِي سِنِينَ مَعْ وِدَادِي"],"p":["ʿala lladhî bachcharahou midâdî","waqalamî sinîna maʿ widâdî"]},{"a":["سَيِّدِنَا مُحَمَّدٍ وَالْآلِ","وَصَحْبِهِ فِي الْحَالِ وَالْمَئَالِ"],"p":["sayyidinâ mouhammadin walâl","waçahbihi fi lhâli walmaʾâl"]},{"a":["وَفِي الْخَمِيسِ هَبْ لَهُ فَوْقَ الْمُنَى","يَامَنْ جَعَلْتَهُ أَمِينَ الْأُمَنَا"],"p":["wafi lkhamîsi hab lahou fawqa lmounâ","yâ man djaʿaltahou amîna loumanâ"]},{"a":["يَارَبَّنَا صَلِّ صَلَاةً تُذْهِبُ","مَنْ قَصَدُوا ضُرِّي مَعًا فَتَذْهَبُ"],"p":["yâ rabbanâ çalli çalâtan toudhhib","man qaçadoû ḍourrî maʿan fatadhhab"]},{"a":["إِلَى سِوَاى سَرْمَدًا مَّعَ سَلَامْ","لِغَيْرِنَا يَذُبُّ مَنْ بِهِمْ ظَلَامْ"],"p":["ilâ siwâ sarmadan mmaʿa salâm","lighayrinâ yadhoubbou man bihim ẓalâm"]},{"a":["عَلَى الَّذِى وَجَّهَ جُنْدَ اللَّهِ","الْغَالِبِينَ لِذَوِى الْمَلَاهِي"],"p":["ʿala lladhî wadjdjaha djounda llâh","alghâlibîna lidhawi lmalâhî"]},{"a":["وَزَحْزَحُوا لِغَيْرِنَا الْكُفَّارَا","كَمَا مَحَا الْإِخْرَاجَ وَالْأَسْفَارَا"],"p":["wazahzahoû lighayrina lkouffârâ","kamâ maha likhrâdja walasfârâ"]},{"a":["سَيِّدِنَا مُحَمَّدٍ وَالْآلِ","وَصَحْبِهِ فِي الْحَالِ وَالْمَئَالِ"],"p":["sayyidinâ mouhammadin walâl","waçahbihi fi lhâli walmaʾâl"]},{"a":["وَهَدِّدِ الْأَعْدَآءَ تَهْدِيدًا يَدُومْ","يَصْرِفْهُمْ لِغَيْرِ عَبْدِكَ الْخَدِيمْ"],"p":["wahaddidi laʿdâʾa tahdîdan yadoûm","yaçrifhoum lighayri ʿabdika lkhadîm"]},{"a":["وَهَبْ لَهُ يَارَبِّ يَوْمَ الْجُمُعَهْ","فَوْقَ الْمُنَى مَعَ الَّذِى قَدْ جَمَعَهْ"],"p":["wahab lahou yâ rabbi yawma ldjoumouʿah","fawqa lmounâ maʿa lladhî qad djamaʿah"]},{"a":["يَارَبَّنَا صَلِّ صَلَاةً تَبْقَى","مَعَ سَلَامٍ لِّي يَقُودُ سَبْقَى"],"p":["yâ rabbanâ çalli çalâtan tabqâ","maʿa salâmin llî yaqoûdou sabqâ"]},{"a":["عَلَى الَّذِى وَهَبَ لِي الْكِتَابَا","وَلِيَ لَا يُوَجِّهُ الْعِتَابَا"],"p":["ʿala lladhî wahaba li lkitâbâ","waliya lâ youwadjdjihou lʿitâbâ"]},{"a":["سَيِّدِنَا مُحَمَّدٍ وَالْآلِ","وَصَحْبِهِ فِي الْحَالِ وَالْمَئَالِ"],"p":["sayyidinâ mouhammadin walâl","waçahbihi fi lhâli walmaʾâl"]},{"a":["وَهَبْ لَهُ يَارَبِّ يَوْمَ السَّبْتِ","وَكُلَّ يَوْمٍ يَافِعًا مِّنْ نَّبْتِ"],"p":["wahab lahou yâ rabbi yawma ssabt","wakoulla yawmin yâfiʿan mmin nnabt"]},{"a":["وَاجْعَلْ صَلَاتِي هَاذِهِ لَدَيْهِ","خَيْرَ صَلَاةٍ صُلِّيَتْ عَلَيْهِ"],"p":["wadjʿal çalâtî hâdhihi ladayh","khayra çalâtin çoulliyat ʿalayh"]},{"a":["وَاكْتُبْ لَهُ بِهَا بُشَارَاتِ الْأَحَدْ","وَهَبْ لَهُ الْأَيَّامَ مِنْ يَوْمِ الْأَحَدْ"],"p":["waktoub lahou bihâ bouchârâti lahad","wahab lahou layyâma min yawmi lahad"]}]}