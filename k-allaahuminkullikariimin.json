{
 "id": "allaahuminkullikariimin",
 "ar": "اللَّهُ مِنْ كُلِّ كَرِيمٍ",
 "fr": "Allaahu Min Kulli Kariimin",
 "lines": [
  {
   "a": [
    "اللَّهُ مِنْ كُلِّ كَرِيمٍ أَكْرَمُ",
    "مَنْ أَمَّهُ انْقَادَ لَهُ التَّكَرُّمُ"
   ],
   "p": [
    "allâhou min kulli karîmin akram",
    "man ammahou nqâda lahou ttakarrum"
   ]
  },
  {
   "a": [
    "أَسْلِمْ لَهُ كُلَّكَ عَنْ إِيمَانِ",
    "وَلَازِمِ الْإِحْسَانَ لِلرَّحْمَانِ"
   ],
   "p": [
    "aslim lahou kullaka ʿan îmân",
    "wa lâzimi lihsâna lirrahmân"
   ]
  },
  {
   "a": [
    "وَاجِهْهُ بِالشُّكْرِ بِلَا كُفْرَانِ",
    "تُكْفَ حِسَابَهُ مَعَ النِّرَانِ"
   ],
   "p": [
    "wâjihhou bichchoukri bilâ koufrân",
    "toukfa hisâbahou maʿa nnirân"
   ]
  }
 ]
}