{"id":"alasmaaulhusnaa","ar":"الأَسْمَاءُ الْحُسْنَى","fr":"Al Asmaa-ul Husnaa","lines":[{"a":["يَاللَّهُ يَامَنْ لَّاإِلَاهَ غَيْرُهُ","يَامَنْ يَّجِيئُنِى دَوَامًا خَيْرُهُ"],"p":["yâ llâhou yâ mal lâ ilâha ghayrouh","yâ may yyadjî'ounî dawâman khayrouh"]},{"a":["صَلِّ وَسَلِّمْ سَرْمَدًا يَارَحْمَانْ","عَلَى الَّذِى بِهِۦ تُطِيبُ الْأَزْمَانْ"],"p":["çalli wa sallim sarmadan yâ rahmân","ʿala lladhî bihî touṭîbou l-azmân"]},{"a":["سَيِّدِنَا مُحَمَّدٍ وَالْءَالِ","وَلِى اسْتَجِبْ بِجَاهِهِۦ سُؤَالِى"],"p":["sayyidinâ mouhammadin wa l-âl","wa lî stadjib bidjâhihî sou'âlî"]},{"a":["أَنْتَ الرَّحِيمُ الْمَلِكُ الْقُدُّوسُ","لَكَ عَلَىَّ الشُّكْرُ وَالتَّقْدِيسُ"],"p":["anta rrahîmou l-malikou l-qouddoûs","laka ʿalayya chchoukrou wa ttaqdîs"]},{"a":["أَنْتَ السَّلَامُ الْمُومِنُ الْمُهَيْمِنُ","أَدْعُو بِهَا وَإِنَّنِى أُهَيْمِنُ"],"p":["anta ssalâmou l-moûminou l-mouhaymin","adʿoû bihâ wa innanî ouhaymin"]},{"a":["أَنْتَ الْعَزِيزُ الرَّبُّ وَالْجَبَّارُ","لَكَ عَلَىَّ الْحَمْدُ وَالْكُبَّارُ"],"p":["anta l-ʿazîzou rrabbou wa l-djabbâr","laka ʿalayya l-hamdou wa l-koubbâr"]},{"a":["يَامُتَكَبِّرًا لَّهُ التَّكَبُّرُ","خَالِقُ يَابَارِئُ يَامُصَوِّرُ"],"p":["yâ moutakabbiral lahou ttakabbour","khâliqou yâ bâri'ou yâ mouçawwir"]},{"a":["غَفَّارُ يَاقَهَّارُ يَاوَهَّابُ","يَامَنْ لَّهُ التَّبْشِيرُ وَالْإِرْهَابُ"],"p":["ghaffârou yâ qahhârou yâ wahhâb","yâ mal lahou ttabchîrou wa l-irhâb"]},{"a":["رَزَّاقُ يَافَتَّاحُ يَاعَلِيمُ","يَاخَيْرَ مَنْ يَّأْوِى لَهُ مَظْلُومُ"],"p":["razzâqou yâ fattâhou yâ ʿalîm","yâ khayra may yyaʾwî lahou maẓloûm"]},{"a":["قَابِضُ يَابَاسِطُ يَاخَافِضُ يَا","رَافِعُ يَاخَيْرَ مُضِىءٍ بِضِيَآ"],"p":["qâbiḍou yâ bâsiṭou yâ khâfiḍou yâ","râfiʿou yâ khayra mouḍî'in biḍiyâ"]},{"a":["مُعِزُّ يَامُذِلُّ يَاسَمِيعُ يَا","بَصِيرُ يَاخَيْرَ مُجِيبٍ دُعِيَا"],"p":["mouʿizzou yâ moudhillou yâ samîʿou yâ","baçîrou yâ khayra moudjîbin douʿiyâ"]},{"a":["حَكَمُ يَاعَادِلُ لَطِيفُ يَاخَبِيرْ","حَلِيمُ يَاعَظِيمُ إِنَّكَ الْغَفُورْ"],"p":["hakamou yâ ʿâdilou laṭîfou yâ khabîr","halîmou yâ ʿaẓîmou innaka l-ghafoûr"]},{"a":["شَكُورُ يَاعَلِيُّ يَاكَبِيرُ","لَكَ عَلَىَّ الشُّكْرُ وَالتَّكْبِيرُ"],"p":["chakoûrou yâ ʿaliyyou yâ kabîr","laka ʿalayya chchoukrou wa ttakbîr"]},{"a":["حَفِيظُ يَامُقِيتُ يَاحَسِيبُ","جَلِيلُ يَاكَرِيمُ يَارَقِيبُ"],"p":["hafîẓou yâ mouqîtou yâ hasîb","djalîlou yâ karîmou yâ raqîb"]},{"a":["مُجِيبُ يَاوَاسِعُ يَاحَكِيمُ","يَامَنْ لَهُ التَّأْمِيرُ وَالتَّحْكِيمُ"],"p":["moudjîbou yâ wâsiʿou yâ hakîm","yâ man lahou t-ta'mîrou wa ttahkîm"]},{"a":["أَنْتَ الْوَدُودُ وَالْمَجِيدُ الْبَاعِثُ","إِلَى شَنَاكَ سَاقَنِى الْبَوَاعِثُ"],"p":["anta l-wadoûdou wa l-madjîdou l-bâʿith","ilâ chanâka sâqanî l-bawâʿith"]},{"a":["أَنْتَ الشَّهِيدُ الْحَقُّ وَالْوَكِيلُ","مِنِّى إِلَيْكَ أَبَدًا تَوْكِيلُ"],"p":["anta chchahîdou l-haqqou wa l-wakîl","minnî ilayka abadan tawkîl"]},{"a":["أَنْتَ الْقَوِىُّ وَالْمَتِينُ وَالْوَلِى","يَامَنْ إِلَيْهِ سَرْمَدًا تَحَوُّلِى"],"p":["anta l-qawiyyou wa l-matînou wa l-walî","yâ man ilayhi sarmadan tahawwoulî"]},{"a":["أَنْتَ الْحَمِيدُ رَبِّ أَنْتَ الْمُحْصِى","أَنْتَ الَّذِى ثَنَآئَهُ لَآ أُحْصِى"],"p":["anta l-hamîdou rabbi anta l-mouhçî","anta lladhî thanâ'ahou lâ ouhçî"]},{"a":["مُبْدِئُ يَامُعِيدُ مُحْيِى يَامُمِيتْ","أَنْتَ الَّذِى تُحْيِى الْبَرَايَا وَتُمِيتْ"],"p":["moubdi'ou yâ mouʿîdou mouhyî yâ moumît","anta lladhî touhyî l-barâyâ wa toumît"]},{"a":["يَاحَىُّ يَاقَيُّومُ يَاوَاجِدُ يَا","مَاجِدُ يَامَطْلُوبَ عَبْدٍ هُدِيَا"],"p":["yâ hayyou yâ qayyoûmou yâ wâdjidou yâ","mâdjidou yâ maṭloûba ʿabdin houdiyâ"]},{"a":["وَاحِدُ يَاصَمَدُ يَاقَادِرُ يَا","مَنْ كَوْنُهُ رَبَّ الْبَرَايَا دُرِيَا"],"p":["wâhidou yâ çamadou yâ qâdirou yâ","man kawnouhou rabba l-barâyâ douriyâ"]},{"a":["أَنْتَ الَّذِى نَدْعُوكَ بِالْمُقْتَدِرِ","وَبِالْمُقَدِّمِ وَبِالْمُؤَخِّرِ"],"p":["anta lladhî nadʿoûka bi l-mouqtadir","wa bi l-mouqaddimi wa bi l-mou'akhkhir"]},{"a":["أَوَّلُ يَاءَاخِرُ أَنْتَ الظَّاهِرُ","الْبَاطِنُ الَّذِى لَهُ الْمَظَاهِرُ"],"p":["awwalou yâ âkhirou anta ẓẓâhir","al-bâṭinou lladhî lahou l-maẓâhir"]},{"a":["وَإِنَّكَ الْوَالِى الَّذِى تُوَالِى","وَالْمُتَعَالِى الْمُصْلِحُ الْأَحْوَالِ"],"p":["wa innaka l-wâlî lladhî touwâlî","wa l-moutaʿâlî l-mouçlihou l-ahwâl"]},{"a":["يَابَرُّ يَاتَوَّابُ يَامُنْتَقِمُ","كَوْنُكَ لِى حَسْبِى فَلَآ أَنْتَقِمُ"],"p":["yâ barrou yâ tawwâbou yâ mountaqim","kawnouka lî hasbî fa lâ antaqim"]},{"a":["وَإِنَّكَ الْعَفُوُّ وَالرَّؤُوفُ","يَاخَيْرَ مَنْ لَهُ التَّجَامَجُوفُ"],"p":["wa innaka l-ʿafouwwou wa rraʾoûf","yâ khayra man lahou ttadjâmadjoûf"]},{"a":["يَامَالِكَ الْمُلْكِ الَّذِى مَرَامِى","لَدَيْهِ ذَا الْجَلَالِ وَالْإِكْرَامِ"],"p":["yâ mâlika l-moulki lladhî marâmî","ladayhi dhâ l-djalâli wa l-ikrâm"]},{"a":["مُقْسِطُ يَاجَامِعُ يَاغَنِيُّ يَا","مَنْ مِنْهُ أَرْتَجِى قَبُولُ سَعْيِيَا"],"p":["mouqsiṭou yâ djâmiʿou yâ ghaniyyou yâ","man minhou artadjî qaboûlou saʿyiyâ"]},{"a":["أَنْتَ الَّذِى عَنْ سَبَبٍ قَدْ تُغْنِى","مَنْ شِئْتَهُ مِنَ الْوَرَى يَامُغْنِى"],"p":["anta lladhî ʿan sababin qad toughnî","man chi'tahou mina l-warâ yâ moughnî"]},{"a":["يَامَنْ بِهِۦ قَلْبِى دَوَامًا قَانِعُ","وَحَاطَنِى عَنِ الْأَذَى يَامَانِعُ"],"p":["yâ man bihî qalbî dawâman qâniʿ","wa hâṭanî ʿani l-adhâ yâ mâniʿ"]},{"a":["يَامَنْ يَقِينِىَ الْبَلَآ وَالْإِضْرَارْ","وَكُلَّ مَا يَسُوءُ قَلْبِى يَاضَآرْ"],"p":["yâ man yaqînî l-balâ wa l-iḍrâr","wa koulla mâ yasoû'ou qalbî yâ ḍâr"]},{"a":["يَامَنْ يَّجِيئُنِى هُنَا الْمَنَافِعُ","وَفِى غَدٍ بِفَضْلِهِ يَانَافِعُ"],"p":["yâ may yyadjî'ounî hounâ l-manâfiʿ","wa fî ghadin bifaḍlihî yâ nâfiʿ"]},{"a":["يَامَنْ فُؤَادِى أَبَدًا يَنُورُ","بِكَوْنِهِ لِى أَبَدًا يَانُورُ"],"p":["yâ man fou'âdî abadan yanoûr","bikawnihî lî abadan yâ noûr"]},{"a":["يَامَنْ لَّهُ انْصَرَفْتُ بِاجْتِهَادِ","وَأَرْتَجِى فَوْقَ الْمُنَى يَاهَادِىْ"],"p":["yâ mal lahou nçarafto bidjtihâd","wa artadjî fawqa l-mounâ yâ hâdî"]},{"a":["يَامَنْ لَهُ عَلَىَّ شُكْرٌ بَدِيعْ","عَلَى أَيَادِيهِ الْعِظَامِ يَابَدِيعْ"],"p":["yâ man lahou ʿalayya choukroun badîʿ","ʿalâ ayâdîhi l-ʿiẓâmi yâ badîʿ"]},{"a":["يَامَنْ يَّضُمُّنِى إِلَى السُّبَّاقِ","لِحُسْنِ ظَنِّىَ بِهِۦ يَابَاقِى"],"p":["yâ may yyaḍoummounî ilâ ssoubbâq","lihousni ẓanniya bihî yâ bâqî"]},{"a":["يَامَنْ لَّدَيْهِ كَسْبُ كُلِّ حَارِثْ","كَوْنُكَ لِى ذَخِيرَتِى يَاوَارِثْ"],"p":["yâ mal ladayhi kasbou koulli hârith","kawnouka lî dhakhîratî yâ wârith"]},{"a":["وَمِنْكَ يَاتِى قَلْبِىَ التَّرْشِيدُ","الْعَامَ وَالصَّفَآءُ يَارَشِيدُ"],"p":["wa minka yâtî qalbiya ttarchîd","al-ʿâma wa ççafâ'ou yâ rachîd"]},{"a":["يُصْلِحُنِى كِتَابُكَ الْمَزْبُورُ","بِفَضْلِكَ الْعَظِيمِ يَاصَبُورُ"],"p":["youçlihounî kitâbouka l-mazboûr","bifaḍlika l-ʿaẓîmi yâ çaboûr"]}]}