{"id":"wakana","ar":"وَكَانَ حَقًّا","fr":"Wa kāna ḥaqqan","lines":[{"a":["أَعُوذُ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ وَإِنِّيَ أُعِيذُهَا بِكَ وَذُرِّيَّتَهَا مِنَ"],"p":["ʾaʿoûdhou billâhi mina achchayṭâni arradjîmi waʾinniya ʾouʿîdhouhâ bika wadhourriyyatahâ mina"]},{"a":["الشَّيْطَٰنِ الرَّجِيمِ رَبِّ أَعُوذُ بِكَ مِنْ هَمَزَاتِ الشَّيَٰطِينِ وَأَعُوذُ بِكَ"],"p":["achchayṭâni arradjîmi rabbi ʾaʿoûdhou bika min hamazâti achchayâṭîni waʾaʿoûdhou bika"]},{"a":["رَبِّ أَنْ يَحْضُرُونِ لِبِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ اللَّهُمَّ بِحَقِّ وَجْهِكَ"],"p":["rabbi ʾan yahḍouroûni libismi allâhi arrahmâni arrahîmi allâhoumma bihaqqi wadjhika"]},{"a":["الْكَرِيمِ صَلِّ وَسَلِّمْ وَبَارِكْ عَلَى سَيِّدِنَا وَمَوْلَانَا مُحَمَّدٍ وَآلِهِ وَصَحْبِهِ"],"p":["alkarîmi çalli wasallim wabârik ʿalâ sayyidinâ wamawlânâ mouhammadin waʾâlihi waçahbihi"]},{"a":["يَا مَنْ جَعَلَ هَذِهِ الْحُرُوفَ رِضَاكَ وَرِضَى رَسُولِكَ عَلَيْهِ الصَّلَاةُ"],"p":["yâ man djaʿala hadhihi alhouroûfa riḍâka wariḍâ rasoûlika ʿalayhi aççalâtou"]},{"a":["وَالسَّلَامُ وَفُرْحَةَ جَمِيعِ الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ آمِينَ يَا رَبَّ الْعَالَمِينَ"],"p":["wassalâmou wafourhata djamîʿi almouʾminîna walmouʾminâti âmîna yâ rabba alʿâlamîna"]},{"a":["وَكَانَ حَقًّا عَلَيْنَا نَصْرُ الْمُؤْمِنِينَ"],"p":["wakâna haqqan ʿalaynâ naçrou almouʾminîna"]},{"a":["لِبِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَصَلَّى اللَّهُ عَلَى سَيِّدِنَا مُحَمَّدٍ وَآلِهِ"],"p":["libismi allâhi arrahmâni arrahîmi waçallâ allâhou ʿalâ sayyidinâ mouhammadin waʾâlihi"]},{"a":["وَصَحْبِهِ وَسَلَّمَ تَسْلِيمًا"],"p":["waçahbihi wasallama taslîman"]},{"a":["وَجَّهْتُ كُلِّيَ بِحَمْدٍ وَشُكُورْ","إِلَى وَلِيِّ الْمُؤْمِنِينَ وَالشَّكُورْ"],"p":["wadjdjahtou koulliya bihamdin wachoukoûr","ʾilâ waliyyi almouʾminîna wachchakoûr"]},{"a":["كُنْ يَا وَلِيُّ يَا قَدِيرُ يَا نَصِيرْ","لِلْمُؤْمِنِينَ إِنَّكَ الْهَادِي الْبَصِيرْ"],"p":["koun yâ waliyyou yâ qadîrou yâ naçîr","lilmouʾminîna ʾinnaka alhâdî albaçîr"]},{"a":["أَذْهَبْتَ فَوْرًا لِسِوَانَا كُلَّ مَنْ","لَيْسَ يَكُونُ مُؤْمِنًا يَا ذَا الزَّمَنْ"],"p":["ʾadhhabta fawran lisiwânâ koulla man","laysa yakoûnou mouʾminan yâ dhâ azzaman"]},{"a":["أَذْهَبْتَ فَوْرًا لِسِوَانَا كُلَّ مَنْ","لَيْسَ يَكُونُ مُسْلِمًا يَا ذَا الزَّمَنْ"],"p":["ʾadhhabta fawran lisiwânâ koulla man","laysa yakoûnou mousliman yâ dhâ azzaman"]},{"a":["أَذْهَبْتَ فَوْرًا لِسِوَانَا كُلَّ مَنْ","لَيْسَ يَكُونُ مُحْسِنًا يَا ذَا الزَّمَنْ"],"p":["ʾadhhabta fawran lisiwânâ koulla man","laysa yakoûnou mouhsinan yâ dhâ azzaman"]},{"a":["نَفَعْتَنَا بِأَفْضَلِ الْإِيمَانِ","فَلْتَنْفَعِ الْجَمِيعَ بِالْأَمَانِ"],"p":["nafaʿtanâ biʾafḍali al îmâni","faltanfaʿi aldjamîʿa bilʾamâni"]},{"a":["حَفِظْتَنَا بِهِ وَبِالْإِسْلَامِ","فَلْتَحْفَظِ الْكُلَّ عَنِ الْمَلَامِ"],"p":["hafiẓtanâ bihi wabilʾislâmi","faltahfaẓi alkoulla ʿani almalâmi"]},{"a":["قَدَّمْتَ سَيِّدَ الْبَرَايَا أَحْمَدَا","وَالْأَنْبِيَا وَالرُّسْلَ يَا مَنْ حُمِدَا"],"p":["qaddamta sayyida albarâyâ ʾahmadâ","wal anbiyâ warrousla yâ man houmidâ"]},{"a":["قُدِ الصَّلَاةَ وَالسَّلَامَ أَبَدَا","لَهُمْ كَمَا أَخْزَيْتَ مَنْ لَمْ يَعْبُدَا"],"p":["qoudi aççalâta wassalâma ʾabadâ","lahoum kamâ ʾakhzayta man lam yaʿboudâ"]},{"a":["إِلَى النَّبِي قُدِ الصَّلَاةَ وَالسَّلَامْ","وَالْأَنْبِيَا وَالرُّسْلِ مُنْزِلَ الْكَلَامْ"],"p":["ʾilâ annabî qoudi aççalâta wassalâm","wal anbiyâ warrousli mounzila alkalâm"]},{"a":["عَلَى النَّبِي مُحَمَّدٍ وَالْآلِ","صَلِّ وَسَلِّمْ وَاسْتَجِبْ سُؤَالِي"],"p":["ʿalâ annabî mouhammadin wal âli","çalli wasallim wâstadjib souʾâlî"]},{"a":["لِلْمُنْتَقَى اكْتُبْ مَا يَسُرُّهُ بِلَا","نِهَايَةٍ وَخِدْمَتِي تَقَبَّلَا"],"p":["lilmountaqâ ktoub mâ yasourrouhou bilâ","nihâyatin wakhidmatî taqabbalâ"]},{"a":["يَسِّرْ لِسَيِّدِ الْوَرَى مَا اخْتَارَا","يَا بَاقِيًا جَعَلَهُ مُخْتَارَا"],"p":["yassir lisayyidi alwarâ mâ khtârâ","yâ bâqiyan djaʿalahou moukhtârâ"]},{"a":["نَافِعُ صَلِّ وَلْتُسَلِّمْ فِي أَبَدْ","عَلَى الَّذِي لَكَ يَقُودُ مَنْ عَبَدْ"],"p":["nâfiʿou çalli waltousallim fî ʾabad","ʿalâ aldhî laka yaqoûdou man ʿabad"]},{"a":["اُكْتُبْ صَلَاةً لِجَمِيعِ الْأَنْبِيَا","وَالرُّسْلِ بِالتَّسْلِيمِ وَاشْكُرْ كُتْبِيَا"],"p":["ktoub çalâtan lidjamîʿi al anbiyâ","warrousli bittaslîmi wâchkour koutbiyâ"]},{"a":["نَافِعُ صَلِّ وَلْتُسَلِّمْ بِاحْتِرَامْ","عَلَى النَّبِي وَالْآلِ وَالصَّحْبِ الْكِرَامْ"],"p":["nâfiʿou çalli waltousallim bihtirâm","ʿalâ annabî wal âli waççahbi alkirâm"]},{"a":["صَلَاةُ ذِي الْعَرْشِ الْعَظِيمِ الصَّمَدِ","عَلَى النَّبِي وَآلِهِ وَالْحُمَّدِ"],"p":["çalâtou dhî alʿarchi alʿaẓîmi aççamadi","ʿalâ annabî waʾâlihi walhoummadi"]},{"a":["رُدَّ مَكَايِدَ الْعِدَى إِلَى الْعِدَى","يَا مَنْ حَبَانِيَ بِمُخْجِلِ عِدَى"],"p":["roudda makâyida alʿidâ ʾilâ alʿidâ","yâ man habâniya bimoukhdjili ʿidâ"]},{"a":["أَوْصِلْ لِكُلِّ مُسْلِمٍ وَمُسْلِمَهْ","مَسَرَّةً يَا مَنْ كَفَانِي الظَّلَمَهْ"],"p":["ʾawçil likoulli mouslimin wamouslimah","masarratan yâ man kafânî aẓẓalamah"]},{"a":["لِكُلِّ مُؤْمِنٍ وَكُلِّ مُؤْمِنَهْ","أَوْصِلْ بُشَارَاتٍ لِصَفْوٍ مُدْمِنَهْ"],"p":["likoulli mouʾminin wakoulli mouʾminah","ʾawçil bouchârâtin liçafwin moudminah"]},{"a":["مُدَّ لِكُلِّ مُحْسِنٍ وَمُحْسِنَهْ","أَعْلَى بُشَارَاتٍ تُرَى مُسْتَحْسَنَهْ"],"p":["moudda likoulli mouhsinin wamouhsinah","ʾaʿlâ bouchârâtin tourâ moustahsanah"]},{"a":["وَجِّهْ لِأُمَّةِ رَسُولِ اللَّهِ","عَلَيْهِ خَيْرُ صَلَوَاتِ اللَّهِ"],"p":["wadjdjih liʾoummati rasoûli allâhi","ʿalayhi khayrou çalawâti allâhi"]},{"a":["مَدَدَ مَنْ مَتَى يَقُلْ كُنْ يَكُنِ","يَا مَنْ يُكَوِّنُ مُنًى لَمْ تَكُنِ"],"p":["madada man matâ yaqoul koun yakouni","yâ man youkawwinou mounanâ lam takouni"]},{"a":["نَاجَيْتُكَ الْيَوْمَ بِحَمْدٍ وَشُكُورْ","فِي الْمُؤْمِنِينَ يَا وَلِيُّ يَا شَكُورْ"],"p":["nâdjaytouka alyawma bihamdin wachoukoûr","fî almouʾminîna yâ waliyyou yâ chakoûr"]},{"a":["يَقُودُ لِي كُنْ فَيَكُونُ حَاجِي","مِنْكَ بِلَا حِقْدٍ وَلَا تَحَاجِ"],"p":["yaqoûdou lî koun fayakoûnou hâdjî","minka bilâ hiqdin walâ tahâdji"]},{"a":["نَفَيْتَ إِبْليِسَ لِغَيْرِي أَبَدَا","فِي الشَّهْرِ ذَا وَكُلَّ مَنْ لَمْ يَعْبُدَا"],"p":["nafayta ʾiblyisa lighayrî ʾabadâ","fî achchahri dhâ wakoulla man lam yaʿboudâ"]},{"a":["وَجِّهْ لِمَنْ قَدْ آمَنُوا وَأَسْلَمُوا","وَأَحْسَنُوا مُخْجِلَ مَنْ لَمْ يُسْلِمُوا"],"p":["wadjdjih liman qad âmanoû waʾaslamoû","waʾahsanoû moukhdjila man lam youslimoû"]},{"a":["كَوِّنْ لِأُمَّةِ النَّبِيِّ صَلَّى","عَلَيْهِ بِالتَّسْلِيمِ رَبٌّ جَلَّا"],"p":["kawwin liʾoummati annabiyyi çallâ","ʿalayhi bittaslîmi rabboun djallâ"]},{"a":["إِجَابَةً تُزَحْزِحُ الْأَعْدَاءَا","إِلَى سِوَاهُمْ سَرْمَدًا وَالدَّاءَا"],"p":["ʾidjâbatan touzahzihou al aʿdâʾâ","ʾilâ siwâhoum sarmadan waddâʾâ"]},{"a":["نَافِعُ يَا كَرِيمُ يَا مُهَيْمِنُ","لِيَ اسْتَجِبْ وَلِلَّذِي يُهَيْمِنُ"],"p":["nâfiʿou yâ karîmou yâ mouhayminou","liya stadjib walilladhî youhayminou"]},{"a":["حَفِيظُ صُنْ أُمَّةَ خَيْرِ مُرْسَلِ","عَنِ الَّذِينَ كَفَرُوا بِالرُّسُلِ"],"p":["hafîẓou çoun ʾoummata khayri moursali","ʿani aldhîna kafaroû birrousouli"]},{"a":["قُدْ لَهُمُ النَّصْرَ الْعَزِيزَ عَاجِلَا","وَبَشِّرَنْهُمْ عَاجِلًا وَآجِلَا"],"p":["qoud lahoumou annaçra alʿazîza ʿâdjilâ","wabachchiranhoum ʿâdjilan waʾâdjilâ"]},{"a":["قُدْ لِذَوِي الْإِيمَانِ مَا يَزِيدُ","حُبَّكَ يَا مَنْ عِنْدَهُ مَزِيدُ"],"p":["qoud lidhawî al îmâni mâ yazîdou","houbbaka yâ man ʿindahou mazîdou"]},{"a":["أَغْنِ ذَوِي الْإِسْلَامِ عَنْ رُكُونِ","إِلَى عِدَاكَ وَعَنِ السُّكُونِ"],"p":["ʾaghni dhawî al islâmi ʿan roukoûni","ʾilâ ʿidâka waʿani assoukoûni"]},{"a":["عَلَى النَّبِيِّ وَالرَّسُولِ الْمُلْتَحَدْ","صَلِّ وَسَلِّمْ يَا مُبِيدَ مَنْ جَحَدْ"],"p":["ʿalâ annabiyyi warrasoûli almoultahad","çalli wasallim yâ moubîda man djahad"]},{"a":["لِلْمُنْتَقَى وَالْآلِ وَالصَّحْبِ الْكِرَامْ","أَوْصِلْ سَلَامَيْكَ وَجُدْ لِي بِالْمَرَامْ"],"p":["lilmountaqâ wal âli waççahbi alkirâm","ʾawçil salâmayka wadjoud lî bilmarâm"]},{"a":["يَا مَنْ لَهُ الْخَلْقُ كَمَا لَهُ الْأُمُورْ","يَا مُغْنِيًا أَغْنَيْتَنِي عَنِ الضَّمِيرْ"],"p":["yâ man lahou alkhalqou kamâ lahou al oumoûr","yâ moughniyan ʾaghnaytanî ʿani aḍḍamîr"]},{"a":["نَاجَيْتُكَ الْيَوْمَ وَأَمْسِ رَاجِيَا","وَلِي قَضَيْتَ دُونَ شَكٍّ حَاجِيَا"],"p":["nâdjaytouka alyawma waʾamsi râdjiyâ","walî qaḍayta doûna chakkin hâdjiyâ"]},{"a":["أَوْصِلْ لِأُمَّةِ النَّبِيِّ أَحْمَدَا","مُصَلِّيًا عَلَيْهِ فِيمَنْ حُمِدَا"],"p":["ʾawçil liʾoummati annabiyyi ʾahmadâ","mouçalliyan ʿalayhi fîman houmidâ"]},{"a":["نَصْرًا عَزِيزًا يَشْمَلُ الْكِبَارَا","مَعَ الصِّغَارِ رُضْ لَهُمْ مَنْ بَارَى"],"p":["naçran ʿazîzan yachmalou alkibârâ","maʿa aççighâri rouḍ lahoum man bârâ"]},{"a":["صُنِ الْحَدِيثَ وَالْفُرُوعَ كَالْكِتَابْ","عَنِ الَّذِينَ امْتَنَعُوا مِنَ الْمَتَابْ"],"p":["çouni alhadîtha walfouroûʿa kalkitâb","ʿani aldhîna mtanaʿoû mina almatâb"]},{"a":["رَافِعُ بِي ارْفَعِ الْكِتَابَ وَالْفُرُوعْ","مَعَ الْأَحَادِيثِ الصِّحَاحِ ذَا بُرُوعْ"],"p":["râfiʿou bî rfaʿi alkitâba walfouroûʿ","maʿa al ahâdîthi aççihâhi dhâ bouroûʿ"]},{"a":["أَعْطَيْتَنِي الْجَمِيعَ دُونَ سَلَبِ","وَلِي تَقُودُ السُّؤْلَ وَقْتَ الطَّلَبِ"],"p":["ʾaʿṭaytanî aldjamîʿa doûna salabi","walî taqoûdou assouʾla waqta aṭṭalabi"]},{"a":["لِي أَوْصِلِ الَّذِي أُرِيدُ وَانْفَعِ","بِيَ الْوَرَى يَا مُغْنِيًا عَنْ مِدْفَعِ"],"p":["lî ʾawçili aldhî ʾourîdou wânfaʿi","biya alwarâ yâ moughniyan ʿan midfaʿi"]},{"a":["مَحَوْتَ قَصْدَ الضُّرِّ لِي بِالْمُنْتَقَى","وَقُدْتَ لِي مَا وَدَّهُ ذَوُو التُّقَى"],"p":["mahawta qaçda aḍḍourri lî bilmountaqâ","waqoudta lî mâ waddahou dhawoû attouqâ"]},{"a":["وَجَّهْتَ لِي مَا لَا يَزَالُ عَجَبَا","فِي أَبَدٍ لِلصَّالِحِينَ النُّجَبَا"],"p":["wadjdjahta lî mâ lâ yazâlou ʿadjabâ","fî ʾabadin lilççâlihîna annoudjabâ"]},{"a":["مَدَدْتَ لِي مَدَدَ مَنْ لَا يَخْفَى","عَلَيْهِ شَيْءٌ جُدْتَ لِي بِالْأَخْفَى"],"p":["madadta lî madada man lâ yakhfâ","ʿalayhi chayʾoun djoudta lî bilʾakhfâ"]},{"a":["نَفَيْتَ كُلَّ مَنْ قَلَانِي فَهَرَبْ","لِمَا يَسُوؤُهُ دَوَامًا ذَا كُرَبْ"],"p":["nafayta koulla man qalânî faharab","limâ yasoûʾouhou dawâman dhâ kourab"]},{"a":["يَاللَّهُ يَا رَحْمَانُ يَا بَصِيرُ","قَادِرُ يَا رَحِيمُ يَا نَصِيرُ"],"p":["yâllâhou yâ rahmânou yâ baçîrou","qâdirou yâ rahîmou yâ naçîrou"]},{"a":["نَجَّيْتَ مَنْ بِيَ تَعَلَّقُوا مَعَا","مِنَ الشَّيَاطِينِ فَشُكْرِيَ اسْمَعَا"],"p":["nadjdjayta man biya taʿallaqoû maʿâ","mina achchayâṭîni fachoukriya smaʿâ"]},{"a":["وَجَّهْتُ شُكْرِيَ إِلَى الرَّحْمَانِ","الْمَالِكِ الرَّحِيمِ ذِي الْأَزْمَانِ"],"p":["wadjdjahtou choukriya ʾilâ arrahmâni","almâliki arrahîmi dhî al azmâni"]},{"a":["كَرَّمَنِي فِي مَوْضِعِي وَبَلَدِي","مُكَرِّمٌ بِالْأَمْنِ صَفَّى خَلَدِي"],"p":["karramanî fî mawḍiʿî wabaladî","moukarrimoun bilʾamni çaffâ khaladî"]},{"a":["أَكْرَمَنِي الرَّحْمَانُ إِكْرَامًا كَفَى","كُلِّيَّتِي الضُّرَّ وَفَيْضِي وَكَفَا"],"p":["ʾakramanî arrahmânou ʾikrâman kafâ","koulliyyatî aḍḍourra wafayḍî wakafâ"]},{"a":["نَاجَيْتُ رَبِّيَ بِشَهْرِ رَمَضَانْ","شَهْرِ الْأَمَانِ وَالْمُنَى وَالْفَيَضَانْ"],"p":["nâdjaytou rabbiya bichahri ramaḍân","chahri al amâni walmounâ walfayaḍân"]},{"a":["حَمِدْتُهُ حَمْدًا يَسُوقُ سَرْمَدَا","لِغَيْرِنَا إِبْلِيسَ سَوْقًا أَكْمَدَا"],"p":["hamidtouhou hamdan yasoûqou sarmadâ","lighayrinâ ʾiblîsa sawqan ʾakmadâ"]},{"a":["قُلُوبُ جُمْلَةِ الْعِدَى تَوَجَّهَتْ","لِغَيْرِ ضُرِّي وَالْمُنَى لِي وُجِّهَتْ"],"p":["qouloûbou djoumlati alʿidâ tawadjdjahat","lighayri ḍourrî walmounâ lî woudjdjihat"]},{"a":["قُلُوبُ جُمْلَةِ الَّذِينَ أَفْلَحُوا","لِيَ تَوَجَّهَتْ وَرَبِّي الْمُصْلِحُ"],"p":["qouloûbou djoumlati aldhîna ʾaflahoû","liya tawadjdjahat warabbî almouçlihou"]},{"a":["إِلَى الَّذِينَ ظَلَمُونِي قَبْلُ","نَحَتْ مَضَرَّتِي كَذَاكَ الْكَبْلُ"],"p":["ʾilâ aldhîna ẓalamoûnî qablou","nahat maḍarratî kadhâka alkablou"]},{"a":["عَنِّي انْتَفَتْ مَضَرَّتِي وَالْبَلْوَى","بِفَضْلِ مُغْنٍ لِيَ قَادَ الْحُلْوَا"],"p":["ʿannî ntafat maḍarratî walbalwâ","bifaḍli moughnin liya qâda alhoulwâ"]},{"a":["لَهُ شُكُورِيَ إِلَى الْجَنَّاتِ","دَارِ الْمُنَى وَالْأَمْنِ وَالْمِنَّاتِ"],"p":["lahou choukoûriya ʾilâ aldjannâti","dâri almounâ wal amni walminnâti"]},{"a":["يَشْكُرُهُ كُلِّيَ بِالْكِتَابِ","بِلَا مُعَادَاةٍ وَلَا عِتَابِ"],"p":["yachkourouhou koulliya bilkitâbi","bilâ mouʿâdâtin walâ ʿitâbi"]},{"a":["نَاجَيْتُهُ تَنَاجِيَ التَّكْرِيمِ","وَلَمْ يَزَلْ بِنَافِعٍ كَرِيمِ"],"p":["nâdjaytouhou tanâdjiya attakrîmi","walam yazal binâfiʿin karîmi"]},{"a":["إِلَيْهِ وَجَّهْتُ هُنَا خِطَابَا","مَعَ الْيَقِينِ وَفُؤَادِي طَابَا"],"p":["ʾilayhi wadjdjahtou hounâ khiṭâbâ","maʿa alyaqîni wafouʾâdî ṭâbâ"]},{"a":["نَصَرْتَنِي فَإِنَّكَ النَّصِيرُ","مَحَوْتَ عَيْبِي إِنَّكَ الْبَصِيرُ"],"p":["naçartanî faʾinnaka annaçîrou","mahawta ʿaybî ʾinnaka albaçîrou"]},{"a":["صَمَدُ قَدْ أَوْصَلْتَ لِي فِي رَمَضَانْ","مَا رُمْتُ مِنْكَ قَبْلَهُ بِفَيَضَانْ"],"p":["çamadou qad ʾawçalta lî fî ramaḍân","mâ roumtou minka qablahou bifayaḍân"]},{"a":["رَدَدْتَ لِي فِيهِ الَّذِي أَحْبَبْتَا","لِيَ وَجَالِبَ الْأَذَى ذَبَبْتَا"],"p":["radadta lî fîhi aldhî ʾahbabtâ","liya wadjâliba al adhâ dhababtâ"]},{"a":["أَجَبْتَنِي جَوَابَ مَنْ تَعَالَى","عَنْ سِنَةٍ وَقُدْتَ لِي انْفِعَالَا"],"p":["ʾadjabtanî djawâba man taʿâlâ","ʿan sinatin waqoudta lî nfiʿâlâ"]},{"a":["لِوَجْهِكَ الْكَرِيمِ أَوْصِلْ فَرَجَا","لِلْمُؤْمِنِينَ وَلْتُحَقِّقِ الرَّجَا"],"p":["liwadjhika alkarîmi ʾawçil faradjâ","lilmouʾminîna waltouhaqqiqi arradjâ"]},{"a":["مُصَلِّيًا مُسَلِّمًا عَلَى النَّبِي","بَشِيرِ كُلِّ أَقْرَبٍ وَأَجْنَبِ"],"p":["mouçalliyan mousalliman ʿalâ annabî","bachîri koulli ʾaqrabin waʾadjnabi"]},{"a":["وَلِيُّ هَبْ لِلْمُسْلِمِينَ فَرْحَهْ","يَا مَنْ مَحَا عَنِّي الْأَذَى وَالتَّرْحَهْ"],"p":["waliyyou hab lilmouslimîna farhah","yâ man mahâ ʿannî al adhâ wattarhah"]},{"a":["مَحَوْتَ مَا عَلَيَّ مَرَّ مِنْ بَلَا","يَا مَنْ جَمِيعَ خِدَمِي تَقَبَّلَا"],"p":["mahawta mâ ʿalayya marra min balâ","yâ man djamîʿa khidamî taqabbalâ"]},{"a":["نَجِّ عِيَالَ الْمُصْطَفَى بَعْدَ صَلَاهْ","مَعَ سَلَامٍ مِنْ عِدَاهُمُ الْقُلَاهْ"],"p":["nadjdji ʿiyâla almouçṭafâ baʿda çalâh","maʿa salâmin min ʿidâhoumou alqoulâh"]},{"a":["يَسِّرْ لَهُمْ بِهِ الَّذِي تَعَسَّرَا","فَكُلُّ مَا يَسَّرْتَهُ تَيَسَّرَا"],"p":["yassir lahoum bihi aldhî taʿassarâ","fakoullou mâ yassartahou tayassarâ"]},{"a":["نَاجَاكَ عَبْدُكَ خَدِيمُ عَبْدِكَا","مُرْتَجِيًا نَيْلَ الْمُنَى مِنْ عِنْدِكَا"],"p":["nâdjâka ʿabdouka khadîmou ʿabdikâ","mourtadjiyan nayla almounâ min ʿindikâ"]},{"a":["فَازَ الَّذِينَ سَعِدُوا بِالْخَيْرِ","وَبَاءَ مَنْ لَمْ يَسْعَدُوا بِالضَّيْرِ"],"p":["fâza aldhîna saʿidoû bilkhayri","wabâʾa man lam yasʿadoû biḍḍayri"]},{"a":["أُكْرِمَتِ الْأَبْرَارُ بِالنَّعِيمِ","وَكُبَّتِ الْفُجَّارُ فِي الْجَحِيمِ"],"p":["ʾoukrimati al abrârou binnaʿîmi","wakoubbati alfoudjdjârou fî aldjahîmi"]},{"a":["سِيقَ الَّذِينَ تَرَكُوا الْعِبَادَهْ","لِنَارِ مَنْ مَنْ لَمْ يُطِعْ أَبَادَهْ"],"p":["sîqa aldhîna tarakoû alʿibâdah","linâri man man lam youṭiʿ ʾabâdah"]},{"a":["تَعِبَ مَنْ أَرَادَ أَنْ يَنْقُضَ مَا","أَبْرَمَهُ مَنْ ضَيْفُهُ لَمْ يُضَمَا"],"p":["taʿiba man ʾarâda ʾan yanqouḍa mâ","ʾabramahou man ḍayfouhou lam youḍamâ"]},{"a":["جَزَاءُ مَنْ بَارَزَ ذَا الْعَرْشِ بُكَا","فَكُلُّ مَنْ أَبْكَاهُ ذُو الْكُرْسِي بَكَى"],"p":["djazâʾou man bâraza dhâ alʿarchi boukâ","fakoullou man ʾabkâhou dhoû alkoursî bakâ"]},{"a":["إِنَّ الَّذِينَ كَفَرُوا وَامْتَنَعُوا","مِنْ تَوْبَةٍ رَأَوْا جَزَا مَا صَنَعُوا"],"p":["ʾinna aldhîna kafaroû wâmtanaʿoû","min tawbatin raʾaw djazâ mâ çanaʿoû"]},{"a":["بُطُونُهُمْ سَكَنَهَا الْعَقَارِبُ","وَالْكُلُّ مِنْهُمْ مِنْ صَدِيدٍ شَارِبُ"],"p":["bouṭoûnouhoum sakanahâ alʿaqâribou","walkoullou minhoum min çadîdin châribou"]},{"a":["لِلْمُسْلِمِينَ وَلِكُلِّ الْمُسْلِمَاتْ","نُورُ الَّذِي أَذْهَبَ أَهْلَ الظُّلُمَاتْ"],"p":["lilmouslimîna walikoulli almouslimât","noûrou aldhî ʾadhhaba ʾahla aẓẓouloumât"]},{"a":["هُمُ الَّذِينَ فِي الْجِنَانِ يَخْلُدُونْ","وَهُمْ بِمَا يَسُرُّهُمْ مُخَلَّدُونْ"],"p":["houmou aldhîna fî aldjinâni yakhloudoûn","wahoum bimâ yasourrouhoum moukhalladoûn"]},{"a":["مُنَاهُمُ احْتَوَوْا بِلَا اسْتِلَابِ","وَالْكُلُّ بِالْبُشَرِ ذُو انْقِلَابِ"],"p":["mounâhoumou htawaw bilâ stilâbi","walkoullou bilbouchari dhoû nqilâbi"]},{"a":["رَجَاؤُهُمْ مُحَقَّقٌ وَمُلِّكُوا","فِي أَبَدٍ مَا لَا يَرَاهُ مَلِكُ"],"p":["radjâʾouhoum mouhaqqaqoun wamoullikoû","fî ʾabadin mâ lâ yarâhou malikou"]},{"a":["بِنَاؤُهُمْ يَعْلُو وَلَيْسَ يَنْسَفِلْ","أَمَّا مُبَارِزُ الْعَلِي فَمُنْسَفِلْ"],"p":["binâʾouhoum yaʿloû walaysa yansafil","ʾammâ moubârizou alʿalî famounsafil"]},{"a":["بِاللَّهِ آمِنُوا وَأَسْلِمُوا مَعَا","وَلْتُحْسِنُوا لِوَجْهِ بَاقٍ قَمَعَا"],"p":["billâhi âminoû waʾaslimoû maʿâ","waltouhsinoû liwadjhi bâqin qamaʿâ"]},{"a":["هُوَ الْإِلَهُ وَهُوَ الرَّحْمَانُ","وَهْوَ الرَّحِيمُ وَلَهُ الْأَزْمَانُ"],"p":["houwa al ilahou wahouwa arrahmânou","wahwa arrahîmou walahou al azmânou"]},{"a":["مِنِّي لَهُ أَنْفَعُ حَمْدٍ وَشُكُورْ","ذَا خِدْمَةٍ لِلْمُصْطَفَى الْعَبْدِ الشَّكُورْ"],"p":["minnî lahou ʾanfaʿou hamdin wachoukoûr","dhâ khidmatin lilmouçṭafâ alʿabdi achchakoûr"]},{"a":["فَارَقْتُ جُمْلَةً مِنَ الْمُبَاحِ","لِمَنْ كَفَانِيَ ذَوِي النُّبَاحِ"],"p":["fâraqtou djoumlatan mina almoubâhi","liman kafâniya dhawî annoubâhi"]},{"a":["أَشْكُرُهُ وَقَادَ لِي أَبْدَالَا","كَمَا كَفَانِي الْحَرْبَ وَالْجِدَالَا"],"p":["ʾachkourouhou waqâda lî ʾabdâlâ","kamâ kafânî alharba waldjidâlâ"]},{"a":["سُبْحَانَهُ وَهْوَ الْكَرِيمُ وَالْحَمِيدْ","وَكُلُّ مَنْ لَمْ يَهْوَنِي فَهْوَ كَمِيدْ"],"p":["soubhânahou wahwa alkarîmou walhamîd","wakoullou man lam yahwanî fahwa kamîd"]},{"a":["تَسْلِيمُ مَنْ لِي لَا يُوَجِّهُ الضَّرَرْ","عَلَى الَّذِي بِهِ كَفَانِيَ الْغَرَرْ"],"p":["taslîmou man lî lâ youwadjdjihou aḍḍarar","ʿalâ aldhî bihi kafâniya algharar"]},{"a":["جَزَاءُ مَنْ جَلَّ عَنِ الْمِثَالِ","لِي قَادَ مَا غَابَ عَنِ الْأَمْثَالِ"],"p":["djazâʾou man djalla ʿani almithâli","lî qâda mâ ghâba ʿani al amthâli"]},{"a":["الْحَمْدُ لِلَّهِ بِلَا انْتِهَاءِ","عَلَى ابْنِ عَبْدِ اللَّهِ ذِي الْبَهَاءِ"],"p":["alhamdou lillâhi bilâ ntihâʾi","ʿalâ bni ʿabdi allâhi dhî albahâʾi"]},{"a":["بَرَاعَةُ الْمُخْتَارِ لَيْسَتْ تَخْفَى","إِلَّا عَلَى مَنْ بِنَكَالٍ يُخْفَى"],"p":["barâʿatou almoukhtâri laysat takhfâ","ʾillâ ʿalâ man binakâlin youkhfâ"]},{"a":["لِلْمُصْطَفَى وَجَّهْتُ مَا قَدْ صَرَفَا","لِغَيْرِنَا إِبْلِيسَ وَهْوَ انْصَرَفَا"],"p":["lilmouçṭafâ wadjdjahtou mâ qad çarafâ","lighayrinâ ʾiblîsa wahwa nçarafâ"]},{"a":["هَدَمْتُ بَاطِلًا بِحَقٍّ فَزَهَقْ","وَلِي إِلَهِي كَأْسَ سَقْيِهِ دَهَقْ"],"p":["hadamtou bâṭilan bihaqqin fazahaq","walî ʾilahî kaʾsa saqyihi dahaq"]},{"a":["مَلَّكْتُ رَبِّي مَالِكِي كُلِّيَّتِي","حَالِي لَهُ كَعَمَلِي وَنِيَّتِي"],"p":["mallaktou rabbî mâlikî koulliyyatî","hâlî lahou kaʿamalî waniyyatî"]},{"a":["رَدَدْتُ بِاللَّهِ وَبِالرَّسُولِ","مَنْ خَالَفُوا الْحَقَّ وَنِلْتُ سُولِي"],"p":["radadtou billâhi wabilrrasoûli","man khâlafoû alhaqqa waniltou soûlî"]},{"a":["بَرَّأَنِي الْإِلَهُ مِنْ شِرْكٍ وَمِنْ","كُلِّ نِفَاقٍ وَسَعَادَتِي ضَمِنْ"],"p":["barraʾanî al ilahou min chirkin wamin","koulli nifâqin wasaʿâdatî ḍamin"]},{"a":["بَرَّأَنِي مِنْ عَيْبِ نَفْسِي بِالنَّبِي","صَلَّى عَلَيْهِ بِسَلَامٍ مُطْنَبِ"],"p":["barraʾanî min ʿaybi nafsî binnabî","çallâ ʿalayhi bisalâmin mouṭnabi"]},{"a":["هُوَ الَّذِي لَمْ أَرَ غَيْرَهُ وَلَا","أَرَاهُ فِي شَيْءٍ هَدَى وَنَوَّلَا"],"p":["houwa aldhî lam ʾara ghayrahou walâ","ʾarâhou fî chayʾin hadâ wanawwalâ"]},{"a":["مُحَمَّدٌ صَلَّى عَلَيْهِ بِسَلَامْ","وَسِيلَتِي لَهُ وَلِي قَادَ الْكَلَامْ"],"p":["mouhammadoun çallâ ʿalayhi bisalâm","wasîlatî lahou walî qâda alkalâm"]},{"a":["فَرَّحَنِي الْأَكْرَمُ تَفْرِيحًا يَدُومْ","بِأَنَّنِي خِلٌّ وَحِبٌّ وَخَدِيمْ"],"p":["farrahanî al akramou tafrîhan yadoûm","biʾannanî khilloun wahibboun wakhadîm"]},{"a":["لَهُ خِطَابِي وَمَحَا الْأَكْدَارَا","وَلِسِوَانَا وَجَّهَ الْغَدَّارَا"],"p":["lahou khiṭâbî wamahâ al akdârâ","walisiwânâ wadjdjaha alghaddârâ"]},{"a":["أَيَّدْتَنَا عَلَى الْعِدَى فَغُلِبُوا","وَلِسِوَانَا صَاغِرِينَ انْقَلَبُوا"],"p":["ʾayyadtanâ ʿalâ alʿidâ faghouliboû","walisiwânâ çâghirîna nqalaboû"]},{"a":["تَسْلِيمُ بَاقٍ قَادَ لِي الثَّوَابَا","عَلَى الَّذِي أَوْرَثَنِي الصَّوَابَا"],"p":["taslîmou bâqin qâda lî aththawâbâ","ʿalâ aldhî ʾawrathanî aççawâbâ"]},{"a":["عَلَى الَّذِي طَلَبَ كَوْنِيَ الْخَدِيمْ","لَهُ سَلَامَا ذِي الْبَرِيَّةِ الْقَدِيمْ"],"p":["ʿalâ aldhî ṭalaba kawniya alkhadîm","lahou salâmâ dhî albariyyati alqadîm"]},{"a":["لِمَنْ لَهُ كُلِّيَّتِي عِبَادَهْ","حَمْدِي وَمَنْ خَالَفَنِي أَبَادَهْ"],"p":["liman lahou koulliyyatî ʿibâdah","hamdî waman khâlafanî ʾabâdah"]},{"a":["مُلْكُ الَّذِي لَيْسَ لَهُ مُبَاهِ","لِي قَادَ مَا غَابَ عَنِ الْمُبَاهِي"],"p":["moulkou aldhî laysa lahou moubâhi","lî qâda mâ ghâba ʿani almoubâhî"]},{"a":["نَاجَانِيَ الْعَلِيمُ وَالْخَبِيرُ","وَجَادَ لِي الْوَاسِعُ وَالْكَبِيرُ"],"p":["nâdjâniya alʿalîmou walkhabîrou","wadjâda lî alwâsiʿou walkabîrou"]},{"a":["فَرَّحَنِي الْجَمِيلُ نِعْمَ النَّافِعُ","أَعْلَانِيَ الْمَلِكُ وَهْوَ الرَّافِعُ"],"p":["farrahanî aldjamîlou niʿma annâfiʿou","ʾaʿlâniya almalikou wahwa arrâfiʿou"]},{"a":["سَاقَ مَكَارِهِي لِمَنْ قَبْلُ نَحَا","مَضَرَّتِي مَنْ لِي يَقُودُ الْمِنَحَا"],"p":["sâqa makârihî liman qablou nahâ","maḍarratî man lî yaqoûdou alminahâ"]},{"a":["مَلَّكَنِي الْمَلِكُ وَالْمَلِيكُ","وَالْمَالِكُ الَّذِي لَهُ تَمْلِيكُ"],"p":["mallakanî almalikou walmalîkou","walmâlikou aldhî lahou tamlîkou"]},{"a":["أَجْرًا كَبِيرًا وَثَوَابًا وَجَزَا","وَالْوَعْدُ لِي فِي رَمَضَانَ نَجَزَا"],"p":["ʾadjran kabîran wathawâban wadjazâ","walwaʿdou lî fî ramaḍâna nadjazâ"]},{"a":["أَجْرُ الَّذِي مَا عِنْدَهُ لَا يَنْفَدُ","وَصَلَ لِي وَمَا اعْتَرَاهُ نَفَدُ"],"p":["ʾadjrou aldhî mâ ʿindahou lâ yanfadou","waçala lî wamâ ʿtarâhou nafadou"]},{"a":["خِدْمَةُ خَيْرِ الْعَالَمِينَ أَحْمَدَا","عَلَيْهِ تَسْلِيمَا كَرِيمٍ حُمِدَا"],"p":["khidmatou khayri alʿâlamîna ʾahmadâ","ʿalayhi taslîmâ karîmin houmidâ"]},{"a":["فَرَّحَتِ الْقَلْبَ وَنَفْسِي طَيَّبَتْ","وَبِمَكَارِهِي لِغَيْرِي ذَهَبَتْ"],"p":["farrahati alqalba wanafsî ṭayyabat","wabimakârihî lighayrî dhahabat"]},{"a":["يَسُرُّ خَيْرَ الْعَالَمِينَ قَلَمِي","عَلَيْهِ تَسْلِيمَا مُزِيلِ الْأَلَمِ"],"p":["yasourrou khayra alʿâlamîna qalamî","ʿalayhi taslîmâ mouzîli al alami"]},{"a":["لِلْمُصْطَفَى وَجَّهْتُ مَا لِي قَادَا","نَفْعًا بِلَا مَضَرَّةٍ فَانْقَادَا"],"p":["lilmouçṭafâ wadjdjahtou mâ lî qâdâ","nafʿan bilâ maḍarratin fânqâdâ"]},{"a":["هُوَ الشَّفِيعُ وَهُوَ الشُّجَاعُ","بِهِ امَّحَى ظُلْمِيَ وَالْأَوْجَاعُ"],"p":["houwa achchafîʿou wahouwa achchoudjâʿou","bihi mmahâ ẓoulmiya wal awdjâʿou"]},{"a":["مُحَمَّدٌ صَلَّى عَلَيْهِ اللَّهُ","فِي الْآلِ وَالصَّحْبِ وَمَنْ وَالَاهُ"],"p":["mouhammadoun çallâ ʿalayhi allâhou","fî al âli waççahbi waman wâlâhou"]},{"a":["مَحَا بَلَائِي وَمَحَا أَمْرَاضِي","وَبِالرِّضَى تَنْقَادُ لِي أَغْرَاضِي"],"p":["mahâ balâʾî wamahâ ʾamrâḍî","wabilrriḍâ tanqâdou lî ʾaghrâḍî"]},{"a":["نَبِيُّنَا الْمُخْتَارُ خَيْرُ الْأَنْبِيَا","عَلَيْهِ تَسْلِيمَا حَبِيبِي رَبِّيَا"],"p":["nabiyyounâ almoukhtârou khayrou al anbiyâ","ʿalayhi taslîmâ habîbî rabbiyâ"]},{"a":["قُدْتُ لَهُ كُلِّيَّتِي فِي الْعَلَنِ","وَالسِّرِّ وَهْوَ لِيَ قَادَ وَلَنِ"],"p":["qoudtou lahou koulliyyatî fî alʿalani","wassirri wahwa liya qâda walani"]},{"a":["رَفَعْتُ خِدْمَتِي إِلَى الْوَسِيلَهْ","صَلَّى عَلَيْهِ مَنْ أَرَى تَفْضِيلَهْ"],"p":["rafaʿtou khidmatî ʾilâ alwasîlah","çallâ ʿalayhi man ʾarâ tafḍîlah"]},{"a":["رَفَعْتُ خِدْمَتِي إِلَى الْمَاحِي السَّنَدْ","وَلِسِوَانَا سَاقَ كُلَّ مَنْ فَنَدْ"],"p":["rafaʿtou khidmatî ʾilâ almâhî assanad","walisiwânâ sâqa koulla man fanad"]},{"a":["هُوَ النَّبِيُّ وَالرَّسُولُ وَالْخَلِيلْ","وَهْوَ الْحَبِيبُ وَيُكَثِّرُ الْقَلِيلْ"],"p":["houwa annabiyyou warrasoûlou walkhalîl","wahwa alhabîbou wayoukaththirou alqalîl"]},{"a":["تَسْلِيمُ بَاقٍ لَا يَزَالُ صَمَدَا","عَلَى النَّبِيِّ وَالرَّسُولِ أَحْمَدَا"],"p":["taslîmou bâqin lâ yazâlou çamadâ","ʿalâ annabiyyi warrasoûli ʾahmadâ"]},{"a":["أَبْقَى سَلَامَيِ الْكَرِيمِ الصَّمَدِ","عَلَى النَّبِي وَسِيلَتِي مُحَمَّدِ"],"p":["ʾabqâ salâmayi alkarîmi aççamadi","ʿalâ annabî wasîlatî mouhammadi"]},{"a":["عَلَى النَّبِي وَسِيلَتِي مُحَمَّدِ","أَبْقَى سَلَامَيِ الْكَرِيمِ الصَّمَدِ"],"p":["ʿalâ annabî wasîlatî mouhammadi","ʾabqâ salâmayi alkarîmi aççamadi"]},{"a":["يَاللَّهُ يَا قَادِرُ يَا مُقْتَدِرُ","يَا مَنْ إِلَيَّ جُودُهُ يَبْتَدِرُ"],"p":["yâllâhou yâ qâdirou yâ mouqtadirou","yâ man ʾilayya djoûdouhou yabtadirou"]},{"a":["نَاجَيْتُكَ الْيَوْمَ وَقَبْلَ الْيَوْمِ","وَلِي جَعَلْتَ الْفِطْرَ فَوْقَ الصَّوْمِ"],"p":["nâdjaytouka alyawma waqabla alyawmi","walî djaʿalta alfiṭra fawqa aççawmi"]},{"a":["جِئْتُ بِذَا الْقَصِيدِ شَاكِرًا لَكَا","بِهِ وَقَبْلُ لِيَ قُدْتَ فَضْلَكَا"],"p":["djiʾtou bidhâ alqaçîdi châkiran lakâ","bihi waqablou liya qoudta faḍlakâ"]},{"a":["زِنْتُ قَصِيدَتِي تِهِ شُكُورَا","وَلَمْ تَزَلْ يَا مَالِكِي شَكُورَا"],"p":["zintou qaçîdatî tihi choukoûrâ","walam tazal yâ mâlikî chakoûrâ"]},{"a":["أَكْرَمْتَنِي إِكْرَامَ مَنْ مَا شَا فَعَلْ","وَكُلُّ مَا أَرَدْتُهُ مِنْكَ انْفَعَلْ"],"p":["ʾakramtanî ʾikrâma man mâ châ faʿal","wakoullou mâ ʾaradtouhou minka nfaʿal"]},{"a":["آتَيْتَنِي يَا رَبِّ مِنْ لَدُنْكَا","ذِكْرًا حَكِيمًا فَرَضِيتُ عَنْكَا"],"p":["âtaytanî yâ rabbi min ladounkâ","dhikran hakîman faraḍîtou ʿankâ"]},{"a":["بَارَكْتَ لِي يَا رَبِّ فِي حُرُوفِي","وَغَيْرِهَا وَجُدْتَ بِالْمَعْرُوفِ"],"p":["bârakta lî yâ rabbi fî houroûfî","waghayrihâ wadjoudta bilmaʿroûfi"]},{"a":["مَلَّكْتَنِي بِكَوْنِكَ الْكَرِيمَا","مَا قَادَ لِي التَّبْشِيرَ وَالتَّكْرِيمَا"],"p":["mallaktanî bikawnika alkarîmâ","mâ qâda lî attabchîra wattakrîmâ"]},{"a":["أَعْطَيْتَنِي مَا الْقَلْبَ أَنْسَى كُلَّ مَا","مَضَى مِنَ الضُّرِّ مَحَوْتَ الظُّلَمَا"],"p":["ʾaʿṭaytanî mâ alqalba ʾansâ koulla mâ","maḍâ mina aḍḍourri mahawta aẓẓoulamâ"]},{"a":["كَافَأَنِي مَنْ مَا لَهُ كُفْؤًا أَحَدْ","بِمَا لِغَيْرِي سَاقَ كُلَّ مَنْ جَحَدْ"],"p":["kâfaʾanî man mâ lahou koufʾan ʾahad","bimâ lighayrî sâqa koulla man djahad"]},{"a":["أَكْرَمَنِي بِقُلْ هُوَ اللَّهُ أَحَدْ","رَبِّي وَلَمْ يَكُنْ لَهُ كُفْؤًا أَحَدْ"],"p":["ʾakramanî biqoul houwa allâhou ʾahad","rabbî walam yakoun lahou koufʾan ʾahad"]},{"a":["نَاجَانِيَ اللَّهُ الْمُكَرِّمُ الصَّمَدْ","تَنَاجِيًا بِهِ كَفَانِيَ الْكَمَدْ"],"p":["nâdjâniya allâhou almoukarrimou aççamad","tanâdjiyan bihi kafâniya alkamad"]},{"a":["وَجَّهَ لِي الْأَكْرَمُ أَنْفَعَ الْكَرَمْ","وَضَرَرِي بِغَيْرِ رَدٍّ لِي انْصَرَمْ"],"p":["wadjdjaha lî al akramou ʾanfaʿa alkaram","waḍararî bighayri raddin lî nçaram"]},{"a":["أَسْأَلُهُ كَوْنَ تِهِ الْقَصِيدَهْ","خَارِقَةً لِعَادَةٍ مُفِيدَهْ"],"p":["ʾasʾalouhou kawna tihi alqaçîdah","khâriqatan liʿâdatin moufîdah"]},{"a":["يَا حَيُّ يَا قَيُّومُ صَلِّ بِسَلَامْ","عَلَى الَّذِي جَاءَ بِأَحْسَنِ الْكَلَامْ"],"p":["yâ hayyou yâ qayyoûmou çalli bisalâm","ʿalâ aldhî djâʾa biʾahsani alkalâm"]},{"a":["عَلَى الَّذِي جَاءَ بِأَحْسَنِ الْكَلَامْ","صَلِّ وَسَلِّمْ وَلْتَقَبَّلْ ذَا الْكَلَامْ"],"p":["ʿalâ aldhî djâʾa biʾahsani alkalâm","çalli wasallim waltaqabbal dhâ alkalâm"]},{"a":["مُنَّ عَلَى قَارِئِ ذِي الْحُرُوفِ","بِمَا يَفُوقُ الظَّنَّ مِنْ مَعْرُوفِ"],"p":["mounna ʿalâ qâriʾi dhî alhouroûfi","bimâ yafoûqou aẓẓanna min maʿroûfi"]},{"a":["لِنَاظِمِ الْحُرُوفِ خَلِّدِ الرَّبَاحْ","يَا مَنْ كَفَاهُ ذَا الْغُرُورِ وَالنُّبَاحْ"],"p":["linâẓimi alhouroûfi khallidi arrabâh","yâ man kafâhou dhâ alghouroûri wannoubâh"]},{"a":["وَلِيُّ يَا رَحْمَانُ يَا رَحِيمُ يَا","حَيُّ وَيَا قَيُّومُ يَا مُكْرِمِيَا"],"p":["waliyyou yâ rahmânou yâ rahîmou yâ","hayyou wayâ qayyoûmou yâ moukrimiyâ"]},{"a":["نَاجَاكَ عَبْدُكَ الْخَدِيمُ ذَا صَلَاهْ","مُسَلِّمًا عَلَى مُزَحْزِحِ الْقُلَاهْ"],"p":["nâdjâka ʿabdouka alkhadîmou dhâ çalâh","mousalliman ʿalâ mouzahzihi alqoulâh"]},{"a":["سُبْحَٰنَ رَبِّكَ رَبِّ الْعِزَّةِ عَمَّا يَصِفُونَ","وَسَلَٰمٌ عَلَى الْمُرْسَلِينَ"],"p":["soubhâna rabbika rabbi alʿizzati ʿammâ yaçifoûna","wasalâmoun ʿalâ almoursalîna"]},{"a":["وَالْحَمْدُ لِلَّهِ رَبِّ الْعَٰلَمِينَ"],"p":["walhamdou lillâhi rabbi alʿâlamîna"]}]}